from ampere.xlat import Signal, Translation, Fusion
from proj.uop import *
from proj.xlat_register_constants import * # x30/ZR/xzr/SP_EL*/s0/s1/T0/T1/T2/T3/RGSR_EL1

class ANDS_32_log_shift(_JSON_ANDS_32_log_shift):

    pmu_bucket = 'dp'
    fusion_delay_hint = True
    flag_fuse_to_Bcond = True

    def decode(self, f):
        if f.shift.value == 0b00 and f.imm6.value <= 0b000100:
            ands32(dest=f.Rd, flag_dest=1, src1=f.Rn, src2=f.Rm, imm=f.imm6)
        elif f.shift.value == 0b00 and f.imm6.value > 0b000100:
            lsl32_imm(dest=s0, src1=f.Rm, imm=f.imm6)
            ands32(dest=f.Rd, flag_dest=1, src1=f.Rn, src2=s0, imm=Signal("000"))
        elif f.shift.value == 0b01:
            lsr32(dest=s0, src1=f.Rm, src2=f.Rm, imm=f.imm6)
            ands32(dest=f.Rd, flag_dest=1, src1=f.Rn, src2=s0, imm=Signal("000"))
        elif f.shift.value == 0b10:
            asr32(dest=s0, src1=f.Rm, src2=f.Rm, imm=f.imm6)
            ands32(dest=f.Rd, flag_dest=1, src1=f.Rn, src2=s0, imm=Signal("000"))
        elif f.shift.value == 0b11:
            extr32(dest=s0, src1=f.Rm, src2=f.Rm, imm=f.imm6)
            ands32(dest=f.Rd, flag_dest=1, src1=f.Rn, src2=s0, imm=Signal("000"))

class ANDS_32S_log_imm(_JSON_ANDS_32S_log_imm):

    pmu_bucket = 'dp'
    fusion_delay_hint = True
    flag_fuse_to_Bcond = True

    def decode(self, f):
        ands32_imm(dest=f.Rd, flag_dest=1, src2=f.Rn, imm=(f.N,f.immr,f.imms))


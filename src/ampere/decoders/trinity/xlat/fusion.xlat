class ALU64_CBNZ(Fusion):
    """64 bit {SUB, AND, EOR} + CBNZ fusion"""
    sequence = [[SUB_64_addsub_ext, SUB_64_addsub_shift, SUB_64_addsub_imm, AND_64_log_imm, AND_64_log_shift, EOR_64_log_imm, EOR_64_log_shift], CBNZ_64_compbranch]

    SUB_64_addsub_ext.fusion_type = '00'
    SUB_64_addsub_shift.fusion_type = '00'
    SUB_64_addsub_imm.fusion_type = '00'
    AND_64_log_imm.fusion_type = '00'
    AND_64_log_shift.fusion_type = '00'
    EOR_64_log_imm.fusion_type = '00'
    EOR_64_log_shift.fusion_type = '00'
    fusion_type = '01'

    pmu_events = ['A64SCALAR_SPEC', 'DP_SPEC', 'INT_SPEC']

    def decode(self, f, f2):
        
        if isinstance(self.translations[0], SUB_64_addsub_ext):
            sub64_cbnz(dest=f.Rd, src1=f.Rn, src2=f.Rm, imm=(f.option,f.imm3), dest_is_stack_pointer=True, src1_is_stack_pointer=True)
        elif isinstance(self.translations[0], SUB_64_addsub_shift):
            sub64_cbnz(dest=f.Rd, src1=f.Rn, src2=f.Rm, imm=(Signal("011"),f.opcBit12,f.opcBit11,f.opcBit10))
        elif isinstance(self.translations[0], SUB_64_addsub_imm):
            sub64_cbnz(dest=f.Rd, src2=f.Rn, imm=(f.sh,f.imm12), dest_is_stack_pointer=True, src2_is_stack_pointer=True)
        elif isinstance(self.translations[0], AND_64_log_imm):
            and64_imm_cbnz(dest=f.Rd, src2=f.Rn, imm=(f.N,f.immr,f.imms), dest_is_stack_pointer=True)
        elif isinstance(self.translations[0], AND_64_log_shift):
            and64_cbnz(dest=f.Rd, src1=f.Rn, src2=f.Rm, imm=f.imm6)
        elif isinstance(self.translations[0], EOR_64_log_imm):
            eor64_imm_cbnz(dest=f.Rd, src2=f.Rn, imm=(f.N,f.immr,f.imms), dest_is_stack_pointer=True)
        elif isinstance(self.translations[0], EOR_64_log_shift):
            eor64_cbnz(dest=f.Rd, src1=f.Rn, src2=f.Rm, imm=f.imm6)


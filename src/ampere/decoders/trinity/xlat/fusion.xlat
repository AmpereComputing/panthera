from ampere.xlat import Signal, Translation, Fusion
from proj.uop import *

def no_shift_or_sign_extension(insn):
    if hasattr(insn, 'option') and hasattr(insn, 'imm3'):
        return insn.option.value < 4 and insn.imm3.value == 0
    elif hasattr(insn, 'shift') and hasattr(insn, 'imm6'):
        return insn.shift.value == 0 and insn.imm6.value < 4
    else:
        return True

class MOVK_32_MOVK_64(Fusion):
    """MOVK+MOVK fusion"""
    sequence = [MOVK_32_movewide, MOVK_64_movewide]

    MOVK_32_movewide.fusion_type = '00'
    MOVK_64_movewide.fusion_type = '00'
    fusion_type = '10'
    
    pmu_events = ['DP_SPEC']

    def decode(self, f, f2):
        if f.hw.value == 0b00:
            #MOVK32_0 + MOVK64_16
            movzk32_0b(dest=f.Rd, imm=(f2.imm16, f.imm16))
        elif f.hw.value == 0b01:
            #MOVK32_16 + MOVK64_0
            movzk32_0b(dest=f.Rd, imm=(f.imm16, f2.imm16))
        else:
            not_implemented()

class MOVK_64_MOVK_64(Fusion):
    """MOVK+MOVK fusion"""
    sequence = [MOVK_64_movewide, MOVK_64_movewide]

    MOVK_64_movewide.fusion_type = '00'
    fusion_type = '10'
    
    pmu_events = ['DP_SPEC']

    def decode(self, f, f2):
        if f.hw.value == 0b00:
            #MOVK64_0 + MOVK64_16
            movkk64_0b(dest=f.Rd, src2=f.Rd, imm=(f2.imm16, f.imm16))
        elif f.hw.value == 0b01:
            if f2.hw.value == 0b00:
                #MOVK64_16 + MOVK64_0
                movkk64_0b(dest=f.Rd, src2=f.Rd, imm=(f.imm16, f2.imm16))
            elif f2.hw.value == 0b10:
                #MOVK64_16 + MOVK64_32
                movkk64_2b(dest=f.Rd, src2=f.Rd, imm=(f2.imm16, f.imm16))
            else: 
                not_implemented()
        elif f.hw.value == 0b10:
            #MOVK64_32 + MOVK64_48
            movkk64_4b(dest=f.Rd, src2=f.Rd, imm=(f2.imm16, f.imm16))
        else:
            not_implemented()            
        
class MOV_MOVK_32(Fusion):
    """MOVZ+MOVK fusion"""
    sequence = [[MOVK_32_movewide, MOVK_64_movewide, MOVZ_32_movewide, MOVZ_64_movewide], MOVK_32_movewide]

    MOVK_32_movewide.fusion_type = '00'
    MOVK_64_movewide.fusion_type = '00'
    MOVZ_32_movewide.fusion_type = '00'
    MOVZ_64_movewide.fusion_type = '00'
    fusion_type = '01'
    
    pmu_events = ['DP_SPEC']

    def decode(self, f, f2):
        if f.hw.value == 0b00:
            movzk32_0b(dest=f.Rd, imm=(f2.imm16, f.imm16))
        else:
            not_implemented()

class MOVZ_MOVK_64(Fusion):
    """MOVZ+MOVK fusion"""
    sequence = [[MOVZ_32_movewide, MOVZ_64_movewide], MOVK_64_movewide]

    MOVZ_32_movewide.fusion_type = '00'
    MOVZ_64_movewide.fusion_type = '00'
    fusion_type = '10'
    
    pmu_events = ['DP_SPEC']

    def decode(self, f, f2):
        if f.hw.value == 0b00:
            #MOVZ32/64_0 + MOVK64_16
            movzk64_0b(dest=f.Rd, imm=(f2.imm16, f.imm16))
        elif f.hw.value == 0b01:
            if f2.hw.value == 0b00:
                #MOVZ32/64_16 + MOVK64_0
                movzk64_0b(dest=f.Rd, imm=(f.imm16, f2.imm16))
            elif f2.hw.value == 0b10:
                #MOVZ32/64_16 + MOVK64_32
                movzk64_2b(dest=f.Rd, imm=(f2.imm16, f.imm16))
            else: 
                not_implemented()
        elif f.hw.value == 0b10:
            #MOVZ32/64_32 + MOVK64_48
            movzk64_4b(dest=f.Rd, imm=(f2.imm16, f.imm16))
        else:
            not_implemented()

class AESE_AESMC(Fusion):
    """AESE+AESMC fusion"""
    sequence = [AESE_B_cryptoaes, AESMC_B_cryptoaes]

    AESE_B_cryptoaes.fusion_type = '00'
    fusion_type = '01'
    
    pmu_events = ['CRYPTO_SPEC']

    def decode(self, f, f2):
        aesef_b_lv(dest=f.Rd, src1=f.Rd, src2=f.Rn)

class AESD_AESIMC(Fusion):
    """AESD+AESIMC fusion"""
    sequence = [AESD_B_cryptoaes, AESIMC_B_cryptoaes]

    AESD_B_cryptoaes.fusion_type = '00'
    fusion_type = '01'
    
    pmu_events = ['CRYPTO_SPEC']

    def decode(self, f, f2):
        aesdf_b_lv(dest=f.Rd, src1=f.Rd, src2=f.Rn)

class ADRP_ADDIMM(Fusion):
    """ADRP+Add (immediate) fusion"""
    sequence = [ADRP_only_pcreladdr, ADD_64_addsub_imm]

    ADRP_only_pcreladdr.fusion_type = '00'
    fusion_type = '01'
    
    pmu_events = ['A64SCALAR_SPEC', 'DP_SPEC', 'INT_SPEC']

    def decode(self, f, f2):
        # This looks exactly like an ADRP, the difference in execution is that in the fusion case, in IdrXlt rtl, we
        # will mux the imm12 of the ADDIMM onto the Opcode field instead of zeros, so the lower bits will be different
        adr(dest=f.Rd, imm=(f.immhi,f.immlo, Signal('000000000000')), use_pc=True, imm_signext=True, is_adrp=True)

class SUBS_Bcond(Fusion):
    # example in dv/env/top/asm/tests/cond_branch
    sequence = [[SUBS_64S_addsub_ext, SUBS_64_addsub_shift, SUBS_64S_addsub_imm, SUBS_32S_addsub_ext, SUBS_32_addsub_shift, SUBS_32S_addsub_imm], B_only_condbranch]
    requirements = [no_shift_or_sign_extension, None]

    SUBS_32S_addsub_ext.fusion_type = '00'
    SUBS_32_addsub_shift.fusion_type = '00'
    SUBS_32S_addsub_imm.fusion_type = '00'
    SUBS_64S_addsub_ext.fusion_type = '00'
    SUBS_64_addsub_shift.fusion_type = '00'
    SUBS_64S_addsub_imm.fusion_type = '00'
    fusion_type = '11'

    pmu_events = ['A64SCALAR_SPEC', 'DP_SPEC', 'INT_SPEC']

    def decode(self, f, f2):
        
        if isinstance(self.translations[0], SUBS_32_addsub_shift):
            if f2.cond.value == 0b0000:
                subs32__bc_eq(dest=f.Rd, flagdest=f0, src1=f.Rn, src2=f.Rm, imm=Signal("011000"))
            elif f2.cond.value == 0b0010:
                subs32__bc_cs(dest=f.Rd, flagdest=f0, src1=f.Rn, src2=f.Rm, imm=Signal("011000"))
            elif f2.cond.value == 0b0100:
                subs32__bc_mi(dest=f.Rd, flagdest=f0, src1=f.Rn, src2=f.Rm, imm=Signal("011000"))
            elif f2.cond.value == 0b0110:
                subs32__bc_vs(dest=f.Rd, flagdest=f0, src1=f.Rn, src2=f.Rm, imm=Signal("011000"))
            elif f2.cond.value == 0b1000:
                subs32__bc_hi(dest=f.Rd, flagdest=f0, src1=f.Rn, src2=f.Rm, imm=Signal("011000"))
            elif f2.cond.value == 0b1010:
                subs32__bc_ge(dest=f.Rd, flagdest=f0, src1=f.Rn, src2=f.Rm, imm=Signal("011000"))
            elif f2.cond.value == 0b1100:
                subs32__bc_gt(dest=f.Rd, flagdest=f0, src1=f.Rn, src2=f.Rm, imm=Signal("011000"))
            elif f2.cond.value >= 0b1110:
                subs32__bc_al(dest=f.Rd, flagdest=f0, src1=f.Rn, src2=f.Rm, imm=Signal("011000"))
            elif f2.cond.value == 0b0001:
                subs32__bc_ne(dest=f.Rd, flagdest=f0, src1=f.Rn, src2=f.Rm, imm=Signal("011000"))
            elif f2.cond.value == 0b0011:
                subs32__bc_cc(dest=f.Rd, flagdest=f0, src1=f.Rn, src2=f.Rm, imm=Signal("011000"))
            elif f2.cond.value == 0b0101:
                subs32__bc_pl(dest=f.Rd, flagdest=f0, src1=f.Rn, src2=f.Rm, imm=Signal("011000"))
            elif f2.cond.value == 0b0111:
                subs32__bc_vc(dest=f.Rd, flagdest=f0, src1=f.Rn, src2=f.Rm, imm=Signal("011000"))
            elif f2.cond.value == 0b1001:
                subs32__bc_ls(dest=f.Rd, flagdest=f0, src1=f.Rn, src2=f.Rm, imm=Signal("011000"))
            elif f2.cond.value == 0b1011:
                subs32__bc_lt(dest=f.Rd, flagdest=f0, src1=f.Rn, src2=f.Rm, imm=Signal("011000"))
            elif f2.cond.value == 0b1101:
                subs32__bc_le(dest=f.Rd, flagdest=f0, src1=f.Rn, src2=f.Rm, imm=Signal("011000"))

        elif isinstance(self.translations[0], SUBS_32S_addsub_ext):
            if f2.cond.value == 0b0000:
                subs32__bc_eq(dest=f.Rd, flagdest=f0, src1=f.Rn, src2=f.Rm, imm=(f.option,Signal("000")), src1_is_stack_pointer=True)
            elif f2.cond.value == 0b0010:
                subs32__bc_cs(dest=f.Rd, flagdest=f0, src1=f.Rn, src2=f.Rm, imm=(f.option,Signal("000")), src1_is_stack_pointer=True)
            elif f2.cond.value == 0b0100:
                subs32__bc_mi(dest=f.Rd, flagdest=f0, src1=f.Rn, src2=f.Rm, imm=(f.option,Signal("000")), src1_is_stack_pointer=True)
            elif f2.cond.value == 0b0110:
                subs32__bc_vs(dest=f.Rd, flagdest=f0, src1=f.Rn, src2=f.Rm, imm=(f.option,Signal("000")), src1_is_stack_pointer=True)
            elif f2.cond.value == 0b1000:
                subs32__bc_hi(dest=f.Rd, flagdest=f0, src1=f.Rn, src2=f.Rm, imm=(f.option,Signal("000")), src1_is_stack_pointer=True)
            elif f2.cond.value == 0b1010:
                subs32__bc_ge(dest=f.Rd, flagdest=f0, src1=f.Rn, src2=f.Rm, imm=(f.option,Signal("000")), src1_is_stack_pointer=True)
            elif f2.cond.value == 0b1100:
                subs32__bc_gt(dest=f.Rd, flagdest=f0, src1=f.Rn, src2=f.Rm, imm=(f.option,Signal("000")), src1_is_stack_pointer=True)
            elif f2.cond.value >= 0b1110:
                subs32__bc_al(dest=f.Rd, flagdest=f0, src1=f.Rn, src2=f.Rm, imm=(f.option,Signal("000")), src1_is_stack_pointer=True)
            elif f2.cond.value == 0b0001:
                subs32__bc_ne(dest=f.Rd, flagdest=f0, src1=f.Rn, src2=f.Rm, imm=(f.option,Signal("000")), src1_is_stack_pointer=True)
            elif f2.cond.value == 0b0011:
                subs32__bc_cc(dest=f.Rd, flagdest=f0, src1=f.Rn, src2=f.Rm, imm=(f.option,Signal("000")), src1_is_stack_pointer=True)
            elif f2.cond.value == 0b0101:
                subs32__bc_pl(dest=f.Rd, flagdest=f0, src1=f.Rn, src2=f.Rm, imm=(f.option,Signal("000")), src1_is_stack_pointer=True)
            elif f2.cond.value == 0b0111:
                subs32__bc_vc(dest=f.Rd, flagdest=f0, src1=f.Rn, src2=f.Rm, imm=(f.option,Signal("000")), src1_is_stack_pointer=True)
            elif f2.cond.value == 0b1001:
                subs32__bc_ls(dest=f.Rd, flagdest=f0, src1=f.Rn, src2=f.Rm, imm=(f.option,Signal("000")), src1_is_stack_pointer=True)
            elif f2.cond.value == 0b1011:
                subs32__bc_lt(dest=f.Rd, flagdest=f0, src1=f.Rn, src2=f.Rm, imm=(f.option,Signal("000")), src1_is_stack_pointer=True)
            elif f2.cond.value == 0b1101:
                subs32__bc_le(dest=f.Rd, flagdest=f0, src1=f.Rn, src2=f.Rm, imm=(f.option,Signal("000")), src1_is_stack_pointer=True)

        elif isinstance(self.translations[0], SUBS_32S_addsub_imm):
            if f2.cond.value == 0b0000:
                subs32__bc_eq(dest=f.Rd, flagdest=f0, src2=f.Rn, imm=(f.sh,f.imm12), src2_is_stack_pointer=True)
            elif f2.cond.value == 0b0010:
                subs32__bc_cs(dest=f.Rd, flagdest=f0, src2=f.Rn, imm=(f.sh,f.imm12), src2_is_stack_pointer=True)
            elif f2.cond.value == 0b0100:
                subs32__bc_mi(dest=f.Rd, flagdest=f0, src2=f.Rn, imm=(f.sh,f.imm12), src2_is_stack_pointer=True)
            elif f2.cond.value == 0b0110:
                subs32__bc_vs(dest=f.Rd, flagdest=f0, src2=f.Rn, imm=(f.sh,f.imm12), src2_is_stack_pointer=True)
            elif f2.cond.value == 0b1000:
                subs32__bc_hi(dest=f.Rd, flagdest=f0, src2=f.Rn, imm=(f.sh,f.imm12), src2_is_stack_pointer=True)
            elif f2.cond.value == 0b1010:
                subs32__bc_ge(dest=f.Rd, flagdest=f0, src2=f.Rn, imm=(f.sh,f.imm12), src2_is_stack_pointer=True)
            elif f2.cond.value == 0b1100:
                subs32__bc_gt(dest=f.Rd, flagdest=f0, src2=f.Rn, imm=(f.sh,f.imm12), src2_is_stack_pointer=True)
            elif f2.cond.value >= 0b1110:
                subs32__bc_al(dest=f.Rd, flagdest=f0, src2=f.Rn, imm=(f.sh,f.imm12), src2_is_stack_pointer=True)
            elif f2.cond.value == 0b0001:
                subs32__bc_ne(dest=f.Rd, flagdest=f0, src2=f.Rn, imm=(f.sh,f.imm12), src2_is_stack_pointer=True)
            elif f2.cond.value == 0b0011:
                subs32__bc_cc(dest=f.Rd, flagdest=f0, src2=f.Rn, imm=(f.sh,f.imm12), src2_is_stack_pointer=True)
            elif f2.cond.value == 0b0101:
                subs32__bc_pl(dest=f.Rd, flagdest=f0, src2=f.Rn, imm=(f.sh,f.imm12), src2_is_stack_pointer=True)
            elif f2.cond.value == 0b0111:
                subs32__bc_vc(dest=f.Rd, flagdest=f0, src2=f.Rn, imm=(f.sh,f.imm12), src2_is_stack_pointer=True)
            elif f2.cond.value == 0b1001:
                subs32__bc_ls(dest=f.Rd, flagdest=f0, src2=f.Rn, imm=(f.sh,f.imm12), src2_is_stack_pointer=True)
            elif f2.cond.value == 0b1011:
                subs32__bc_lt(dest=f.Rd, flagdest=f0, src2=f.Rn, imm=(f.sh,f.imm12), src2_is_stack_pointer=True)
            elif f2.cond.value == 0b1101:
                subs32__bc_le(dest=f.Rd, flagdest=f0, src2=f.Rn, imm=(f.sh,f.imm12), src2_is_stack_pointer=True)

        elif isinstance(self.translations[0], SUBS_64_addsub_shift):
            if f2.cond.value == 0b0000:
                subs64__bc_eq(dest=f.Rd, flagdest=f0, src1=f.Rn, src2=f.Rm, imm=Signal("011000"))
            elif f2.cond.value == 0b0010:
                subs64__bc_cs(dest=f.Rd, flagdest=f0, src1=f.Rn, src2=f.Rm, imm=Signal("011000"))
            elif f2.cond.value == 0b0100:
                subs64__bc_mi(dest=f.Rd, flagdest=f0, src1=f.Rn, src2=f.Rm, imm=Signal("011000"))
            elif f2.cond.value == 0b0110:
                subs64__bc_vs(dest=f.Rd, flagdest=f0, src1=f.Rn, src2=f.Rm, imm=Signal("011000"))
            elif f2.cond.value == 0b1000:
                subs64__bc_hi(dest=f.Rd, flagdest=f0, src1=f.Rn, src2=f.Rm, imm=Signal("011000"))
            elif f2.cond.value == 0b1010:
                subs64__bc_ge(dest=f.Rd, flagdest=f0, src1=f.Rn, src2=f.Rm, imm=Signal("011000"))
            elif f2.cond.value == 0b1100:
                subs64__bc_gt(dest=f.Rd, flagdest=f0, src1=f.Rn, src2=f.Rm, imm=Signal("011000"))
            elif f2.cond.value >= 0b1110:
                subs64__bc_al(dest=f.Rd, flagdest=f0, src1=f.Rn, src2=f.Rm, imm=Signal("011000"))
            elif f2.cond.value == 0b0001:
                subs64__bc_ne(dest=f.Rd, flagdest=f0, src1=f.Rn, src2=f.Rm, imm=Signal("011000"))
            elif f2.cond.value == 0b0011:
                subs64__bc_cc(dest=f.Rd, flagdest=f0, src1=f.Rn, src2=f.Rm, imm=Signal("011000"))
            elif f2.cond.value == 0b0101:
                subs64__bc_pl(dest=f.Rd, flagdest=f0, src1=f.Rn, src2=f.Rm, imm=Signal("011000"))
            elif f2.cond.value == 0b0111:
                subs64__bc_vc(dest=f.Rd, flagdest=f0, src1=f.Rn, src2=f.Rm, imm=Signal("011000"))
            elif f2.cond.value == 0b1001:
                subs64__bc_ls(dest=f.Rd, flagdest=f0, src1=f.Rn, src2=f.Rm, imm=Signal("011000"))
            elif f2.cond.value == 0b1011:
                subs64__bc_lt(dest=f.Rd, flagdest=f0, src1=f.Rn, src2=f.Rm, imm=Signal("011000"))
            elif f2.cond.value == 0b1101:
                subs64__bc_le(dest=f.Rd, flagdest=f0, src1=f.Rn, src2=f.Rm, imm=Signal("011000"))
                
        elif isinstance(self.translations[0], SUBS_64S_addsub_ext):
            if f2.cond.value == 0b0000:
                subs64__bc_eq(dest=f.Rd, flagdest=f0, src1=f.Rn, src2=f.Rm, imm=(f.option,Signal("000")), src1_is_stack_pointer=True)
            elif f2.cond.value == 0b0010:
                subs64__bc_cs(dest=f.Rd, flagdest=f0, src1=f.Rn, src2=f.Rm, imm=(f.option,Signal("000")), src1_is_stack_pointer=True)
            elif f2.cond.value == 0b0100:
                subs64__bc_mi(dest=f.Rd, flagdest=f0, src1=f.Rn, src2=f.Rm, imm=(f.option,Signal("000")), src1_is_stack_pointer=True)
            elif f2.cond.value == 0b0110:
                subs64__bc_vs(dest=f.Rd, flagdest=f0, src1=f.Rn, src2=f.Rm, imm=(f.option,Signal("000")), src1_is_stack_pointer=True)
            elif f2.cond.value == 0b1000:
                subs64__bc_hi(dest=f.Rd, flagdest=f0, src1=f.Rn, src2=f.Rm, imm=(f.option,Signal("000")), src1_is_stack_pointer=True)
            elif f2.cond.value == 0b1010:
                subs64__bc_ge(dest=f.Rd, flagdest=f0, src1=f.Rn, src2=f.Rm, imm=(f.option,Signal("000")), src1_is_stack_pointer=True)
            elif f2.cond.value == 0b1100:
                subs64__bc_gt(dest=f.Rd, flagdest=f0, src1=f.Rn, src2=f.Rm, imm=(f.option,Signal("000")), src1_is_stack_pointer=True)
            elif f2.cond.value >= 0b1110:
                subs64__bc_al(dest=f.Rd, flagdest=f0, src1=f.Rn, src2=f.Rm, imm=(f.option,Signal("000")), src1_is_stack_pointer=True)
            elif f2.cond.value == 0b0001:
                subs64__bc_ne(dest=f.Rd, flagdest=f0, src1=f.Rn, src2=f.Rm, imm=(f.option,Signal("000")), src1_is_stack_pointer=True)
            elif f2.cond.value == 0b0011:
                subs64__bc_cc(dest=f.Rd, flagdest=f0, src1=f.Rn, src2=f.Rm, imm=(f.option,Signal("000")), src1_is_stack_pointer=True)
            elif f2.cond.value == 0b0101:
                subs64__bc_pl(dest=f.Rd, flagdest=f0, src1=f.Rn, src2=f.Rm, imm=(f.option,Signal("000")), src1_is_stack_pointer=True)
            elif f2.cond.value == 0b0111:
                subs64__bc_vc(dest=f.Rd, flagdest=f0, src1=f.Rn, src2=f.Rm, imm=(f.option,Signal("000")), src1_is_stack_pointer=True)
            elif f2.cond.value == 0b1001:
                subs64__bc_ls(dest=f.Rd, flagdest=f0, src1=f.Rn, src2=f.Rm, imm=(f.option,Signal("000")), src1_is_stack_pointer=True)
            elif f2.cond.value == 0b1011:
                subs64__bc_lt(dest=f.Rd, flagdest=f0, src1=f.Rn, src2=f.Rm, imm=(f.option,Signal("000")), src1_is_stack_pointer=True)
            elif f2.cond.value == 0b1101:
                subs64__bc_le(dest=f.Rd, flagdest=f0, src1=f.Rn, src2=f.Rm, imm=(f.option,Signal("000")), src1_is_stack_pointer=True)
                    
        elif isinstance(self.translations[0], SUBS_64S_addsub_imm):
            if f2.cond.value == 0b0000:
                subs64__bc_eq(dest=f.Rd, flagdest=f0, src2=f.Rn, imm=(f.sh,f.imm12), src2_is_stack_pointer=True)
            elif f2.cond.value == 0b0010:
                subs64__bc_cs(dest=f.Rd, flagdest=f0, src2=f.Rn, imm=(f.sh,f.imm12), src2_is_stack_pointer=True)
            elif f2.cond.value == 0b0100:
                subs64__bc_mi(dest=f.Rd, flagdest=f0, src2=f.Rn, imm=(f.sh,f.imm12), src2_is_stack_pointer=True)
            elif f2.cond.value == 0b0110:
                subs64__bc_vs(dest=f.Rd, flagdest=f0, src2=f.Rn, imm=(f.sh,f.imm12), src2_is_stack_pointer=True)
            elif f2.cond.value == 0b1000:
                subs64__bc_hi(dest=f.Rd, flagdest=f0, src2=f.Rn, imm=(f.sh,f.imm12), src2_is_stack_pointer=True)
            elif f2.cond.value == 0b1010:

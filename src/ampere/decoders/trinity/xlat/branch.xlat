class TBNZ_only_testbranch(_JSON_TBNZ_only_testbranch):

    is_branch = True
    is_unconditional_branch=False
    # BTB_TYPE_CONDITIONAL_DIRECT
    
    def decode(self, f):
        tbnz(src2=f.Rt, ixu_imm=(f.b5,f.b40), imm=f.imm14, imm_signext=True, imm_shift=2)


class TBZ_only_testbranch(_JSON_TBZ_only_testbranch):

    is_branch = True
    # BTB_TYPE_CONDITIONAL_DIRECT

    def decode(self, f):
        tbz(src2=f.Rt, ixu_imm=(f.b5,f.b40), imm=f.imm14, imm_signext=True, imm_shift=2)

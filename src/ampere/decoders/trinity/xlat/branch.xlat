# -*- python -*-
from ampere.xlat import Signal, Translation
from proj.uop import *
from proj.xlat_register_constants import * # x30/ZR/xzr/SP_EL*/s0/s1/T0/T1/T2/T3/RGSR_EL1

HARDCODE_IMP_CURRENT_ELR_SPR_ADDR = Signal('1111010110110010') ## ELR from GPR for ERETAA/AB

class B_only_condbranch(_JSON_B_only_condbranch):

    is_branch = True
    is_unconditional_branch = 'cond'
    # BTB_TYPE_CONDITIONAL_DIRECT

    ## This b.al should be an unconditional branch
    def decode(self, f):
        if f.cond.value == 0b0000:
            bc_eq(src3=f0, imm=f.imm19, imm_signext=True, imm_shift=2)
        elif f.cond.value == 0b0010:
            bc_cs(src3=f0, imm=f.imm19, imm_signext=True, imm_shift=2)
        elif f.cond.value == 0b0100:
            bc_mi(src3=f0, imm=f.imm19, imm_signext=True, imm_shift=2)
        elif f.cond.value == 0b0110:
            bc_vs(src3=f0, imm=f.imm19, imm_signext=True, imm_shift=2)
        elif f.cond.value == 0b1000:
            bc_hi(src3=f0, imm=f.imm19, imm_signext=True, imm_shift=2)
        elif f.cond.value == 0b1010:
            bc_ge(src3=f0, imm=f.imm19, imm_signext=True, imm_shift=2)
        elif f.cond.value == 0b1100:
            bc_gt(src3=f0, imm=f.imm19, imm_signext=True, imm_shift=2)
        elif f.cond.value >= 0b1110:
            bc_al(src3=f0, imm=f.imm19, imm_signext=True, imm_shift=2)
        elif f.cond.value == 0b0001:
            bc_ne(src3=f0, imm=f.imm19, imm_signext=True, imm_shift=2)
        elif f.cond.value == 0b0011:
            bc_cc(src3=f0, imm=f.imm19, imm_signext=True, imm_shift=2)
        elif f.cond.value == 0b0101:
            bc_pl(src3=f0, imm=f.imm19, imm_signext=True, imm_shift=2)
        elif f.cond.value == 0b0111:
            bc_vc(src3=f0, imm=f.imm19, imm_signext=True, imm_shift=2)
        elif f.cond.value == 0b1001:
            bc_ls(src3=f0, imm=f.imm19, imm_signext=True, imm_shift=2)
        elif f.cond.value == 0b1011:
            bc_lt(src3=f0, imm=f.imm19, imm_signext=True, imm_shift=2)
        elif f.cond.value == 0b1101:
            bc_le(src3=f0, imm=f.imm19, imm_signext=True, imm_shift=2)


class B_only_branch_imm(_JSON_B_only_branch_imm):

    is_branch = True
    is_unconditional_branch = 'True'
    # BTB_TYPE_UNCONDITIONAL_DIRECT

    def decode(self, f):
        b(imm=f.imm26, imm_signext=True, imm_shift=2)


class BL_only_branch_imm(_JSON_BL_only_branch_imm):

    is_branch = True
    is_unconditional_branch = 'True'
    is_call_direct = True
    # BTB_TYPE_CALL_DIRECT

    def decode(self, f):
        ## This BL instruction is using the ADR instruction/uop to write the
        ## a PC-relative address (+4) to X30 register (the link register)
        ## It then must branch directly to the specified label, so we tell
        ## IDR that the ADR is a branch.  Like B, the imm26 never needs to get
        ## to the IXU for this instruction, the branch is handled by the front
        ## end other than IDR calculating taken/not_taken targets with it
        adr(dest=x30, imm=f.imm26, imm_signext=True, imm_shift=2, set_imm_to_pc_next=True)

class BLR_64_branch_reg(_JSON_BLR_64_branch_reg):

    is_branch = True
    is_unconditional_branch = 'True'
    is_call_indirect = True
    is_indirect = True
    # BTB_TYPE_CALL_INDIRECT

    def decode(self, f):
        if f.Rn.value == 0b011110: # If the source is x30
            orr64(dest=s0, src1=f.Rn, src2=ZR, imm=Signal("000"))
            adr(dest=x30, set_imm_to_pc_next=True)
            br(src2=s0)
        else:
            adr(dest=x30, set_imm_to_pc_next=True)
            br(src2=f.Rn)

class BLRAAZ_64_branch_reg(_JSON_BLRAAZ_64_branch_reg):

    is_branch = True
    is_unconditional_branch = 'True'
    is_call_indirect = True
    is_indirect = True
    mode_bits = { 'pac_ia_enabled' : 1 }
    # BTB_TYPE_CALL_INDIRECT
    
    def decode(self, f):
        if self.mode_bits['pac_ia_enabled']:
            autia(dest=s0, src1=f.Rn, src2=f.Rm)
            adr(dest=x30, set_imm_to_pc_next=True)
            br(src2=s0)
        else:
            if f.Rn.value == 0b11110: ## Check if f.RN is 30
                orr64(dest=s0, src1=f.Rn, src2=ZR, imm=Signal("000"))
                adr(dest=x30, set_imm_to_pc_next=True)
                br(src2=s0)
            else:
                adr(dest=x30, set_imm_to_pc_next=True)
                br(src2=f.Rn)


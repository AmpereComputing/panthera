class CBNZ_32_compbranch(_JSON_CBNZ_32_compbranch):

    is_branch = True
    # BTB_TYPE_CONDITIONAL_DIRECT
    
    def decode(self, f):
        cbnz32(src2=f.Rt, imm=f.imm19, imm_signext=True, imm_shift=2,)



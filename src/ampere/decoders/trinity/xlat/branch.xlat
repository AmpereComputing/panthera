class DRPS_64E_branch_reg(_JSON_DRPS_64E_branch_reg):

    is_branch = False

    def decode(self, f):
        # DRPS behaves as an ERET in the rest of the machine (IXU/GPC) but IDR needs to be
        # able to tell the difference between eret/drps for PMU, so we will decode to an 
        # eret uop, but set a IsDRPS in IdrInst field so IDR knows the difference
        eret(is_drps=True)


class ERET_64E_branch_reg(_JSON_ERET_64E_branch_reg):

    is_branch = False

    def decode(self, f):
        eret(is_eret=True)

class ERETAA_64E_branch_reg(_JSON_ERETAA_64E_branch_reg):

    isolate = True # Since the first uop is an MRS, this must be isolated
    is_branch = False
    is_unconditional_branch = 'True'
    is_indirect = True
    mode_bits = { 'pac_ia_enabled' : 1 }

    def decode(self, f):
        if self.mode_bits['pac_ia_enabled']:
            mfspr(dest=s0, imm=HARDCODE_IMP_CURRENT_ELR_SPR_ADDR)
            autia(dest=s1, src1=s0, src2=f.Rn, src2_is_stack_pointer=True)
            auteret(src2=s1, src1=s1, is_eret=True)
        else:
            eret(is_eret=True)


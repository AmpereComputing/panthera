class ldnt1b_z_p_ar_s_x32_unscaled(_JSON_ldnt1b_z_p_ar_s_x32_unscaled):  # SVE2

    mem_tag_checked = 'always'
    pmu_events = ['LD_SPEC', 'SVE_LDST_SPEC', 'SVE_LD_GATHER_SPEC', 'SVE_LDST_NONCONTIG_SPEC', 'SVE_UOP_SPEC', 'SVE_INST_SPEC', 'SIMD_INST_SPEC']

    def decode(self, f):
        gmovlpair_d_lv(dest=s0, dest2=s1, src1=f.Zn)
        gathernt_b_1of4(dest=T0, src3=f.Pg, src1=s0, src2=f.Rm, imm=(UOFF64,NOSHIFT))
        gathernt_b_2of4(dest=T0, src3=f.Pg, src1=s1, src2=f.Rm, imm=(UOFF64,NOSHIFT))

        gmovhpair_d_lv(dest=s0, dest2=s1, src1=f.Zn)
        gathernt_b_3of4(dest=T0, src3=f.Pg, src1=s0, src2=f.Rm, imm=(UOFF64,NOSHIFT))
        gathernt_b_4of4(dest=T0, src3=f.Pg, src1=s1, src2=f.Rm, imm=(UOFF64,NOSHIFT))
        movprfx_d_uv(dest=f.Zt, src2=T0)



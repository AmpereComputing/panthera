class ADDS_CSET(Fusion):
    """ADDS + CSET fusion"""
    #Fusion Rules:
    # 1. CSET is an alias of CSINC when both srcs are ZR and cond != 111x 
    # 2. Either dests match or flag writer has dest=ZR  
    #Note: CSET Xd, cond == CSINC Xd, ZR, ZR, invert<cond>
    #      where invert flips bit0 of cond
    sequence = [[ADDS_64S_addsub_ext, ADDS_64_addsub_shift, ADDS_64S_addsub_imm, ADDS_32S_addsub_ext, ADDS_32_addsub_shift, ADDS_32S_addsub_imm], [CSINC_32_condsel, CSINC_64_condsel]]

    ADDS_32_addsub_shift.fusion_type = '00'
    ADDS_32S_addsub_ext.fusion_type = '00'
    ADDS_32S_addsub_imm.fusion_type = '00'
    ADDS_64S_addsub_ext.fusion_type = '00'
    ADDS_64_addsub_shift.fusion_type = '00'
    ADDS_64S_addsub_imm.fusion_type = '00'
    fusion_type = '01'

    def decode(self, f, f2):
        if isinstance(self.translations[0], ADDS_32_addsub_shift):
            if f2.cond.value == 0b0000:
                adds32__cset_ne(dest=f2.Rd, flagdest=f0, src1=f.Rn, src2=f.Rm, imm=(Signal("011"),f.opcBit12,f.opcBit11,f.opcBit10))
            elif f2.cond.value == 0b0010:
                adds32__cset_cc(dest=f2.Rd, flagdest=f0, src1=f.Rn, src2=f.Rm, imm=(Signal("011"),f.opcBit12,f.opcBit11,f.opcBit10))
            elif f2.cond.value == 0b0100:
                adds32__cset_pl(dest=f2.Rd, flagdest=f0, src1=f.Rn, src2=f.Rm, imm=(Signal("011"),f.opcBit12,f.opcBit11,f.opcBit10))
            elif f2.cond.value == 0b0110:
                adds32__cset_vc(dest=f2.Rd, flagdest=f0, src1=f.Rn, src2=f.Rm, imm=(Signal("011"),f.opcBit12,f.opcBit11,f.opcBit10))
            elif f2.cond.value == 0b1000:
                adds32__cset_ls(dest=f2.Rd, flagdest=f0, src1=f.Rn, src2=f.Rm, imm=(Signal("011"),f.opcBit12,f.opcBit11,f.opcBit10))
            elif f2.cond.value == 0b1010:

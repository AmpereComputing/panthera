    """64 bit {SUB, AND, EOR} + CBZ fusion"""
    #Fusion Rules:
    # 1. Dest Match  
    # 2. Dest is not x31 (interpret x31 differently)  
    sequence = [[SUB_64_addsub_ext, SUB_64_addsub_shift, SUB_64_addsub_imm, AND_64_log_imm, AND_64_log_shift, EOR_64_log_imm, EOR_64_log_shift], CBZ_64_compbranch]


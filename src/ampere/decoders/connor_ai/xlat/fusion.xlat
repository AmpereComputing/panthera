    """64 bit ADDImm + ADDImm fusion"""
    #Fusion Rules:
    # 1. Dest Match  
    # 2. Dest of 1st is src2 of 2nd 
    # 3. Shift bits have to be different  
    sequence = [ADD_64_addsub_imm, ADD_64_addsub_imm]

    ADD_64_addsub_imm.fusion_type = '00'
    fusion_type = '01'

    def decode(self, f, f2):
        if f.sh.value == 0b1:
            add64__imm24(dest=f.Rd, src2=f.Rn, imm=(f.imm12,f2.imm12), dest_is_stack_pointer=True, src2_is_stack_pointer=True)
        else:
            add64__imm24(dest=f.Rd, src2=f.Rn, imm=(f2.imm12,f.imm12), dest_is_stack_pointer=True, src2_is_stack_pointer=True)



            elif f2.cond.value == 0b1011:
                subs32__cset_ge(dest=f2.Rd, flagdest=f0, src1=f.Rn, src2=f.Rm, imm=(f.option,Signal("000")), src1_is_stack_pointer=True)
            elif f2.cond.value == 0b1101:
                subs32__cset_gt(dest=f2.Rd, flagdest=f0, src1=f.Rn, src2=f.Rm, imm=(f.option,Signal("000")), src1_is_stack_pointer=True)


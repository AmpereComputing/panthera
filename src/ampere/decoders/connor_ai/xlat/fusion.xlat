class SUBS_CSET(Fusion):
    """SUBS + CSET fusion"""
    #Fusion Rules:
    # 1. CSET is an alias of CSINC when both srcs are ZR and cond != 111x 
    # 2. Either dests match or flag writer has dest=ZR 
    #Note: CSET Xd, cond == CSINC Xd, ZR, ZR, invert<cond>
    #      where invert flips bit0 of cond
    sequence = [[SUBS_64S_addsub_ext, SUBS_64_addsub_shift, SUBS_64S_addsub_imm, SUBS_32S_addsub_ext, SUBS_32_addsub_shift, SUBS_32S_addsub_imm], [CSINC_32_condsel, CSINC_64_condsel]]

    SUBS_32_addsub_shift.fusion_type = '00'
    SUBS_32S_addsub_ext.fusion_type = '00'
    SUBS_32S_addsub_imm.fusion_type = '00'
    SUBS_64S_addsub_ext.fusion_type = '00'
    SUBS_64_addsub_shift.fusion_type = '00'
    SUBS_64S_addsub_imm.fusion_type = '00'
    fusion_type = '01'

    def decode(self, f, f2):
        if isinstance(self.translations[0], SUBS_32_addsub_shift):
            if f2.cond.value == 0b0000:
                subs32__cset_ne(dest=f2.Rd, flagdest=f0, src1=f.Rn, src2=f.Rm, imm=Signal("011000"))
            elif f2.cond.value == 0b0010:
                subs32__cset_cc(dest=f2.Rd, flagdest=f0, src1=f.Rn, src2=f.Rm, imm=Signal("011000"))
            elif f2.cond.value == 0b0100:
                subs32__cset_pl(dest=f2.Rd, flagdest=f0, src1=f.Rn, src2=f.Rm, imm=Signal("011000"))
            elif f2.cond.value == 0b0110:
                subs32__cset_vc(dest=f2.Rd, flagdest=f0, src1=f.Rn, src2=f.Rm, imm=Signal("011000"))
            elif f2.cond.value == 0b1000:
                subs32__cset_ls(dest=f2.Rd, flagdest=f0, src1=f.Rn, src2=f.Rm, imm=Signal("011000"))
            elif f2.cond.value == 0b1010:
                subs32__cset_lt(dest=f2.Rd, flagdest=f0, src1=f.Rn, src2=f.Rm, imm=Signal("011000"))
            elif f2.cond.value == 0b1100:
                subs32__cset_le(dest=f2.Rd, flagdest=f0, src1=f.Rn, src2=f.Rm, imm=Signal("011000"))
            elif f2.cond.value >= 0b1110:
                pass
            elif f2.cond.value == 0b0001:
                subs32__cset_eq(dest=f2.Rd, flagdest=f0, src1=f.Rn, src2=f.Rm, imm=Signal("011000"))
            elif f2.cond.value == 0b0011:
                subs32__cset_cs(dest=f2.Rd, flagdest=f0, src1=f.Rn, src2=f.Rm, imm=Signal("011000"))
            elif f2.cond.value == 0b0101:
                subs32__cset_mi(dest=f2.Rd, flagdest=f0, src1=f.Rn, src2=f.Rm, imm=Signal("011000"))
            elif f2.cond.value == 0b0111:
                subs32__cset_vs(dest=f2.Rd, flagdest=f0, src1=f.Rn, src2=f.Rm, imm=Signal("011000"))
            elif f2.cond.value == 0b1001:
                subs32__cset_hi(dest=f2.Rd, flagdest=f0, src1=f.Rn, src2=f.Rm, imm=Signal("011000"))
            elif f2.cond.value == 0b1011:
                subs32__cset_ge(dest=f2.Rd, flagdest=f0, src1=f.Rn, src2=f.Rm, imm=Signal("011000"))
            elif f2.cond.value == 0b1101:
                subs32__cset_gt(dest=f2.Rd, flagdest=f0, src1=f.Rn, src2=f.Rm, imm=Signal("011000"))

        elif isinstance(self.translations[0], SUBS_32S_addsub_ext):
            if f2.cond.value == 0b0000:
                subs32__cset_ne(dest=f2.Rd, flagdest=f0, src1=f.Rn, src2=f.Rm, imm=(f.option,Signal("000")), src1_is_stack_pointer=True)
            elif f2.cond.value == 0b0010:
                subs32__cset_cc(dest=f2.Rd, flagdest=f0, src1=f.Rn, src2=f.Rm, imm=(f.option,Signal("000")), src1_is_stack_pointer=True)
            elif f2.cond.value == 0b0100:

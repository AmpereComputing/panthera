class FABS_H_floatdp1(_JSON_FABS_H_floatdp1):

    pmu_bucket = 'vfp'

    def decode(self, f):
        # Number of uops 1: fabs_h_nv
        fabs_h_nv(dest=f.Rd, src1=f.Rn)



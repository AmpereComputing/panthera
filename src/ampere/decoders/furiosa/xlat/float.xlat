class FCCMP_H_floatccmp(_JSON_FCCMP_H_floatccmp):

    pmu_bucket = 'vfp'

    def decode(self, f):
        #Dont_touch
        rmig(dest=s0, imm=(f.cond,f.nzcv), src3='flag')
        movi2f_fmovd(dest=T0, src2=s0)
        fccmp_h_nv(src1=f.Rn, src2=f.Rm, src3=T0, flag_dest=1)



from ampere.xlat import Signal, Translation, Fusion
from proj.uop import *

class MOVK_32_MOVK_64(Fusion):
    """MOVK+MOVK fusion"""
    sequence = [MOVK_32_movewide, MOVK_64_movewide]

    MOVK_32_movewide.fusion_type = '00'
    MOVK_64_movewide.fusion_type = '00'
    fusion_type = '10'
    
    def decode(self, f, f2):
        if f.hw.value == 0b00:
            movzk32_0b(dest=f.Rd, imm=(f2.imm16, f.imm16))
        else:
            not_implemented()

class MOVK_64_MOVK_64(Fusion):
    """MOVK+MOVK fusion"""
    sequence = [MOVK_64_movewide, MOVK_64_movewide]

    MOVK_64_movewide.fusion_type = '00'
    fusion_type = '10'
    
    def decode(self, f, f2):
        if f.hw.value == 0b00:
            movkk64_0b(dest=f.Rd, src2=f.Rd, imm=(f2.imm16, f.imm16))
        elif f.hw.value == 0b10:
            movkk64_4b(dest=f.Rd, src2=f.Rd, imm=(f2.imm16, f.imm16))
        else:
            not_implemented()            
        
class MOV_MOVK_32(Fusion):
    """MOVZ+MOVK fusion"""
    sequence = [[MOVK_32_movewide, MOVK_64_movewide, MOVZ_32_movewide, MOVZ_64_movewide], MOVK_32_movewide]

    MOVK_32_movewide.fusion_type = '00'
    MOVK_64_movewide.fusion_type = '00'
    MOVZ_32_movewide.fusion_type = '00'
    MOVZ_64_movewide.fusion_type = '00'
    fusion_type = '01'
    
    def decode(self, f, f2):
        if f.hw.value == 0b00:
            movzk32_0b(dest=f.Rd, imm=(f2.imm16, f.imm16))
        else:
            not_implemented()

class MOVZ_MOVK_64(Fusion):
    """MOVZ+MOVK fusion"""
    sequence = [[MOVZ_32_movewide, MOVZ_64_movewide], MOVK_64_movewide]

    MOVZ_32_movewide.fusion_type = '00'
    MOVZ_64_movewide.fusion_type = '00'
    fusion_type = '10'
    
    def decode(self, f, f2):
        if f.hw.value == 0b00:
            movzk64_0b(dest=f.Rd, imm=(f2.imm16, f.imm16))
        elif f.hw.value == 0b10:
            movzk64_4b(dest=f.Rd, imm=(f2.imm16, f.imm16))
        else:
            not_implemented()

class AESE_AESMC(Fusion):
    """AESE+AESMC fusion"""
    sequence = [AESE_B_cryptoaes, AESMC_B_cryptoaes]

    AESE_B_cryptoaes.fusion_type = '00'
    fusion_type = '01'
    
    def decode(self, f, f2):
        aesef_b_lv(dest=f.Rd, src1=f.Rd, src2=f.Rn)

class AESD_AESIMC(Fusion):
    """AESD+AESIMC fusion"""
    sequence = [AESD_B_cryptoaes, AESIMC_B_cryptoaes]

    AESD_B_cryptoaes.fusion_type = '00'
    fusion_type = '01'
    
    def decode(self, f, f2):
        aesdf_b_lv(dest=f.Rd, src1=f.Rd, src2=f.Rn)

class ADRP_ADDIMM(Fusion):
    """ADRP+Add (immediate) fusion"""
    sequence = [ADRP_only_pcreladdr, ADD_64_addsub_imm]

    ADRP_only_pcreladdr.fusion_type = '00'
    fusion_type = '01'
    
    def decode(self, f, f2):
        # This looks exactly like an ADRP, the difference in execution is that in the fusion case, in IdrXlt rtl, we
        # will mux the imm12 of the ADDIMM onto the Opcode field instead of zeros, so the lower bits will be different
        adr(dest=f.Rd, imm=(f.immhi,f.immlo, Signal('000000000000')), use_pc=True, imm_signext=True, is_adrp=True)

class SUBS_Bcond(Fusion):
    # example in dv/env/top/asm/tests/cond_branch
    sequence = [[SUBS_64S_addsub_ext, SUBS_64_addsub_shift, SUBS_64S_addsub_imm, SUBS_32S_addsub_ext, SUBS_32_addsub_shift, SUBS_32S_addsub_imm], B_only_condbranch]

    SUBS_32S_addsub_ext.fusion_type = '00'
    SUBS_32_addsub_shift.fusion_type = '00'
    SUBS_32S_addsub_imm.fusion_type = '00'
    SUBS_64S_addsub_ext.fusion_type = '00'
    SUBS_64_addsub_shift.fusion_type = '00'
    SUBS_64S_addsub_imm.fusion_type = '00'
    fusion_type = '11'

    def decode(self, f, f2):
        
        if isinstance(self.translations[0], SUBS_32_addsub_shift):
            if f2.cond.value == 0b0000:
                subs32__bc_eq(dest=f.Rd, flag_dest=1, src1=f.Rn, src2=f.Rm, imm=Signal("011000"), is_branch=True, is_unconditional_branch=False)
            elif f2.cond.value == 0b0010:
                subs32__bc_cs(dest=f.Rd, flag_dest=1, src1=f.Rn, src2=f.Rm, imm=Signal("011000"), is_branch=True, is_unconditional_branch=False)
            elif f2.cond.value == 0b0100:
                subs32__bc_mi(dest=f.Rd, flag_dest=1, src1=f.Rn, src2=f.Rm, imm=Signal("011000"), is_branch=True, is_unconditional_branch=False)
            elif f2.cond.value == 0b0110:
                subs32__bc_vs(dest=f.Rd, flag_dest=1, src1=f.Rn, src2=f.Rm, imm=Signal("011000"), is_branch=True, is_unconditional_branch=False)
            elif f2.cond.value == 0b1000:
                subs32__bc_hi(dest=f.Rd, flag_dest=1, src1=f.Rn, src2=f.Rm, imm=Signal("011000"), is_branch=True, is_unconditional_branch=False)
            elif f2.cond.value == 0b1010:
                subs32__bc_ge(dest=f.Rd, flag_dest=1, src1=f.Rn, src2=f.Rm, imm=Signal("011000"), is_branch=True, is_unconditional_branch=False)
            elif f2.cond.value == 0b1100:
                subs32__bc_gt(dest=f.Rd, flag_dest=1, src1=f.Rn, src2=f.Rm, imm=Signal("011000"), is_branch=True, is_unconditional_branch=False)
            elif f2.cond.value >= 0b1110:
                subs32__bc_al(dest=f.Rd, flag_dest=1, src1=f.Rn, src2=f.Rm, imm=Signal("011000"), is_branch=True, is_unconditional_branch=False)
            elif f2.cond.value == 0b0001:
                subs32__bc_ne(dest=f.Rd, flag_dest=1, src1=f.Rn, src2=f.Rm, imm=Signal("011000"), is_branch=True, is_unconditional_branch=False)
            elif f2.cond.value == 0b0011:
                subs32__bc_cc(dest=f.Rd, flag_dest=1, src1=f.Rn, src2=f.Rm, imm=Signal("011000"), is_branch=True, is_unconditional_branch=False)
            elif f2.cond.value == 0b0101:
                subs32__bc_pl(dest=f.Rd, flag_dest=1, src1=f.Rn, src2=f.Rm, imm=Signal("011000"), is_branch=True, is_unconditional_branch=False)
            elif f2.cond.value == 0b0111:
                subs32__bc_vc(dest=f.Rd, flag_dest=1, src1=f.Rn, src2=f.Rm, imm=Signal("011000"), is_branch=True, is_unconditional_branch=False)
            elif f2.cond.value == 0b1001:
                subs32__bc_ls(dest=f.Rd, flag_dest=1, src1=f.Rn, src2=f.Rm, imm=Signal("011000"), is_branch=True, is_unconditional_branch=False)
            elif f2.cond.value == 0b1011:
                subs32__bc_lt(dest=f.Rd, flag_dest=1, src1=f.Rn, src2=f.Rm, imm=Signal("011000"), is_branch=True, is_unconditional_branch=False)
            elif f2.cond.value == 0b1101:
                subs32__bc_le(dest=f.Rd, flag_dest=1, src1=f.Rn, src2=f.Rm, imm=Signal("011000"), is_branch=True, is_unconditional_branch=False)

        elif isinstance(self.translations[0], SUBS_32S_addsub_ext):
            if f2.cond.value == 0b0000:
                subs32__bc_eq(dest=f.Rd, flag_dest=1, src1=f.Rn, src2=f.Rm, imm=(f.option,Signal("000")), src1_is_stack_pointer=True, is_branch=True, is_unconditional_branch=False)
            elif f2.cond.value == 0b0010:
                subs32__bc_cs(dest=f.Rd, flag_dest=1, src1=f.Rn, src2=f.Rm, imm=(f.option,Signal("000")), src1_is_stack_pointer=True, is_branch=True, is_unconditional_branch=False)
            elif f2.cond.value == 0b0100:
                subs32__bc_mi(dest=f.Rd, flag_dest=1, src1=f.Rn, src2=f.Rm, imm=(f.option,Signal("000")), src1_is_stack_pointer=True, is_branch=True, is_unconditional_branch=False)
            elif f2.cond.value == 0b0110:
                subs32__bc_vs(dest=f.Rd, flag_dest=1, src1=f.Rn, src2=f.Rm, imm=(f.option,Signal("000")), src1_is_stack_pointer=True, is_branch=True, is_unconditional_branch=False)
            elif f2.cond.value == 0b1000:
                subs32__bc_hi(dest=f.Rd, flag_dest=1, src1=f.Rn, src2=f.Rm, imm=(f.option,Signal("000")), src1_is_stack_pointer=True, is_branch=True, is_unconditional_branch=False)
            elif f2.cond.value == 0b1010:
                subs32__bc_ge(dest=f.Rd, flag_dest=1, src1=f.Rn, src2=f.Rm, imm=(f.option,Signal("000")), src1_is_stack_pointer=True, is_branch=True, is_unconditional_branch=False)
            elif f2.cond.value == 0b1100:
                subs32__bc_gt(dest=f.Rd, flag_dest=1, src1=f.Rn, src2=f.Rm, imm=(f.option,Signal("000")), src1_is_stack_pointer=True, is_branch=True, is_unconditional_branch=False)
            elif f2.cond.value >= 0b1110:
                subs32__bc_al(dest=f.Rd, flag_dest=1, src1=f.Rn, src2=f.Rm, imm=(f.option,Signal("000")), src1_is_stack_pointer=True, is_branch=True, is_unconditional_branch=False)
            elif f2.cond.value == 0b0001:
                subs32__bc_ne(dest=f.Rd, flag_dest=1, src1=f.Rn, src2=f.Rm, imm=(f.option,Signal("000")), src1_is_stack_pointer=True, is_branch=True, is_unconditional_branch=False)
            elif f2.cond.value == 0b0011:
                subs32__bc_cc(dest=f.Rd, flag_dest=1, src1=f.Rn, src2=f.Rm, imm=(f.option,Signal("000")), src1_is_stack_pointer=True, is_branch=True, is_unconditional_branch=False)
            elif f2.cond.value == 0b0101:
                subs32__bc_pl(dest=f.Rd, flag_dest=1, src1=f.Rn, src2=f.Rm, imm=(f.option,Signal("000")), src1_is_stack_pointer=True, is_branch=True, is_unconditional_branch=False)
            elif f2.cond.value == 0b0111:
                subs32__bc_vc(dest=f.Rd, flag_dest=1, src1=f.Rn, src2=f.Rm, imm=(f.option,Signal("000")), src1_is_stack_pointer=True, is_branch=True, is_unconditional_branch=False)
            elif f2.cond.value == 0b1001:
                subs32__bc_ls(dest=f.Rd, flag_dest=1, src1=f.Rn, src2=f.Rm, imm=(f.option,Signal("000")), src1_is_stack_pointer=True, is_branch=True, is_unconditional_branch=False)
            elif f2.cond.value == 0b1011:
                subs32__bc_lt(dest=f.Rd, flag_dest=1, src1=f.Rn, src2=f.Rm, imm=(f.option,Signal("000")), src1_is_stack_pointer=True, is_branch=True, is_unconditional_branch=False)
            elif f2.cond.value == 0b1101:
                subs32__bc_le(dest=f.Rd, flag_dest=1, src1=f.Rn, src2=f.Rm, imm=(f.option,Signal("000")), src1_is_stack_pointer=True, is_branch=True, is_unconditional_branch=False)

        elif isinstance(self.translations[0], SUBS_32S_addsub_imm):
            if f2.cond.value == 0b0000:
                subs32__bc_eq(dest=f.Rd, flag_dest=1, src2=f.Rn, imm=(f.sh,f.imm12), src2_is_stack_pointer=True, is_branch=True, is_unconditional_branch=False)
            elif f2.cond.value == 0b0010:
                subs32__bc_cs(dest=f.Rd, flag_dest=1, src2=f.Rn, imm=(f.sh,f.imm12), src2_is_stack_pointer=True, is_branch=True, is_unconditional_branch=False)
            elif f2.cond.value == 0b0100:
                subs32__bc_mi(dest=f.Rd, flag_dest=1, src2=f.Rn, imm=(f.sh,f.imm12), src2_is_stack_pointer=True, is_branch=True, is_unconditional_branch=False)
            elif f2.cond.value == 0b0110:
                subs32__bc_vs(dest=f.Rd, flag_dest=1, src2=f.Rn, imm=(f.sh,f.imm12), src2_is_stack_pointer=True, is_branch=True, is_unconditional_branch=False)
            elif f2.cond.value == 0b1000:
                subs32__bc_hi(dest=f.Rd, flag_dest=1, src2=f.Rn, imm=(f.sh,f.imm12), src2_is_stack_pointer=True, is_branch=True, is_unconditional_branch=False)
            elif f2.cond.value == 0b1010:
                subs32__bc_ge(dest=f.Rd, flag_dest=1, src2=f.Rn, imm=(f.sh,f.imm12), src2_is_stack_pointer=True, is_branch=True, is_unconditional_branch=False)
            elif f2.cond.value == 0b1100:
                subs32__bc_gt(dest=f.Rd, flag_dest=1, src2=f.Rn, imm=(f.sh,f.imm12), src2_is_stack_pointer=True, is_branch=True, is_unconditional_branch=False)
            elif f2.cond.value >= 0b1110:
                subs32__bc_al(dest=f.Rd, flag_dest=1, src2=f.Rn, imm=(f.sh,f.imm12), src2_is_stack_pointer=True, is_branch=True, is_unconditional_branch=False)
            elif f2.cond.value == 0b0001:
                subs32__bc_ne(dest=f.Rd, flag_dest=1, src2=f.Rn, imm=(f.sh,f.imm12), src2_is_stack_pointer=True, is_branch=True, is_unconditional_branch=False)
            elif f2.cond.value == 0b0011:
                subs32__bc_cc(dest=f.Rd, flag_dest=1, src2=f.Rn, imm=(f.sh,f.imm12), src2_is_stack_pointer=True, is_branch=True, is_unconditional_branch=False)
            elif f2.cond.value == 0b0101:
                subs32__bc_pl(dest=f.Rd, flag_dest=1, src2=f.Rn, imm=(f.sh,f.imm12), src2_is_stack_pointer=True, is_branch=True, is_unconditional_branch=False)
            elif f2.cond.value == 0b0111:
                subs32__bc_vc(dest=f.Rd, flag_dest=1, src2=f.Rn, imm=(f.sh,f.imm12), src2_is_stack_pointer=True, is_branch=True, is_unconditional_branch=False)
            elif f2.cond.value == 0b1001:
                subs32__bc_ls(dest=f.Rd, flag_dest=1, src2=f.Rn, imm=(f.sh,f.imm12), src2_is_stack_pointer=True, is_branch=True, is_unconditional_branch=False)
            elif f2.cond.value == 0b1011:
                subs32__bc_lt(dest=f.Rd, flag_dest=1, src2=f.Rn, imm=(f.sh,f.imm12), src2_is_stack_pointer=True, is_branch=True, is_unconditional_branch=False)
            elif f2.cond.value == 0b1101:
                subs32__bc_le(dest=f.Rd, flag_dest=1, src2=f.Rn, imm=(f.sh,f.imm12), src2_is_stack_pointer=True, is_branch=True, is_unconditional_branch=False)

        elif isinstance(self.translations[0], SUBS_64_addsub_shift):
            if f2.cond.value == 0b0000:
                subs64__bc_eq(dest=f.Rd, flag_dest=1, src1=f.Rn, src2=f.Rm, imm=Signal("011000"), is_branch=True, is_unconditional_branch=False)
            elif f2.cond.value == 0b0010:
                subs64__bc_cs(dest=f.Rd, flag_dest=1, src1=f.Rn, src2=f.Rm, imm=Signal("011000"), is_branch=True, is_unconditional_branch=False)
            elif f2.cond.value == 0b0100:
                subs64__bc_mi(dest=f.Rd, flag_dest=1, src1=f.Rn, src2=f.Rm, imm=Signal("011000"), is_branch=True, is_unconditional_branch=False)
            elif f2.cond.value == 0b0110:
                subs64__bc_vs(dest=f.Rd, flag_dest=1, src1=f.Rn, src2=f.Rm, imm=Signal("011000"), is_branch=True, is_unconditional_branch=False)
            elif f2.cond.value == 0b1000:
                subs64__bc_hi(dest=f.Rd, flag_dest=1, src1=f.Rn, src2=f.Rm, imm=Signal("011000"), is_branch=True, is_unconditional_branch=False)
            elif f2.cond.value == 0b1010:
                subs64__bc_ge(dest=f.Rd, flag_dest=1, src1=f.Rn, src2=f.Rm, imm=Signal("011000"), is_branch=True, is_unconditional_branch=False)
            elif f2.cond.value == 0b1100:
                subs64__bc_gt(dest=f.Rd, flag_dest=1, src1=f.Rn, src2=f.Rm, imm=Signal("011000"), is_branch=True, is_unconditional_branch=False)
            elif f2.cond.value >= 0b1110:
                subs64__bc_al(dest=f.Rd, flag_dest=1, src1=f.Rn, src2=f.Rm, imm=Signal("011000"), is_branch=True, is_unconditional_branch=False)
            elif f2.cond.value == 0b0001:
                subs64__bc_ne(dest=f.Rd, flag_dest=1, src1=f.Rn, src2=f.Rm, imm=Signal("011000"), is_branch=True, is_unconditional_branch=False)
            elif f2.cond.value == 0b0011:
                subs64__bc_cc(dest=f.Rd, flag_dest=1, src1=f.Rn, src2=f.Rm, imm=Signal("011000"), is_branch=True, is_unconditional_branch=False)
            elif f2.cond.value == 0b0101:
                subs64__bc_pl(dest=f.Rd, flag_dest=1, src1=f.Rn, src2=f.Rm, imm=Signal("011000"), is_branch=True, is_unconditional_branch=False)
            elif f2.cond.value == 0b0111:
                subs64__bc_vc(dest=f.Rd, flag_dest=1, src1=f.Rn, src2=f.Rm, imm=Signal("011000"), is_branch=True, is_unconditional_branch=False)
            elif f2.cond.value == 0b1001:
                subs64__bc_ls(dest=f.Rd, flag_dest=1, src1=f.Rn, src2=f.Rm, imm=Signal("011000"), is_branch=True, is_unconditional_branch=False)
            elif f2.cond.value == 0b1011:
                subs64__bc_lt(dest=f.Rd, flag_dest=1, src1=f.Rn, src2=f.Rm, imm=Signal("011000"), is_branch=True, is_unconditional_branch=False)
            elif f2.cond.value == 0b1101:
                subs64__bc_le(dest=f.Rd, flag_dest=1, src1=f.Rn, src2=f.Rm, imm=Signal("011000"), is_branch=True, is_unconditional_branch=False)
                
        elif isinstance(self.translations[0], SUBS_64S_addsub_ext):
            if f2.cond.value == 0b0000:
                subs64__bc_eq(dest=f.Rd, flag_dest=1, src1=f.Rn, src2=f.Rm, imm=(f.option,Signal("000")), src1_is_stack_pointer=True, is_branch=True, is_unconditional_branch=False)
            elif f2.cond.value == 0b0010:
                subs64__bc_cs(dest=f.Rd, flag_dest=1, src1=f.Rn, src2=f.Rm, imm=(f.option,Signal("000")), src1_is_stack_pointer=True, is_branch=True, is_unconditional_branch=False)
            elif f2.cond.value == 0b0100:
                subs64__bc_mi(dest=f.Rd, flag_dest=1, src1=f.Rn, src2=f.Rm, imm=(f.option,Signal("000")), src1_is_stack_pointer=True, is_branch=True, is_unconditional_branch=False)
            elif f2.cond.value == 0b0110:
                subs64__bc_vs(dest=f.Rd, flag_dest=1, src1=f.Rn, src2=f.Rm, imm=(f.option,Signal("000")), src1_is_stack_pointer=True, is_branch=True, is_unconditional_branch=False)
            elif f2.cond.value == 0b1000:
                subs64__bc_hi(dest=f.Rd, flag_dest=1, src1=f.Rn, src2=f.Rm, imm=(f.option,Signal("000")), src1_is_stack_pointer=True, is_branch=True, is_unconditional_branch=False)
            elif f2.cond.value == 0b1010:
                subs64__bc_ge(dest=f.Rd, flag_dest=1, src1=f.Rn, src2=f.Rm, imm=(f.option,Signal("000")), src1_is_stack_pointer=True, is_branch=True, is_unconditional_branch=False)
            elif f2.cond.value == 0b1100:
                subs64__bc_gt(dest=f.Rd, flag_dest=1, src1=f.Rn, src2=f.Rm, imm=(f.option,Signal("000")), src1_is_stack_pointer=True, is_branch=True, is_unconditional_branch=False)
            elif f2.cond.value >= 0b1110:
                subs64__bc_al(dest=f.Rd, flag_dest=1, src1=f.Rn, src2=f.Rm, imm=(f.option,Signal("000")), src1_is_stack_pointer=True, is_branch=True, is_unconditional_branch=False)
            elif f2.cond.value == 0b0001:
                subs64__bc_ne(dest=f.Rd, flag_dest=1, src1=f.Rn, src2=f.Rm, imm=(f.option,Signal("000")), src1_is_stack_pointer=True, is_branch=True, is_unconditional_branch=False)
            elif f2.cond.value == 0b0011:
                subs64__bc_cc(dest=f.Rd, flag_dest=1, src1=f.Rn, src2=f.Rm, imm=(f.option,Signal("000")), src1_is_stack_pointer=True, is_branch=True, is_unconditional_branch=False)
            elif f2.cond.value == 0b0101:
                subs64__bc_pl(dest=f.Rd, flag_dest=1, src1=f.Rn, src2=f.Rm, imm=(f.option,Signal("000")), src1_is_stack_pointer=True, is_branch=True, is_unconditional_branch=False)
            elif f2.cond.value == 0b0111:
                subs64__bc_vc(dest=f.Rd, flag_dest=1, src1=f.Rn, src2=f.Rm, imm=(f.option,Signal("000")), src1_is_stack_pointer=True, is_branch=True, is_unconditional_branch=False)
            elif f2.cond.value == 0b1001:
                subs64__bc_ls(dest=f.Rd, flag_dest=1, src1=f.Rn, src2=f.Rm, imm=(f.option,Signal("000")), src1_is_stack_pointer=True, is_branch=True, is_unconditional_branch=False)
            elif f2.cond.value == 0b1011:
                subs64__bc_lt(dest=f.Rd, flag_dest=1, src1=f.Rn, src2=f.Rm, imm=(f.option,Signal("000")), src1_is_stack_pointer=True, is_branch=True, is_unconditional_branch=False)
            elif f2.cond.value == 0b1101:
                subs64__bc_le(dest=f.Rd, flag_dest=1, src1=f.Rn, src2=f.Rm, imm=(f.option,Signal("000")), src1_is_stack_pointer=True, is_branch=True, is_unconditional_branch=False)
                    

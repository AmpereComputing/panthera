class LD1_asisdlse_R1_1v(_JSON_LD1_asisdlse_R1_1v):

    pmu_bucket = 'load'

    def decode(self, f):
        #Dont_touch_multiuop
        if f.Q.value == 0b0:
            if f.size.value == 0b00:
                ldrv_d_8b_128(dest=f.Rt, src1=f.Rn, imm=Signal("000000000"), dest_inc=0, src1_is_stack_pointer=True)
            elif f.size.value == 0b01:
                ldrv_d_4h_128(dest=f.Rt, src1=f.Rn, imm=Signal("000000000"), dest_inc=0, src1_is_stack_pointer=True)
            elif f.size.value == 0b10:
                ldrv_d_2w_128(dest=f.Rt, src1=f.Rn, imm=Signal("000000000"), dest_inc=0, src1_is_stack_pointer=True)
            elif f.size.value == 0b11:
                ldrv_d_128(dest=f.Rt, src1=f.Rn, imm=Signal("000000000"), dest_inc=0, src1_is_stack_pointer=True)
        elif f.Q.value == 0b1:
            if f.size.value == 0b00:
                ldrv_q_16b_128(dest=f.Rt, src1=f.Rn, imm=Signal("000000000"), dest_inc=0, src1_is_stack_pointer=True)
            elif f.size.value == 0b01:
                ldrv_q_8h_128(dest=f.Rt, src1=f.Rn, imm=Signal("000000000"), dest_inc=0, src1_is_stack_pointer=True)
            elif f.size.value == 0b10:
                ldrv_q_4w_128(dest=f.Rt, src1=f.Rn, imm=Signal("000000000"), dest_inc=0, src1_is_stack_pointer=True)
            elif f.size.value == 0b11:
                ldrv_q_2d_128(dest=f.Rt, src1=f.Rn, imm=Signal("000000000"), dest_inc=0, src1_is_stack_pointer=True)


class LD1_asisdlse_R2_2v(_JSON_LD1_asisdlse_R2_2v):

    pmu_bucket = 'load'

    def decode(self, f):
        #Dont_touch_multiuop
        if f.Q.value == 0b0:
            if   f.size.value == 0b00:
                ldrv_d_8b_128(dest=f.Rt, src1=f.Rn, imm=Signal("000000000"), dest_inc=0, src1_is_stack_pointer=True)
                ldrv_d_8b_128(dest=f.Rt, src1=f.Rn, imm=Signal("000001000"), dest_inc=1, src1_is_stack_pointer=True)
            elif f.size.value == 0b01:
                ldrv_d_4h_128(dest=f.Rt, src1=f.Rn, imm=Signal("000000000"), dest_inc=0, src1_is_stack_pointer=True)
                ldrv_d_4h_128(dest=f.Rt, src1=f.Rn, imm=Signal("000001000"), dest_inc=1, src1_is_stack_pointer=True)
            elif f.size.value == 0b10:
                ldrv_d_2w_128(dest=f.Rt, src1=f.Rn, imm=Signal("000000000"), dest_inc=0, src1_is_stack_pointer=True)
                ldrv_d_2w_128(dest=f.Rt, src1=f.Rn, imm=Signal("000001000"), dest_inc=1, src1_is_stack_pointer=True)
            elif f.size.value == 0b11:
                ldrv_d_128(dest=f.Rt, src1=f.Rn, imm=Signal("000000000"), dest_inc=0, src1_is_stack_pointer=True)
                ldrv_d_128(dest=f.Rt, src1=f.Rn, imm=Signal("000001000"), dest_inc=1, src1_is_stack_pointer=True)
        elif f.Q.value == 0b1:
            if   f.size.value == 0b00:
                ldrv_q_16b_128(dest=f.Rt, src1=f.Rn, imm=Signal("000000000"), dest_inc=0, src1_is_stack_pointer=True)
                ldrv_q_16b_128(dest=f.Rt, src1=f.Rn, imm=Signal("000010000"), dest_inc=1, src1_is_stack_pointer=True)
            elif f.size.value == 0b01:
                ldrv_q_8h_128(dest=f.Rt, src1=f.Rn, imm=Signal("000000000"), dest_inc=0, src1_is_stack_pointer=True)
                ldrv_q_8h_128(dest=f.Rt, src1=f.Rn, imm=Signal("000010000"), dest_inc=1, src1_is_stack_pointer=True)
            elif f.size.value == 0b10:
                ldrv_q_4w_128(dest=f.Rt, src1=f.Rn, imm=Signal("000000000"), dest_inc=0, src1_is_stack_pointer=True)
                ldrv_q_4w_128(dest=f.Rt, src1=f.Rn, imm=Signal("000010000"), dest_inc=1, src1_is_stack_pointer=True)
            elif f.size.value == 0b11:
                ldrv_q_2d_128(dest=f.Rt, src1=f.Rn, imm=Signal("000000000"), dest_inc=0, src1_is_stack_pointer=True)
                ldrv_q_2d_128(dest=f.Rt, src1=f.Rn, imm=Signal("000010000"), dest_inc=1, src1_is_stack_pointer=True)


class LD1_asisdlse_R3_3v(_JSON_LD1_asisdlse_R3_3v):

    pmu_bucket = 'load'

    def decode(self, f):
        #Dont_touch_multiuop
        if f.Q.value == 0b0:
            if   f.size.value == 0b00:
                ldrv_d_8b_128(dest=f.Rt, src1=f.Rn, imm=Signal("000000000"), dest_inc=0, src1_is_stack_pointer=True)
                ldrv_d_8b_128(dest=f.Rt, src1=f.Rn, imm=Signal("000001000"), dest_inc=1, src1_is_stack_pointer=True)
                ldrv_d_8b_128(dest=f.Rt, src1=f.Rn, imm=Signal("000010000"), dest_inc=2, src1_is_stack_pointer=True)
            elif f.size.value == 0b01:
                ldrv_d_4h_128(dest=f.Rt, src1=f.Rn, imm=Signal("000000000"), dest_inc=0, src1_is_stack_pointer=True)
                ldrv_d_4h_128(dest=f.Rt, src1=f.Rn, imm=Signal("000001000"), dest_inc=1, src1_is_stack_pointer=True)
                ldrv_d_4h_128(dest=f.Rt, src1=f.Rn, imm=Signal("000010000"), dest_inc=2, src1_is_stack_pointer=True)
            elif f.size.value == 0b10:
                ldrv_d_2w_128(dest=f.Rt, src1=f.Rn, imm=Signal("000000000"), dest_inc=0, src1_is_stack_pointer=True)
                ldrv_d_2w_128(dest=f.Rt, src1=f.Rn, imm=Signal("000001000"), dest_inc=1, src1_is_stack_pointer=True)

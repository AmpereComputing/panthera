class CASPL_CP32_ldstexcl(_JSON_CASPL_CP32_comswappr):

    pmu_bucket = 'store_release'

    def decode(self, f):
        # compare data
        bfm64(dest=s0, src1=f.Rs, src2=f.Rs, src1_even_inc=True, imm=Signal("100000011111"))
        # swap data
        bfm64(dest=s1, src1=f.Rt, src2=f.Rt, src1_even_inc=True, imm=Signal("100000011111"))
        # this uop uses Rs as a temp
        caspal_w_32(dest=s0, src1=f.Rn, src2=s0, imm=Signal("0"), src1_is_stack_pointer=True)
        stdhi_d(src2=s1, imm=Signal('0'))
        # fix dests
        # mem[31:0] -> Rs      -- immr=0, imms=31
        bfm64(dest=f.Rs, src1=s0, src2=ZR,                     imm=Signal("000000011111"))
        # mem[63:32] -> R(s+1) -- immr=32, imms=63
        bfm64(dest=f.Rs, src1=s0, src2=ZR, dest_even_inc=True, imm=Signal("100000111111"))

class CASP_CP64_ldstexcl(_JSON_CASP_CP64_comswappr):

    pmu_bucket = 'store'

    def decode(self, f):
        # casp double word requires two store pairs
        # destructive dest: we need to make sure neither stdhi depends on Rs to cover the case where Rs==Rt. And we need
        #                   to prevent casp_hi from depending on the result form casp_lo
        orr64         (dest=s0,   src1=ZR,   src2=f.Rs, src2_even_inc=True, imm=Signal("000"))
        casp_lo_d_64  (dest=s1,   src1=f.Rn, src2=f.Rs,                     imm=Signal("0"), src1_is_stack_pointer=True)
        stdhi_d       (                      src2=s0, imm=Signal('0'))
        # second one transfers the swap data (Rt, Rt+1)
        # (note that the address for this one doesn't really matter)
        orr64         (dest=s0,   src1=ZR,   src2=f.Rt, src2_even_inc=True, imm=Signal("000"))
        casp_hi_d_64  (dest=f.Rs, src1=f.Rn, src2=f.Rt, dest_even_inc=True, imm=Signal("0"), src1_is_stack_pointer=True)
        stdhi_d       (                      src2=s0, imm=Signal('0'))
        orr64         (dest=f.Rs, src1=ZR,   src2=s1,                       imm=Signal("000"))



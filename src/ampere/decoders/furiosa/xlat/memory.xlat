class PRFM_P_ldst_pos(_JSON_PRFM_P_ldst_pos):

    pmu_bucket = 'load'

    def decode(self, f):
        if f.Rt.value & 0b11000 == 0b10000:
            # store prefetch
            if f.Rt.value & 0b00110 == 0b00000:
                # prefetch to L1
                prfm_st_l1_pos(src1=f.Rn, imm=f.imm12, src1_is_stack_pointer=True)
            else:
                # prefetch to L2 (fallthrough case happens even if instr targets L3)
                prfm_st_l2_pos(src1=f.Rn, imm=f.imm12, src1_is_stack_pointer=True)
        elif f.Rt.value & 0b11000 == 0b01000:
            # instruction prefetch -- always target L2
            prfm_ld_l2_pos(src1=f.Rn, imm=f.imm12, src1_is_stack_pointer=True)
        else:
            # load prefetch (fallthrough case because it's unlikely to cause a problem to prefetch for read)
            if f.Rt.value & 0b00110 == 0b00000:
                # prefetch to L1
                prfm_ld_l1_pos(src1=f.Rn, imm=f.imm12, src1_is_stack_pointer=True)
            else:
                # prefetch to L2 otherwise
                prfm_ld_l2_pos(src1=f.Rn, imm=f.imm12, src1_is_stack_pointer=True)

class PRFM_P_loadlit(_JSON_PRFM_P_loadlit):

    pmu_bucket = 'load'

    def decode(self, f):
        if f.Rt.value & 0b11000 == 0b10000:
            # store prefetch
            if f.Rt.value & 0b00110 == 0b00000:
                # prefetch to L1
                prfm_st_l1(imm=f.imm19, use_pc=True, imm_shift=2, imm_signext=True)
            else:
                # prefetch to L2 (fallthrough case happens even if instr targets L3)
                prfm_st_l2(imm=f.imm19, use_pc=True, imm_shift=2, imm_signext=True)
        elif f.Rt.value & 0b11000 == 0b01000:
            # instruction prefetch -- always target L2
            prfm_ld_l2(imm=f.imm19, use_pc=True, imm_shift=2, imm_signext=True)
        else:
            # load prefetch (fallthrough case because it's unlikely to cause a problem to prefetch for read)
            if f.Rt.value & 0b00110 == 0b00000:
                # prefetch to L1
                prfm_ld_l1(imm=f.imm19, use_pc=True, imm_shift=2, imm_signext=True)
            else:
                # prefetch to L2 otherwise
                prfm_ld_l2(imm=f.imm19, use_pc=True, imm_shift=2, imm_signext=True)


class STRB_32B_ldst_regoff(_JSON_STRB_32B_ldst_regoff):

    pmu_bucket = 'store'

    def decode(self, f):
        if f.option.value == 0b110:
            sxt64(dest=s0, src1=f.Rm, imm=(Signal("000110")))
            sta_b(src1=f.Rn, src2=s0, src1_is_stack_pointer=True, imm=(Signal("1"),f.S,Signal("000")), esr_isv=True)
        else:
            if f.option.value == 0b010:
                sta_b(src1=f.Rn, src2=f.Rm, src1_is_stack_pointer=True, imm=(Signal("0"),f.S,Signal("000")), esr_isv=True)
            else:
                sta_b(src1=f.Rn, src2=f.Rm, src1_is_stack_pointer=True, imm=(Signal("1"),f.S,Signal("000")), esr_isv=True)
        std_b(src2=f.Rt, imm=Signal('0'))



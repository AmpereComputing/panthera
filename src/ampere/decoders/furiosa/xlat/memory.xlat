        #Dont_touch_multiuop
        if f.Q.value == 0b0:
            if f.size.value == 0b00:
                ldrv_b_128(dest=T0, src1=f.Rn, imm=Signal("000000000"), src1_is_stack_pointer=True)
                ldrv_b_128(dest=T1, src1=f.Rn, imm=Signal("000000001"), src1_is_stack_pointer=True)
                ldrv_b_128(dest=T2, src1=f.Rn, imm=Signal("000000010"), src1_is_stack_pointer=True)
                ldrv_b_128(dest=T3, src1=f.Rn, imm=Signal("000000011"), src1_is_stack_pointer=True)
                dup_idx0_b_sv(dest=f.Rt, src2=T0, idx=Signal("01000"))
                dup_idx0_b_sv(dest=f.Rt, src2=T1, idx=Signal("01000"), dest_inc=1)
                dup_idx0_b_sv(dest=f.Rt, src2=T2, idx=Signal("01000"), dest_inc=2)
                dup_idx0_b_sv(dest=f.Rt, src2=T3, idx=Signal("01000"), dest_inc=3)
            elif f.size.value == 0b01:
                ldrv_h_128(dest=T0, src1=f.Rn, imm=Signal("000000000"), src1_is_stack_pointer=True)
                ldrv_h_128(dest=T1, src1=f.Rn, imm=Signal("000000010"), src1_is_stack_pointer=True)
                ldrv_h_128(dest=T2, src1=f.Rn, imm=Signal("000000100"), src1_is_stack_pointer=True)
                ldrv_h_128(dest=T3, src1=f.Rn, imm=Signal("000000110"), src1_is_stack_pointer=True)
                dup_idx0_h_sv(dest=f.Rt, src2=T0, idx=Signal("01000"))
                dup_idx0_h_sv(dest=f.Rt, src2=T1, idx=Signal("01000"), dest_inc=1)
                dup_idx0_h_sv(dest=f.Rt, src2=T2, idx=Signal("01000"), dest_inc=2)
                dup_idx0_h_sv(dest=f.Rt, src2=T3, idx=Signal("01000"), dest_inc=3)
            elif f.size.value == 0b10:
                ldrv_w_128(dest=T0, src1=f.Rn, imm=Signal("000000000"), src1_is_stack_pointer=True)
                ldrv_w_128(dest=T1, src1=f.Rn, imm=Signal("000000100"), src1_is_stack_pointer=True)
                ldrv_w_128(dest=T2, src1=f.Rn, imm=Signal("000001000"), src1_is_stack_pointer=True)
                ldrv_w_128(dest=T3, src1=f.Rn, imm=Signal("000001100"), src1_is_stack_pointer=True)
                dup_idx0_s_sv(dest=f.Rt, src2=T0, idx=Signal("01000"))
                dup_idx0_s_sv(dest=f.Rt, src2=T1, idx=Signal("01000"), dest_inc=1)
                dup_idx0_s_sv(dest=f.Rt, src2=T2, idx=Signal("01000"), dest_inc=2)
                dup_idx0_s_sv(dest=f.Rt, src2=T3, idx=Signal("01000"), dest_inc=3)
            elif f.size.value == 0b11:
                ldrv_d_128(dest=f.Rt, src1=f.Rn, imm=Signal("000000000"), src1_is_stack_pointer=True)
                ldrv_d_128(dest=f.Rt, src1=f.Rn, imm=Signal("000001000"), src1_is_stack_pointer=True, dest_inc=1)
                ldrv_d_128(dest=f.Rt, src1=f.Rn, imm=Signal("000010000"), src1_is_stack_pointer=True, dest_inc=2)
                ldrv_d_128(dest=f.Rt, src1=f.Rn, imm=Signal("000011000"), src1_is_stack_pointer=True, dest_inc=3)
            add64     (dest=f.Rn, src1=f.Rn, src2=f.Rm, imm=Signal("011000"), dest_is_stack_pointer=True, src1_is_stack_pointer=True)
        elif f.Q.value == 0b1:
            if f.size.value == 0b00:
                ldrv_b_128(dest=T0, src1=f.Rn, imm=Signal("000000000"), src1_is_stack_pointer=True)
                ldrv_b_128(dest=T1, src1=f.Rn, imm=Signal("000000001"), src1_is_stack_pointer=True)
                ldrv_b_128(dest=T2, src1=f.Rn, imm=Signal("000000010"), src1_is_stack_pointer=True)
                ldrv_b_128(dest=T3, src1=f.Rn, imm=Signal("000000011"), src1_is_stack_pointer=True)
                dup_idx0_b_lv(dest=f.Rt, src2=T0, idx=Signal("01000"))
                dup_idx0_b_lv(dest=f.Rt, src2=T1, idx=Signal("01000"), dest_inc=1)
                dup_idx0_b_lv(dest=f.Rt, src2=T2, idx=Signal("01000"), dest_inc=2)
                dup_idx0_b_lv(dest=f.Rt, src2=T3, idx=Signal("01000"), dest_inc=3)
            elif f.size.value == 0b01:
                ldrv_h_128(dest=T0, src1=f.Rn, imm=Signal("000000000"), src1_is_stack_pointer=True)
                ldrv_h_128(dest=T1, src1=f.Rn, imm=Signal("000000010"), src1_is_stack_pointer=True)
                ldrv_h_128(dest=T2, src1=f.Rn, imm=Signal("000000100"), src1_is_stack_pointer=True)
                ldrv_h_128(dest=T3, src1=f.Rn, imm=Signal("000000110"), src1_is_stack_pointer=True)
                dup_idx0_h_lv(dest=f.Rt, src2=T0, idx=Signal("01000"))
                dup_idx0_h_lv(dest=f.Rt, src2=T1, idx=Signal("01000"), dest_inc=1)
                dup_idx0_h_lv(dest=f.Rt, src2=T2, idx=Signal("01000"), dest_inc=2)
                dup_idx0_h_lv(dest=f.Rt, src2=T3, idx=Signal("01000"), dest_inc=3)
            elif f.size.value == 0b10:
                ldrv_w_128(dest=T0, src1=f.Rn, imm=Signal("000000000"), src1_is_stack_pointer=True)
                ldrv_w_128(dest=T1, src1=f.Rn, imm=Signal("000000100"), src1_is_stack_pointer=True)
                ldrv_w_128(dest=T2, src1=f.Rn, imm=Signal("000001000"), src1_is_stack_pointer=True)
                ldrv_w_128(dest=T3, src1=f.Rn, imm=Signal("000001100"), src1_is_stack_pointer=True)
                dup_idx0_s_lv(dest=f.Rt, src2=T0, idx=Signal("01000"))
                dup_idx0_s_lv(dest=f.Rt, src2=T1, idx=Signal("01000"), dest_inc=1)
                dup_idx0_s_lv(dest=f.Rt, src2=T2, idx=Signal("01000"), dest_inc=2)
                dup_idx0_s_lv(dest=f.Rt, src2=T3, idx=Signal("01000"), dest_inc=3)
            elif f.size.value == 0b11:
                ldrv_d_128(dest=T0, src1=f.Rn, imm=Signal("000000000"), src1_is_stack_pointer=True)
                ldrv_d_128(dest=T1, src1=f.Rn, imm=Signal("000001000"), src1_is_stack_pointer=True)
                ldrv_d_128(dest=T2, src1=f.Rn, imm=Signal("000010000"), src1_is_stack_pointer=True)
                ldrv_d_128(dest=T3, src1=f.Rn, imm=Signal("000011000"), src1_is_stack_pointer=True)
                dup_idx0_d_lv(dest=f.Rt, src2=T0, idx=Signal("01100"))
                dup_idx0_d_lv(dest=f.Rt, src2=T1, idx=Signal("01100"), dest_inc=1)
                dup_idx0_d_lv(dest=f.Rt, src2=T2, idx=Signal("01100"), dest_inc=2)
                dup_idx0_d_lv(dest=f.Rt, src2=T3, idx=Signal("01100"), dest_inc=3)
            add64     (dest=f.Rn, src1=f.Rn, src2=f.Rm, imm=Signal("011000"), dest_is_stack_pointer=True, src1_is_stack_pointer=True)



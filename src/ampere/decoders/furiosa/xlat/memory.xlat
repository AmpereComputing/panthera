                uzp2_h_sv(dest=T1,   src1=T1, src2=T3)
                uzp1_b_sv(dest=f.Rt, src1=T2, src2=T4)
                uzp2_b_sv(dest=f.Rt, src1=T2, src2=T4, dest_inc=1)
                uzp1_b_sv(dest=f.Rt, src1=T0, src2=T1, dest_inc=2)
                uzp2_b_sv(dest=f.Rt, src1=T0, src2=T1, dest_inc=3)
            elif f.size.value == 0b01:
                ldrv_d_4h_128(dest=T0,  src1=f.Rn, imm=Signal("000000000"), src1_is_stack_pointer=True)
                ldrv_d_4h_128(dest=T1,  src1=f.Rn, imm=Signal("000001000"), src1_is_stack_pointer=True)
                uzp1_s_sv(dest=T2,   src1=T0, src2=T1)
                uzp2_s_sv(dest=T0,   src1=T0, src2=T1)
                ldrv_d_4h_128(dest=T1,  src1=f.Rn, imm=Signal("000010000"), src1_is_stack_pointer=True)
                ldrv_d_4h_128(dest=T3,  src1=f.Rn, imm=Signal("000011000"), src1_is_stack_pointer=True)
                uzp1_s_sv(dest=T4,   src1=T1, src2=T3)
                uzp2_s_sv(dest=T1,   src1=T1, src2=T3)
                uzp1_h_sv(dest=f.Rt, src1=T2, src2=T4)
                uzp2_h_sv(dest=f.Rt, src1=T2, src2=T4, dest_inc=1)
                uzp1_h_sv(dest=f.Rt, src1=T0, src2=T1, dest_inc=2)
                uzp2_h_sv(dest=f.Rt, src1=T0, src2=T1, dest_inc=3)
            elif f.size.value == 0b10:
                ldrv_d_2w_128(dest=T0, src1=f.Rn, imm=Signal("000000000"), src1_is_stack_pointer=True)
                ldrv_d_2w_128(dest=T2, src1=f.Rn, imm=Signal("000001000"), src1_is_stack_pointer=True)
                ldrv_d_2w_128(dest=T1, src1=f.Rn, imm=Signal("000010000"), src1_is_stack_pointer=True)
                ldrv_d_2w_128(dest=T3, src1=f.Rn, imm=Signal("000011000"), src1_is_stack_pointer=True)
                ins2_idx0_d_lv(dest=T0, src1=T0, src2=T2, fsu_imm=Signal("110000000"), idx=Signal("001100")) #imm5=11000 dest==upperDouble, imm4=0000 src=lowerDouble
                ins2_idx0_d_lv(dest=T1, src1=T1, src2=T3, fsu_imm=Signal("110000000"), idx=Signal("001100")) #imm5=11000 dest==upperDouble, imm4=0000 src=lowerDouble
                trn2_d_lv(dest=T2,   src1=T0, src2=T0)
                trn2_d_lv(dest=T3,   src1=T1, src2=T1)
                trn1_s_sv(dest=f.Rt, src1=T0, src2=T1)
                trn2_s_sv(dest=f.Rt, src1=T1, src2=T0, dest_inc=1)
                trn1_s_sv(dest=f.Rt, src1=T2, src2=T3, dest_inc=2)
                trn2_s_sv(dest=f.Rt, src1=T3, src2=T2, dest_inc=3)
            elif f.size.value == 0b11:
                not_implemented() #reserved
            add64     (dest=f.Rn, src1=f.Rn, src2=f.Rm, imm=Signal("011000"), dest_is_stack_pointer=True, src1_is_stack_pointer=True)
        elif f.Q.value == 0b1:

                zip2_h_lv(dest=T3, src1=f.Rt, src2=f.Rt, src1_inc=3, src2_inc=2, idx=(Signal('001110')))
                zip1_s_lv(dest=T0, src1=T2,   src2=T3,   src1_inc=0, src2_inc=0, idx=(Signal('001100')))

class ST4_asisdlse_R4(_JSON_ST4_asisdlse_R4):

    pmu_bucket = 'store'

    def decode(self, f):
        #Dont_touch_multiuop
        if f.Q.value == 0b0:
            if f.size.value == 0b00:
                zip1_b_lv(dest=T0, src1=f.Rt, src2=f.Rt, src1_inc=0, src2_inc=1, idx=(Signal('001100')))
                zip1_b_lv(dest=T1, src1=f.Rt, src2=f.Rt, src1_inc=2, src2_inc=3, idx=(Signal('001100')))
                zip1_h_lv(dest=T2, src1=T0,   src2=T1,   src1_inc=0, src2_inc=0, idx=(Signal('001100')))
                zip2_h_lv(dest=T3, src1=T1,   src2=T0,   src1_inc=0, src2_inc=0, idx=(Signal('001110')))
                ins2_idx0_d_lv(dest=T0, src1=T2, src2=T2, fsu_imm=Signal("010001000"), idx=Signal("001110")) #imm5=01000 dest==lowerDouble, imm4=1000 src=upperDouble
                ins2_idx0_d_lv(dest=T1, src1=T3, src2=T3, fsu_imm=Signal("010001000"), idx=Signal("001110")) #imm5=01000 dest==lowerDouble, imm4=1000 src=upperDouble
                sta_d_8b(src1=f.Rn, imm=Signal("0000000"), src1_is_stack_pointer=True, vector=1)
                stdv_q(src1=T2)
                sta_d_8b(src1=f.Rn, imm=Signal("0001000"), src1_is_stack_pointer=True, vector=1)
                stdv_q(src1=T0)
                sta_d_8b(src1=f.Rn, imm=Signal("0010000"), src1_is_stack_pointer=True, vector=1)
                stdv_q(src1=T3)
                sta_d_8b(src1=f.Rn, imm=Signal("0011000"), src1_is_stack_pointer=True, vector=1)
                stdv_q(src1=T1)
            elif f.size.value == 0b01:
                zip1_h_lv(dest=T0, src1=f.Rt, src2=f.Rt, src1_inc=0, src2_inc=1, idx=(Signal('001100')))
                zip1_h_lv(dest=T1, src1=f.Rt, src2=f.Rt, src1_inc=2, src2_inc=3, idx=(Signal('001100')))
                zip1_s_lv(dest=T2, src1=T0,   src2=T1,   src1_inc=0, src2_inc=0, idx=(Signal('001100')))
                zip2_s_lv(dest=T3, src1=T1,   src2=T0,   src1_inc=0, src2_inc=0, idx=(Signal('001110')))
                ins2_idx0_d_lv(dest=T0, src1=T2, src2=T2, fsu_imm=Signal("010001000"), idx=Signal("001110")) #imm5=01000 dest==lowerDouble, imm4=1000 src=upperDouble
                ins2_idx0_d_lv(dest=T1, src1=T3, src2=T3, fsu_imm=Signal("010001000"), idx=Signal("001110")) #imm5=01000 dest==lowerDouble, imm4=1000 src=upperDouble
                sta_d_4h(src1=f.Rn, imm=Signal("0000000"), src1_is_stack_pointer=True, vector=1)
                stdv_q(src1=T2)
                sta_d_4h(src1=f.Rn, imm=Signal("0001000"), src1_is_stack_pointer=True, vector=1)
                stdv_q(src1=T0)
                sta_d_4h(src1=f.Rn, imm=Signal("0010000"), src1_is_stack_pointer=True, vector=1)
                stdv_q(src1=T3)
                sta_d_4h(src1=f.Rn, imm=Signal("0011000"), src1_is_stack_pointer=True, vector=1)
                stdv_q(src1=T1)
            elif f.size.value == 0b10:
                zip1_s_lv(dest=T0, src1=f.Rt, src2=f.Rt, src1_inc=0, src2_inc=1, idx=(Signal('001100')))
                zip1_s_lv(dest=T1, src1=f.Rt, src2=f.Rt, src1_inc=2, src2_inc=3, idx=(Signal('001100')))
                zip1_d_lv(dest=T2, src1=T0,   src2=T1,   src1_inc=0, src2_inc=0, idx=(Signal('001100')))
                zip2_d_lv(dest=T3, src1=T1,   src2=T0,   src1_inc=0, src2_inc=0, idx=(Signal('001110')))
                ins2_idx0_d_lv(dest=T0, src1=T2, src2=T2, fsu_imm=Signal("010001000"), idx=Signal("001110")) #imm5=01000 dest==lowerDouble, imm4=1000 src=upperDouble
                ins2_idx0_d_lv(dest=T1, src1=T3, src2=T3, fsu_imm=Signal("010001000"), idx=Signal("001110")) #imm5=01000 dest==lowerDouble, imm4=1000 src=upperDouble

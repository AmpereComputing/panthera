                uzp2_s_lv(dest=T0,   src1=T0, src2=T1)
                ldrv_q_8h_128(dest=T1,  src1=f.Rn, imm=Signal("000100000"), src1_is_stack_pointer=True)
                ldrv_q_8h_128(dest=T3,  src1=f.Rn, imm=Signal("000110000"), src1_is_stack_pointer=True)
                uzp1_s_lv(dest=T4,   src1=T1, src2=T3)
                uzp2_s_lv(dest=T1,   src1=T1, src2=T3)

class CASP_CP32_ldstexcl(_JSON_CASP_CP32_comswappr):

    pmu_bucket = 'store'

    def decode(self, f):
        # for 32b paired case, we concat all the sources together isntead of creating two separate stores
        # BFM left shifts src1[31:0] and merges it into src2[63:32]
        # bfm64(dest=f.Rd, src1=<srca>, src2=<srcb>, imm=(f.immr,f.imms))
        # shiftcount: 32 = regsize-immr -> immr=32
        # # bits:     32 = imms + 1     -> imms=31
        # compare data
        bfm64(dest=s0, src1=f.Rs, src2=f.Rs, src1_even_inc=True, imm=Signal("100000011111"))
        # swap data
        bfm64(dest=s1, src1=f.Rt, src2=f.Rt, src1_even_inc=True, imm=Signal("100000011111"))
        casp_w_32(dest=s0, src1=f.Rn, src2=s0, imm=Signal("0"), src1_is_stack_pointer=True)
        stdhi_d(src2=s1, imm=Signal('0'))
        # fix dests
        # mem[31:0] -> Rs      -- immr=0, imms=31
        bfm64(dest=f.Rs, src1=s0, src2=ZR,                     imm=Signal("000000011111"))
        # mem[63:32] -> R(s+1) -- immr=32, imms=63
        bfm64(dest=f.Rs, src1=s0, src2=ZR, dest_even_inc=True, imm=Signal("100000111111"))

class CASPA_CP32_ldstexcl(_JSON_CASPA_CP32_comswappr):

    pmu_bucket = 'store_release'

    def decode(self, f):
        # compare data
        bfm64(dest=s0, src1=f.Rs, src2=f.Rs, src1_even_inc=True, imm=Signal("100000011111"))
        # swap data
        bfm64(dest=s1, src1=f.Rt, src2=f.Rt, src1_even_inc=True, imm=Signal("100000011111"))
        caspal_w_32(dest=s0, src1=f.Rn, src2=s0, imm=Signal("0"), src1_is_stack_pointer=True)
        stdhi_d(src2=s1, imm=Signal('0'))
        # fix dests
        # mem[31:0] -> Rs      -- immr=0, imms=31
        bfm64(dest=f.Rs, src1=s0, src2=ZR,                     imm=Signal("000000011111"))
        # mem[63:32] -> R(s+1) -- immr=32, imms=63
        bfm64(dest=f.Rs, src1=s0, src2=ZR, dest_even_inc=True, imm=Signal("100000111111"))


class CASPAL_CP32_ldstexcl(_JSON_CASPAL_CP32_comswappr):

    pmu_bucket = 'store_release'

    def decode(self, f):

class CASAB_C32_ldstexcl(_JSON_CASAB_C32_comswap):

    pmu_bucket = 'store_release'

    def decode(self, f):
        # concat the sources together to create store data value
        # shiftcount: 8 = regsize-immr -> immr=56
        # # bits:     8 = imms + 1     -> imms=7
        # imm=(f.immr,f.imms))
        bfm64(dest=s0, src1=f.Rt, src2=f.Rs, imm=Signal("111000000111"))
        casal_b_32(dest=f.Rs, src1=f.Rn, src2=s0, imm=Signal("0"), src1_is_stack_pointer=True)



class CAS_C64_ldstexcl(_JSON_CAS_C64_comswap):

    pmu_bucket = 'store'

    def decode(self, f):
        # destructive dest: for 64b case, we have no good alternative other than to create a temp
        # reg to break the dependency when Rs==Rt
        # If STD came first we wouldn't need to do this, but we built all the logic in IdrRen to expect
        # STA before STD
        orr64(dest=s0, src1=ZR, src2=f.Rt, imm=Signal("000"))
        # if you look in the yaml for any of the cas uops that are defined as pair: 1 when the instruction is NOT paired,
        # the mem_datasize field is half of what you expect. This is to help us correctly calculate the bytemask.
        # in this case, we want 8B so we have mem_datasize: w and pair: 1
        cas_d_64(dest=f.Rs, src1=f.Rn, src2=f.Rs, imm=Signal("0"), src1_is_stack_pointer=True)
        stdhi_d(src2=s0, imm=Signal('0'))



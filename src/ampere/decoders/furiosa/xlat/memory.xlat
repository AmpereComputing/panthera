from ampere.xlat import Signal, Translation
from proj.uop import *
from proj.xlat_register_constants import * # x30/ZR/xzr/SP_EL*/s0/s1/T0/T1/T2/T3/RGSR_EL1

class CAS_C32_ldstexcl(_JSON_CAS_C32_comswap):

    pmu_bucket = 'store'

    def decode(self, f):
        # looks like a store pair -- compare data is low bytes (Rs), swap data is high bytes (Rt)
        # destructive dest -- need to handle the case where Rs==Rt
        # for this case, we can't use a vanilla STP because the stdhi will think it depends on
        # the first uop. But the store can't actually complete until we get both uops.
        # For the 32b case, we can avoid this by making the cas a SUS instead of a pair:
        # src1=swap data, src2=comp data
        bfm64(dest=s0, src1=f.Rt, src2=f.Rs, imm=Signal("100000011111"))
        cas_w_32(dest=f.Rs, src1=f.Rn, src2=s0, imm=Signal("0"), src1_is_stack_pointer=True)

class CASA_C32_ldstexcl(_JSON_CASA_C32_comswap):

    pmu_bucket = 'store_release'

    def decode(self, f):
        bfm64(dest=s0, src1=f.Rt, src2=f.Rs, imm=Signal("100000011111"))
        casal_w_32(dest=f.Rs, src1=f.Rn, src2=s0, imm=Signal("0"), src1_is_stack_pointer=True)



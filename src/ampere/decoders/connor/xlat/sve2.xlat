class cadd_z_zz_(_JSON_cadd_z_zz_):

    movprfx_fusion = "unpredicated"
    pmu_events = ['INT_SPEC', 'SVE_INT_SPEC', 'SIMD_INST_SPEC', 'SVE_UOP_SPEC', 'SVE_INST_SPEC']

    def decode(self, f):
        # Number of uops 8: cadd270_b_uv, cadd270_d_uv, cadd270_h_uv, cadd270_s_uv, cadd90_b_uv, cadd90_d_uv, cadd90_h_uv, cadd90_s_uv
        if f.size.value == 0b00:
            if f.rot.value == 0b0:
                cadd90_b_uv(dest=f.Zdn, src1=f.Zm, src2=f.Zdn)
            elif f.rot.value == 0b1:
                cadd270_b_uv(dest=f.Zdn, src1=f.Zm, src2=f.Zdn)
        elif f.size.value == 0b01:
            if f.rot.value == 0b0:
                cadd90_h_uv(dest=f.Zdn, src1=f.Zm, src2=f.Zdn)
            elif f.rot.value == 0b1:
                cadd270_h_uv(dest=f.Zdn, src1=f.Zm, src2=f.Zdn)
        elif f.size.value == 0b10:
            if f.rot.value == 0b0:
                cadd90_s_uv(dest=f.Zdn, src1=f.Zm, src2=f.Zdn, idx=(Signal('010011')))
            elif f.rot.value == 0b1:
                cadd270_s_uv(dest=f.Zdn, src1=f.Zm, src2=f.Zdn, idx=(Signal('010011')))
        elif f.size.value == 0b11:
            if f.rot.value == 0b0:
                cadd90_d_uv(dest=f.Zdn, src1=f.Zm, src2=f.Zdn, idx=(Signal('010010')))
            elif f.rot.value == 0b1:
                cadd270_d_uv(dest=f.Zdn, src1=f.Zm, src2=f.Zdn, idx=(Signal('010010')))



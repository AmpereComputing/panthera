class xar_z_zzi_(_JSON_xar_z_zzi_):

    movprfx_fusion = "unpredicated"
    pmu_events = ['INT_SPEC', 'SVE_INT_SPEC', 'SIMD_INST_SPEC', 'SVE_UOP_SPEC', 'SVE_INST_SPEC']

    def decode(self, f):
        # Number of uops 4: xar_b_uv, xar_d_uv, xar_h_uv, xar_s_uv
        if (f.tszh.value & 0b10 ) ==  0b10:
            xar_d_uv(dest=f.Zdn, src1=f.Zdn, src2=f.Zm)
        elif (f.tszh.value & 0b11 ) ==  0b00:
            if (f.tszl.value & 0b10 ) ==  0b10:
                xar_h_uv(dest=f.Zdn, src1=f.Zdn, src2=f.Zm)
            elif (f.tszl.value & 0b11 ) ==  0b01:
                xar_b_uv(dest=f.Zdn, src1=f.Zdn, src2=f.Zm)
        elif (f.tszh.value & 0b11 ) ==  0b01:
            xar_s_uv(dest=f.Zdn, src1=f.Zdn, src2=f.Zm)

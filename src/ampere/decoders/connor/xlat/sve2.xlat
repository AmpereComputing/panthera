class addp_z_p_zz_(_JSON_addp_z_p_zz_):

    movprfx_fusion = "unpredicated"
    pmu_events = ['INT_SPEC', 'SVE_INT_SPEC', 'SIMD_INST_SPEC', 'SVE_UOP_SPEC', 'SVE_INST_SPEC']

    def decode(self, f):
        # Number of uops 4: addp_b_pv, addp_d_pv, addp_h_pv, addp_s_pv
        if f.size.value == 0b00:
            addp_b_pv(dest=f.Zdn, pred=f.Pg, src1=f.Zdn, src2=f.Zm)
        elif f.size.value == 0b01:
            addp_h_pv(dest=f.Zdn, pred=f.Pg, src1=f.Zdn, src2=f.Zm)
        elif f.size.value == 0b10:
            addp_s_pv(dest=f.Zdn, pred=f.Pg, src1=f.Zdn, src2=f.Zm, idx=(Signal('111000')))
        elif f.size.value == 0b11:
            addp_d_pv(dest=f.Zdn, pred=f.Pg, src1=f.Zdn, src2=f.Zm, idx=(Signal('000011')))



class adclb_z_zzz_(_JSON_adclb_z_zzz_):

    movprfx_fusion = "unpredicated"
    pmu_events = ['INT_SPEC', 'SVE_INT_SPEC', 'SIMD_INST_SPEC', 'SVE_UOP_SPEC', 'SVE_INST_SPEC']

    def decode(self, f):
        # Number of uops 2: adclb_d_uv, adclb_s_uv
        if f.sz.value == 0b0:
            adclb_s_uv(dest=f.Zda, src1=f.Zda, src2=f.Zn, src3=f.Zm)
        elif f.sz.value == 0b1:
            adclb_d_uv(dest=f.Zda, src1=f.Zda, src2=f.Zn, src3=f.Zm)



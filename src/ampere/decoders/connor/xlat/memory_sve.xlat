class ld3d_z_p_bi_contiguous(_JSON_ld3d_z_p_bi_contiguous):

    mem_tag_checked = 'n != 31'
    #  mem:  B3 B2 | B1 A3 | A2 A1 (low)
    #         T2      T1      T0
    #
    #  reg:  B1 A1 | B2 A2 | B3 A3
    #          zt    zt+1    zt+2
    # 1st and 3rd can be inserts. middle one is a swap
    pmu_events = ['LD_SPEC', 'SVE_LDST_CONTIG_SPEC', 'SVE_LDST_MULTI_SPEC', 'SVE_LDST_SPEC', 'SVE_UOP_SPEC', 'SVE_INST_SPEC', 'SIMD_INST_SPEC']

    def decode(self, f):
        add64_idximm(dest=s0, src2=f.Rn, imm=f.imm4, imm_mul48=True, imm_signext=True, src2_is_stack_pointer=True)
        ld_1of3_d_pv(dest=T0, src3=f.Pg, src1=f.Rn, imm=f.imm4, imm_mul48=True, imm_signext=True, src1_is_stack_pointer=True)
        ld_2of3_d_pv(dest=T1, src3=f.Pg, src1=s0, imm=Signal("000010000"))
        ld_3of3_d_pv(dest=T2, src3=f.Pg, src1=s0, imm=Signal("000100000"))
        ins2_idx0_d_lv(dest=f.Zt, src1=T0, src2=T1, fsu_imm=Signal("110001000"), idx=Signal("001110"))  #imm5=11000 dest==upperDouble, imm4=1000 src=upperDouble
        ld3b_d_lv(dest=f.Zt, dest_inc=1, src1=T0, src2=T2)
        ins2_idx0_d_lv(dest=f.Zt, dest_inc=2, src1=T1, src2=T2, fsu_imm=Signal("110001000"), idx=Signal("001110"))  #imm5=11000 dest==upperDouble, imm4=1000 src=upperDouble



        gather_b_1of2(dest=T0, src3=f.Pg, src1=s0, imm=f.imm5, imm_signext=False, imm_shift=0)
        gather_b_2of2(dest=T0, src3=f.Pg, src1=s1, imm=f.imm5, imm_signext=False, imm_shift=0)
        movprfx_d_uv(dest=f.Zt, src2=T0)



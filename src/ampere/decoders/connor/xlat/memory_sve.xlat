# -*- python -*-
from ampere.xlat import Signal, Translation
from proj.uop import *
from proj.xlat_register_constants import * # x30/ZR/xzr/SP_EL*/s0/s1/T0/T1/T2/T3/RGSR_EL1
import re

# vector=1 is not required for sta-type uops.
# vector=1 is used by LSU for loads to direct the wake to FSU.
# vector=1 is set in yaml for sve uops

# Immediate control fields
#
# IDR handles immediates where result is 12b or fewer.
# Two imm9 cases need to be handled by IXU (ldr_uv, sta_uv).
#
# VARIABLE      USED BY   VALUES      WHERE
# ------------  --------  ----------- ------
# imm_signext   IDR       True, False xlat
# imm_shift     IDR       number      xlat
# offset_lsl    IXU       number      yaml
# offset_ext    IXU       sign,zero   yaml
#
# imm_signext should agree with offset_ext.
# If both imm_shift>0 and offset_lsl>0 that will result in double shifting, probably unintentionally
#
# offset_type   not-used
# offset_size   not-used
#
# IDR figures out the width of the imm field on its own and does not need it in the yaml or xlat.

# bytes -> bytes  msz = 16B -> shift 4
# bytes -> hwords msz = 8B  -> shift 3
# bytes -> words  msz = 4B  -> shift 2
# bytes -> dwords msz = 2B  -> shift 1

# hwords -> hwords msize = 16B -> shift 4
# hwords -> words  msize = 8B -> shift 3
# hwords -> dwords msize = 4B -> shift 2

def prfop_load(prfop: int) -> bool:
    if ((prfop>>3) & 1) == 0:
        return True
    return False


def prfop_L1(prfop: int) -> bool:
    if ((prfop>>1) & 3) == 0:
        return True
    return False


def prfop_ignore(prfop: int) -> bool:
    if ((prfop>>1) & 3) in [2,3]: # L3 or undefined level
        return True
    return False


def prfop_nontemporal(prfop: int) -> bool:
    if (prfop & 1) == 1:
        return True
    return False


def prf_refine(uop_template: str, prfop: int , **kwargs):
    '''This is called by SVE prefetches that use the prfop field. It
    refines the uop_template string to have the right substring for
    the {ld,st}x{l1,l2}x{kp,nt} and then returns by calling the uop it
    looked up in the globals where the uop-loading machinery stashes
    them. It assumes that we have already filtered out the prefetches
    that we are turning into nops (those targeting L3 and those with prfop[2:1]=0b11).

    Example: calling
         prf_refine(uop_template='gatherprf_XX_b_1of4',
                    prfop=f.prfop.value,
                    src3=f.Pg, src1=s0, imm=f.imm5, imm_signext=False, imm_shift=0)

       will ultimately generate all 8 versions the follwing uops with the arguments
       from the 3rd line as required when the xlat processing evaluates the decode() function
       with all 8 values of f.prfop. The "XX" is a replaced with the right combination of the
       6 letter codes we are using to describe the prefetches.

         gatherprf_ldl1kp_b_1of4(src3=f.Pg, src1=s0, imm=f.imm5, imm_signext=False, imm_shift=0)
         gatherprf_ldl1nt_b_1of4(src3=f.Pg, src1=s0, imm=f.imm5, imm_signext=False, imm_shift=0)
         gatherprf_ldl2kp_b_1of4(src3=f.Pg, src1=s0, imm=f.imm5, imm_signext=False, imm_shift=0)
         gatherprf_ldl2nt_b_1of4(src3=f.Pg, src1=s0, imm=f.imm5, imm_signext=False, imm_shift=0)
         gatherprf_stl1kp_b_1of4(src3=f.Pg, src1=s0, imm=f.imm5, imm_signext=False, imm_shift=0)
         gatherprf_stl1nt_b_1of4(src3=f.Pg, src1=s0, imm=f.imm5, imm_signext=False, imm_shift=0)
         gatherprf_stl2kp_b_1of4(src3=f.Pg, src1=s0, imm=f.imm5, imm_signext=False, imm_shift=0)
         gatherprf_stl2nt_b_1of4(src3=f.Pg, src1=s0, imm=f.imm5, imm_signext=False, imm_shift=0)
    '''
    sub = []
    sub.append( 'ld' if prfop_load(prfop) else 'st')
    sub.append( 'l1' if prfop_L1(prfop) else 'l2')
    sub.append( 'nt' if prfop_nontemporal(prfop) else 'kp')
    prefetch_code = "".join(sub)
    new_name = re.sub(r'XX', prefetch_code, uop_template)
    uop_func = globals()[new_name]
    uop_func(**kwargs)


class ld1b_z_p_ai_s(_JSON_ld1b_z_p_ai_s):

    mem_tag_checked = 'always'
    pmu_events = ['LD_SPEC', 'SVE_LDST_NONCONTIG_SPEC', 'SVE_LDST_SPEC', 'SVE_LD_GATHER_SPEC', 'SVE_UOP_SPEC', 'SVE_INST_SPEC', 'SIMD_INST_SPEC']

    def decode(self, f):
        gmovlpair_d_lv(dest=s0, dest2=s1, src1=f.Zn) # zero extends data by default
        # yaml sets IDR offset_* parameters for imm5
        gather_b_1of4(dest=T0, src3=f.Pg, src1=s0, imm=f.imm5, imm_signext=False, imm_shift=0)
        gather_b_2of4(dest=T0, src3=f.Pg, src1=s1, imm=f.imm5, imm_signext=False, imm_shift=0)

        gmovhpair_d_lv(dest=s0, dest2=s1, src1=f.Zn)
        gather_b_3of4(dest=T0, src3=f.Pg, src1=s0, imm=f.imm5, imm_signext=False, imm_shift=0)
        gather_b_4of4(dest=T0, src3=f.Pg, src1=s1, imm=f.imm5, imm_signext=False, imm_shift=0)
        movprfx_d_uv(dest=f.Zt, src2=T0)



class ld1b_z_p_bz_d_x32_unscaled(_JSON_ld1b_z_p_bz_d_x32_unscaled):

    mem_tag_checked = 'always'
    pmu_events = ['LD_SPEC', 'SVE_LDST_NONCONTIG_SPEC', 'SVE_LDST_SPEC', 'SVE_LD_GATHER_SPEC', 'SVE_UOP_SPEC', 'SVE_INST_SPEC', 'SIMD_INST_SPEC']

    def decode(self, f):
        gmovpair_d_lv(dest=s0, dest2=s1, src1=f.Zm)
        if f.xs.value == 0:  # xs==0 -> unsigned
            gather_b_1of2(dest=T0, src3=f.Pg, src1=f.Rn, src2=s0, src1_is_stack_pointer=True, imm=(UOFF32,NOSHIFT))
            gather_b_2of2(dest=T0, src3=f.Pg, src1=f.Rn, src2=s1, src1_is_stack_pointer=True, imm=(UOFF32,NOSHIFT))
        else:
            gather_b_1of2(dest=T0, src3=f.Pg, src1=f.Rn, src2=s0, src1_is_stack_pointer=True, imm=(SOFF32,NOSHIFT))
            gather_b_2of2(dest=T0, src3=f.Pg, src1=f.Rn, src2=s1, src1_is_stack_pointer=True, imm=(SOFF32,NOSHIFT))
        movprfx_d_uv(dest=f.Zt, src2=T0)


class ld1b_z_p_bz_s_x32_unscaled(_JSON_ld1b_z_p_bz_s_x32_unscaled):

    mem_tag_checked = 'always'
    pmu_events = ['LD_SPEC', 'SVE_LDST_NONCONTIG_SPEC', 'SVE_LDST_SPEC', 'SVE_LD_GATHER_SPEC', 'SVE_UOP_SPEC', 'SVE_INST_SPEC', 'SIMD_INST_SPEC']

    def decode(self, f):
        gmovlpair_d_lv(dest=s0, dest2=s1, src1=f.Zm)
        if f.xs.value == 0:  # xs==0 -> unsigned
            gather_b_1of4(dest=T0, src3=f.Pg, src1=f.Rn, src2=s0, src1_is_stack_pointer=True, imm=(UOFF32,NOSHIFT))
            gather_b_2of4(dest=T0, src3=f.Pg, src1=f.Rn, src2=s1, src1_is_stack_pointer=True, imm=(UOFF32,NOSHIFT))
        else:
            gather_b_1of4(dest=T0, src3=f.Pg, src1=f.Rn, src2=s0, src1_is_stack_pointer=True, imm=(SOFF32,NOSHIFT))
            gather_b_2of4(dest=T0, src3=f.Pg, src1=f.Rn, src2=s1, src1_is_stack_pointer=True, imm=(SOFF32,NOSHIFT))

        gmovhpair_d_lv(dest=s0, dest2=s1, src1=f.Zm)
        if f.xs.value == 0:  # xs==0 -> unsigned
            gather_b_3of4(dest=T0, src3=f.Pg, src1=f.Rn, src2=s0, src1_is_stack_pointer=True, imm=(UOFF32,NOSHIFT))
            gather_b_4of4(dest=T0, src3=f.Pg, src1=f.Rn, src2=s1, src1_is_stack_pointer=True, imm=(UOFF32,NOSHIFT))
        else:
            gather_b_3of4(dest=T0, src3=f.Pg, src1=f.Rn, src2=s0, src1_is_stack_pointer=True, imm=(SOFF32,NOSHIFT))
            gather_b_4of4(dest=T0, src3=f.Pg, src1=f.Rn, src2=s1, src1_is_stack_pointer=True, imm=(SOFF32,NOSHIFT))
        movprfx_d_uv(dest=f.Zt, src2=T0)




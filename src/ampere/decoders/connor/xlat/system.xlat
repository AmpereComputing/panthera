class MRS_RS_systemmove(_JSON_MRS_RS_systemmove):

    isolate = True
    no_cleave = True

    #           op0  op1  CRn CRm  op2
    # NCZV        1  011 0100 0010 000
    # DAIF        1  011 0100 0010 001
    # SpSel       1  000 0100 0010 000
    # SP_EL0      1  000 0100 0001 000
    # SP_EL1      1  100 0100 0001 000
    # SP_EL2      1  110 0100 0001 000
    # FPSR        1  011 0100 0100 001
    # RNDR        1  011 0010 0100 000

    # RNDRRS      1  011 0010 0100 001
    # RGSR        1  000 0001 0000 101
    # TPIDR_EL0   1  011 1101 0000 010
    # TPIDR_EL1   1  000 1101 0000 100
    # TPIDR_EL2   1  100 1101 0000 010
    # TTBR1_EL1   1  000 0010 0000 001
    # TTBR1_EL2   1  100 0010 0000 001
    # FPCR        1  011 0100 0100 000
    # CPACR_EL1   1  000 0001 0000 010
    # CPTR_EL2    1  100 0001 0001 010
    # TPIDRRO_EL0 1  011 1101 0000 011

    #                                                                address              o0 op1 CRn  CRm  op2
    #localparam logic [15:0] RNDR_SPR_ADDR               = 16'hd920; 1101_1001_0010_0000 1 1 011 0010 0100 000
    #localparam logic [15:0] RNDRRS_SPR_ADDR             = 16'hd921; 1101_1001_0010_0001 1 1 011 0010 0100 001

    def decode(self, f):
        if   f.o0.value == 0b1 and f.op1.value == 0b011 and f.CRn.value == 0b0100 and f.CRm.value == 0b0010 and f.op2.value == 0b000:
            # NZCV
            rmig(dest=f.Rt, src1=ZR, src3=f0)
        elif f.o0.value == 0b1 and f.op1.value == 0b011 and f.CRn.value == 0b0100 and f.CRm.value == 0b0010 and f.op2.value == 0b001:
            # DAIF - intercept this MRS and read out of the IDR speculative copy instead and put that on the immediate bus
            movz64_0b(dest=f.Rt, daif_read=True)
        elif f.o0.value == 0b1 and f.op1.value == 0b000 and f.CRn.value == 0b0100 and f.CRm.value == 0b0010 and f.op2.value == 0b000:
            # SpSel - intercept this MRS and read out of the IDR speculative copy instead and put that on the immediate bus
            movz64_0b(dest=f.Rt, spsel_read=True)
        elif f.o0.value == 0b1 and f.op1.value == 0b000 and f.CRn.value == 0b0100 and f.CRm.value == 0b0001 and f.op2.value == 0b000:
            # SP is renamed, so turn MRS into an OR instruction where we OR the SP with the ZR and store to dest
            self.isolate = False
            orr64(dest=f.Rt, src1=SP_EL0, src2=ZR, imm=Signal("000"), src1_is_stack_pointer=True, no_sp_add=True)
        elif f.o0.value == 0b1 and f.op1.value == 0b100 and f.CRn.value == 0b0100 and f.CRm.value == 0b0001 and f.op2.value == 0b000:
            # SP is renamed, so turn MRS into an OR instruction where we OR the SP with the ZR and store to dest
            orr64(dest=f.Rt, src1=SP_EL1, src2=ZR, imm=Signal("000"), src1_is_stack_pointer=True, no_sp_add=True)
        elif f.o0.value == 0b1 and f.op1.value == 0b110 and f.CRn.value == 0b0100 and f.CRm.value == 0b0001 and f.op2.value == 0b000:
            # SP is renamed, so turn MRS into an OR instruction where we OR the SP with the ZR and store to dest
            orr64(dest=f.Rt, src1=SP_EL2, src2=ZR, imm=Signal("000"), src1_is_stack_pointer=True, no_sp_add=True)
        elif f.o0.value == 0b1 and f.op1.value == 0b011 and f.CRn.value == 0b0100 and f.CRm.value == 0b0100 and f.op2.value == 0b001:
            # FPSR
            mfspr(dest=f.Rt, imm=(Signal("1"),f.o0,f.op1,f.CRn,f.CRm,f.op2), pre_drain=True)
        elif f.o0.value == 0b1 and f.op1.value == 0b011 and f.CRn.value == 0b0010 and f.CRm.value == 0b0100 and f.op2.value == 0b000:
            # RNDR - random number is very special case, MRS turns into a special uop to lsu to do a special load of a
            #        special address which is intercepted by the SoC and turned into a read of a random number from the
            #        RNG IP.  This load pair then writes two registers and IXU tests bit in the second one to set PSTATE.Z
            #        which indicates whether or not the generation of a random number was successful or not
            ldp_d_64_rndr(dest=f.Rt, dest2=s0, src1=ZR, src2=ZR, imm=Signal('0'), for_morse='RNDR')
            tzs(src1=s0, flagdest=f0)
        elif f.o0.value == 0b1 and f.op1.value == 0b011 and f.CRn.value == 0b0010 and f.CRm.value == 0b0100 and f.op2.value == 0b001:
            # RNDRRS
            ldp_d_64_rndrrs(dest=f.Rt, dest2=s0, src1=ZR, src2=ZR, imm=Signal('0'), for_morse='RNDRRS')
            tzs(src1=s0, flagdest=f0)
        elif f.o0.value == 0b1 and f.op1.value == 0b000 and f.CRn.value == 0b0001 and f.CRm.value == 0b0000 and f.op2.value == 0b101:
            # RGSR is renamed, so turn MRS into an OR instruction where we OR the register with the ZR and store to RGSR
            orr64(dest=f.Rt, src1=RGSR_EL1, src2=ZR, imm=Signal("000"))
        elif f.o0.value == 0b1 and f.op1.value == 0b011 and f.CRn.value == 0b1101 and f.CRm.value == 0b0000 and f.op2.value == 0b010:
            # TPIDR_EL0
            mfspr_fast(dest=f.Rt, imm=(Signal("1"),f.o0,f.op1,f.CRn,f.CRm,f.op2))
        elif f.o0.value == 0b1 and f.op1.value == 0b000 and f.CRn.value == 0b1101 and f.CRm.value == 0b0000 and f.op2.value == 0b100:
            # TPIDR_EL1
            mfspr_fast(dest=f.Rt, imm=(Signal("1"),f.o0,f.op1,f.CRn,f.CRm,f.op2))
        elif f.o0.value == 0b1 and f.op1.value == 0b100 and f.CRn.value == 0b1101 and f.CRm.value == 0b0000 and f.op2.value == 0b010:
            # TPIDR_EL2
            mfspr_fast(dest=f.Rt, imm=(Signal("1"),f.o0,f.op1,f.CRn,f.CRm,f.op2))
        elif  f.o0.value == 0b1 and f.op1.value == 0b000 and f.CRn.value == 0b0010 and f.CRm.value == 0b0000 and f.op2.value == 0b001:
            # TTBR1_EL1
            mfspr_fast(dest=f.Rt, imm=(Signal("1"),f.o0,f.op1,f.CRn,f.CRm,f.op2))
        elif  f.o0.value == 0b1 and f.op1.value == 0b100 and f.CRn.value == 0b0010 and f.CRm.value == 0b0000 and f.op2.value == 0b001:
            # TTBR1_EL2
            mfspr_fast(dest=f.Rt, imm=(Signal("1"),f.o0,f.op1,f.CRn,f.CRm,f.op2))
        elif  f.o0.value == 0b1 and f.op1.value == 0b011 and f.CRn.value == 0b0100 and f.CRm.value == 0b0100 and f.op2.value == 0b000:
            # FPCR
            mfspr_fast(dest=f.Rt, imm=(Signal("1"),f.o0,f.op1,f.CRn,f.CRm,f.op2))
        elif  f.o0.value == 0b1 and f.op1.value == 0b000 and f.CRn.value == 0b0001 and f.CRm.value == 0b0000 and f.op2.value == 0b010:
            # CPACR_EL1
            mfspr_fast(dest=f.Rt, imm=(Signal("1"),f.o0,f.op1,f.CRn,f.CRm,f.op2))
        elif  f.o0.value == 0b1 and f.op1.value == 0b100 and f.CRn.value == 0b0001 and f.CRm.value == 0b0001 and f.op2.value == 0b010:
            # CPTR_EL2
            mfspr_fast(dest=f.Rt, imm=(Signal("1"),f.o0,f.op1,f.CRn,f.CRm,f.op2))
        elif  f.o0.value == 0b1 and f.op1.value == 0b011 and f.CRn.value == 0b1101 and f.CRm.value == 0b0000 and f.op2.value == 0b011:
            # TPIDRRO_EL0
            mfspr_fast(dest=f.Rt, imm=(Signal("1"),f.o0,f.op1,f.CRn,f.CRm,f.op2))
        else:
            mfspr(dest=f.Rt, imm=(Signal("1"),f.o0,f.op1,f.CRn,f.CRm,f.op2))


class MSR_SI_pstate(_JSON_MSR_SI_pstate):

    isolate = True

    # <pstatefield> op0 op1  CRn  CRm op2
    # CFINV         00  000 0100 DAIF 000
    # XAFLAG        00  000 0100 DAIF 001
    # AXFLAG        00  000 0100 DAIF 010
    # UA0           00  000 0100 DAIF 011 == op<0>
    # PAN           00  000 0100 DAIF 100 == op<0>
    # SPSel         00  000 0100 DAIF 101
    # DIT           00  011 0100 DAIF 010 == op<0>
    # DAIFSet       00  011 0100 DAIF 110
    # DAIFClr       00  011 0100 DAIF 111

    def decode(self, f):
        # For mtspr uops, the IXU will notice the lack of a src valid and know that it is the immediate version from that
        if   f.op1.value == 0b011 and f.op2.value == 0b110:
            # IDR will intercept and execute this instruction
            daif_set(imm=f.CRm)
        elif f.op1.value == 0b011 and f.op2.value == 0b111:
            # IDR will intercept and execute this instruction
            daif_clr(imm=f.CRm)
        elif f.op1.value == 0b000 and f.op2.value == 0b101:
            # IDR will intercept and execute this instruction
            spsel(imm=f.CRm)
        elif f.op1.value == 0b000 and f.op2.value == 0b000:
            cfinv(flagdest=f0, src3=f0)
        elif f.op1.value == 0b000 and f.op2.value == 0b001:
            xaflag(flagdest=f0, src3=f0)
        elif f.op1.value == 0b000 and f.op2.value == 0b010:
            axflag(flagdest=f0, src3=f0)
        elif f.op1.value == 0b000 and f.op2.value == 0b100:
            # PAN needs to be shifted to bit 22 of the register
            mtspr(imm=(Signal("000"), f.op1, Signal("0100"), f.CRm, f.op2))
        elif f.op1.value == 0b000 and f.op2.value == 0b011:
            # UAO needs to be shifted to bit 23 of the register
            mtspr(imm=(Signal("000"), f.op1, Signal("0100"), f.CRm, f.op2))
        elif f.op1.value == 0b011 and f.op2.value == 0b010:
            # DIT needs to be shifted to bit 24 of the register
            mtspr(imm=(Signal("000"), f.op1, Signal("0100"), f.CRm, f.op2))
        elif f.op1.value == 0b011 and f.op2.value == 0b100:
            # TCO needs to be shifted to bit 25 of the register
            mtspr(imm=(Signal("000"), f.op1, Signal("0100"), f.CRm, f.op2))
        elif f.op1.value == 0b011 and f.op2.value == 0b001:
            # SSBS needs to be shifted to bit 12 of the register
            mtspr(imm=(Signal("000"), f.op1, Signal("0100"), f.CRm, f.op2))
        # We should not need this not_implemented because all other accesses should be handled by fault logic
        # else:
        #     pass # not_implemented


class MSR_SR_systemmove(_JSON_MSR_SR_systemmove):

    isolate = True
    no_cleave = True

    #<systemreg> op0 op1 CRn  CRm  op2
    # NZCV       11  011 0100 0010 000
    # DAIF       11  011 0100 0010 001
    # SPSel      11  000 0100 0010 000
    # SP_EL0     11  000 0100 0001 000
    # SP_EL1     11  100 0100 0001 000
    # SP_EL2     11  110 0100 0001 000
    # RGSR_EL1   11  000 0001 0000 101
    
    def decode(self, f):
        if   f.o0.value == 0b1 and f.op1.value == 0b011 and f.CRn.value == 0b0100 and f.CRm.value == 0b0010 and f.op2.value == 0b000:
            # NZCV - the bits need to be shifted from bits 31:28 of a GPR into the flag register
            rmif(flagdest=f0, src2=f.Rt, imm=Signal('0111001111'), no_swob=True)
        elif f.o0.value == 0b1 and f.op1.value == 0b011 and f.CRn.value == 0b0100 and f.CRm.value == 0b0010 and f.op2.value == 0b001 and f.Rt.value == 0b11111:
            # IDR will intercept and execute this instruction. If we are writing ZR to the DAIF, that is the same as daif_clr of all bits
            daif_clr(imm=Signal("1111"), no_swob=True)
        elif f.o0.value == 0b1 and f.op1.value == 0b000 and f.CRn.value == 0b0100 and f.CRm.value == 0b0001 and f.op2.value == 0b000:
            # SP is renamed, so turn MSR into an OR instruction where we OR the register with the ZR and store to SP
            # for performance reasons, we don't want this to be isolated (bug=99361) and there are no trapping/faulting requirements to
            # require this to be on lane0 (faulting of SP_EL0 is especially simple)
            self.isolate = False
            orr64(dest=SP_EL0, src1=ZR, src2=f.Rt, imm=Signal("000"), dest_is_stack_pointer=True, no_sp_add=True, no_swob=True)
        elif f.o0.value == 0b1 and f.op1.value == 0b100 and f.CRn.value == 0b0100 and f.CRm.value == 0b0001 and f.op2.value == 0b000:
            # SP is renamed, so turn MSR into an OR instruction where we OR the register with the ZR and store to SP
            orr64(dest=SP_EL1, src1=ZR, src2=f.Rt, imm=Signal("000"), dest_is_stack_pointer=True, no_sp_add=True, no_swob=True)
        elif f.o0.value == 0b1 and f.op1.value == 0b110 and f.CRn.value == 0b0100 and f.CRm.value == 0b0001 and f.op2.value == 0b000:
            # SP is renamed, so turn MSR into an OR instruction where we OR the register with the ZR and store to SP
            orr64(dest=SP_EL2, src1=ZR, src2=f.Rt, imm=Signal("000"), dest_is_stack_pointer=True, no_sp_add=True, no_swob=True)
        elif f.o0.value == 0b1 and f.op1.value == 0b000 and f.CRn.value == 0b0001 and f.CRm.value == 0b0000 and f.op2.value == 0b101:
            # RGSR is renamed, so turn MSR into an OR instruction where we OR the register with the ZR and store to RGSR
            orr64(dest=RGSR_EL1, src1=ZR, src2=f.Rt, imm=Signal("000"), no_swob=True)  
        else:
            mtspr(src2=f.Rt, imm=(Signal("1"),f.o0,f.op1,f.CRn,f.CRm,f.op2))


class PSB_HC_hints(_JSON_PSB_HC_hints):

    isolate = True

    def decode(self, f):
        psb()


class PSSBB_only_barriers(Translation):
    pattern = '1101010100 0 00  011 0011 0100 1 00  11111'
    pfields = '           L op0 op1 CRn  CRm    opc  Rt  '

    asmtemplate = 'PSSBB'

    isolate = True

    # This is intended to always be a NOP because LSU always operates in
    # 'safe mode', but it needs to function as a YIELD instruction.
    def decode(self, f):
        nop(pre_drain=True)



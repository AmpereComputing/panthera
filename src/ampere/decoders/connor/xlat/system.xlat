from ampere.xlat import Signal, Translation
from proj.uop import *
from proj.xlat_register_constants import * # x30/ZR/xzr/SP_EL*/s0/s1/T0/T1/T2/T3/RGSR_EL1/IMP_BPU_CLEAR_EL3/IMP_PREFETCH_CLEAR_EL3/IMP_SFP_CLEAR_EL3/IMP_BRBE_IALL_EL3/IMP_BRBE_INJ_EL3/IMP_L2C_LOCAL_TIMEOUT_EL3


class HINT_ALL(Translation):
                                                         #yield   #wfe     #wfi     #sev     #sevl    #esb     #psb     #tsb
    pattern = '1101010100 0 00  011 0010 ((((((((-------!0000001)!0000010)!0000011)!0000100)!0000101)!0010000)!0010001)!0010010) 11111'
    pfields = '           L op0 op1 CRn     CRmop2                                                                               Rt   '

    asmtemplate = 'HINT'
    mode_bits = { 'pac_ia_enabled' : 1, 'pac_ib_enabled' : 1 }

    def decode(self, f):
        if   f.CRmop2.value == 0b0001100:
            if self.mode_bits['pac_ia_enabled']:
                autia(dest=Signal("10001"), src1=Signal("10001"), src2=Signal("10000"))
            else:
                nop()
        elif f.CRmop2.value == 0b0011101:
            if self.mode_bits['pac_ia_enabled']:
                autia(dest=Signal("11110"), src1=Signal("11110"), src2=Signal("11111"), src2_is_stack_pointer=True)
            else:
                nop()
        elif f.CRmop2.value == 0b0011100:
            if self.mode_bits['pac_ia_enabled']:
                autia(dest=Signal("11110"), src1=Signal("11110"), src2=Signal("11111"))
            else:
                nop()
        elif f.CRmop2.value == 0b0001110:
            if self.mode_bits['pac_ib_enabled']:
                autib(dest=Signal("10001"), src1=Signal("10001"), src2=Signal("10000"))
            else:
                nop()
        elif f.CRmop2.value == 0b0011111:
            if self.mode_bits['pac_ib_enabled']:
                autib(dest=Signal("11110"), src1=Signal("11110"), src2=Signal("11111"), src2_is_stack_pointer=True)
            else:
                nop()
        elif f.CRmop2.value == 0b0011110:
            if self.mode_bits['pac_ib_enabled']:
                autib(dest=Signal("11110"), src1=Signal("11110"), src2=Signal("11111"))
            else:
                nop()
        elif f.CRmop2.value == 0b0001000:
            if self.mode_bits['pac_ia_enabled']:
                pacia(dest=Signal("10001"), src1=Signal("10001"), src2=Signal("10000"))
            else:
                nop()
        elif f.CRmop2.value == 0b0011001:
            if self.mode_bits['pac_ia_enabled']:
                pacia(dest=Signal("11110"), src1=Signal("11110"), src2=Signal("11111"), src2_is_stack_pointer=True, pacixsp=True)
            else:
                nop(pacixsp=True)
        elif f.CRmop2.value == 0b0011000:
            if self.mode_bits['pac_ia_enabled']:
                pacia(dest=Signal("11110"), src1=Signal("11110"), src2=Signal("11111"))
            else:
                nop()
        elif f.CRmop2.value == 0b0001010:
            if self.mode_bits['pac_ib_enabled']:
                pacib(dest=Signal("10001"), src1=Signal("10001"), src2=Signal("10000"))
            else:
                nop()
        elif f.CRmop2.value == 0b0011011:
            if self.mode_bits['pac_ib_enabled']:
                pacib(dest=Signal("11110"), src1=Signal("11110"), src2=Signal("11111"), src2_is_stack_pointer=True, pacixsp=True)
            else:
                nop(pacixsp=True)
        elif f.CRmop2.value == 0b0011010:
            if self.mode_bits['pac_ib_enabled']:
                pacib(dest=Signal("11110"), src1=Signal("11110"), src2=Signal("11111"))
            else:
                nop()
        elif f.CRmop2.value == 0b0000111:
            xpaci(dest=Signal("11110"), src1=Signal("11110"))
        elif f.CRmop2.value == 0b0010100:
            nop()
        # elif f.CRmop2.value == 0b0010000:
        #     """ESB_HI_hints - Error Synchronization Barrier"""
        #     # ESB will behave as a NOP in our implementation
        #     esb()
        #     nop()
        #     nop()
        #     nop()
        elif f.CRmop2.value == 0b0000000:
            nop()
        # elif f.CRmop2.value == 0b0010001:
        #     """PSB_HC_hints - Profiling Synchronization Barrier"""
        #     psb()
        # elif f.CRmop2.value == 0b0000100:
        #     """SEV_HI_hints - Send Event"""
        #     sev()
        # elif f.CRmop2.value == 0b0000101:
        #     """SEVL_HI_hints - Send Event Local"""
        #     sevl()
        # elif f.CRmop2.value == 0b0010010:
        #     """TSB_HC_hints - Trace Synchronization Barrier"""
        #     tsb()
        elif f.CRmop2.value == 0b0100000 or f.CRmop2.value == 0b0100010 or f.CRmop2.value == 0b0100100 or f.CRmop2.value == 0b0100110:
            # The CRmop2 was combined to allow the ! syntax, which means I have to write out all four values of f.CRmop2 that can be a BTI
            bti()
        else:
            # These ones need to trap based on the control bit in imp def registers
            nop(unallocated_hint=True)



class WFET_only_systeminstrswithreg(_JSON_WFET_only_systeminstrswithreg):

    isolate = True

    def decode(self, f):
        mtspr_noswob(src2=f.Rd, imm=IMP_L2C_LOCAL_TIMEOUT_EL3, for_morse='WFET')
        wfet()

class WFIT_only_systeminstrswithreg(_JSON_WFIT_only_systeminstrswithreg):

    isolate = True

    def decode(self, f):
        mtspr_noswob(src2=f.Rd, imm=IMP_L2C_LOCAL_TIMEOUT_EL3, for_morse='WFIT')
        wfit()
            

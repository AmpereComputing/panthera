    def decode(self, f):
        sevl()


class SB_only_barriers(_JSON_SB_only_barriers):

    isolate = True
    
    def decode(self, f):
        nop(pre_drain=True)


class SMC_EX_exception(_JSON_SMC_EX_exception):

    isolate = True

    def decode(self, f):
        smc(imm=f.imm16)


class SSBB_only_barriers(Translation):
    pattern = '1101010100 0 00  011 0011 0000 1 00  11111'
    pfields = '           L op0 op1 CRn  CRm    opc  Rt  '

    asmtemplate = 'SSBB'

    isolate = True

    # This is intended to always be a NOP because LSU always operates in
    # 'safe mode', but it needs to function as a YIELD instruction.
    def decode(self, f):
        nop(pre_drain=True)


class SVC_EX_exception(_JSON_SVC_EX_exception):

    isolate = True

    def decode(self, f):
        svc(imm=f.imm16)

# The SYS decode is overly complicated because the encoding space itself is fairly complicated and
# we have to isolate some of the SYS instructions but not others.  For performance reasons, we want
# to allow DC ZVA to execute without being isolated (bug=80810 for more details), but any of the
# SYS instructions that decode to MSRs must be isolated because IDR only has SWOB on lane0 etc.
# To accomplish this, we have broken up the SYS instruction into several classes which attempt
# to pick off certain portions of the SYS encoding space.  To understand the SYS encoding space
# and what is happening here, the best thing to do is to look at the SYS instruction in the ARM-ARM
# and there is a table at the top that defines the "Alias conditions" for SYS instructions. That
# table lists certain CRn/CRm combinations that group things, as well as the SysOp() function in
# ARM-ARM which further breaks down some of the ones that overlap.  Studying those is what allows
# us to have confidence that the unused encoding space in each SYS_* class below is actually
# unused and is not part of one of the other SYS_* classes.  For example, the table shows that
# CPF/CPP/DVP all have CRn==0111 && CRm==0011. While AT/DC/IC all have CRn=0111 we can see that
# none of these will overlap because AT always has CRm=100x, and the SysOp() table shows that DC
# and IC never have any encoding with CRm=0011. Yes, this is all a pain in the neck.
class SYS_TLBI(Translation):
    pattern = '1101010100 0 01  --- 100- ---- --- -----'
    pfields = '           L op0 op1 CRn  CRm  op2  Rt  '

    # The regular TBLI instructions all have CRn=1000
    # The nXS version of each of these TLBI instructions is encoded with CRn=1001
    
    asmtemplate = 'SYS'

    isolate = True

    def decode(self, f):
        # TLBI
        sys_tlbi(src1=f.Rt, imm=(f.op1,f.CRm,f.op2), for_morse='TLBI')

class SYS_NOT_TLBI_Predictions(Translation):
    pattern = '1101010100 0 01  --- 0111 0011 --- -----'
    pfields = '           L op0 op1 CRn  CRm  op2  Rt  '

    asmtemplate = 'SYS'

    isolate = True

    def decode(self, f):
        if   f.op1.value == 0b011 and f.op2.value == 0b100:
            # CFP
            mtspr(src2=ZR, imm=IMP_BPU_CLEAR_EL3, for_morse='CFP')
        elif f.op1.value == 0b011 and f.op2.value == 0b101:
            # DVP
            mtspr(src2=ZR, imm=IMP_SFP_CLEAR_EL3, for_morse='DVP')
        elif f.op1.value == 0b011 and f.op2.value == 0b111:
            # CPP
            mtspr(src2=ZR, imm=IMP_PREFETCH_CLEAR_EL3, for_morse='CPP')


class SYS_BRBE(Translation):
    pattern = '1101010100 0 01  --- 0111 0010 --- -----'
    pfields = '           L op0 op1 CRn  CRm  op2  Rt  '

    asmtemplate = 'SYS'

    # Rt should be 11111, but it is implementation defined what to do if it is not.
    # The choices are to become UNDEFINED or to behave as if it were 11111. The
    # dashes here mean that we chose the later, we behave as if it were 11111
    # even if it is not.
    
    isolate = True

    def decode(self, f):
        if   f.op1.value == 0b001 and f.op2.value == 0b100:
            # IALL
            mtspr(src2=ZR, imm=IMP_BRBE_IALL_EL3, for_morse='BRBE_IALL')
        elif f.op1.value == 0b001 and f.op2.value == 0b101:
            # INJ
            mtspr(src2=ZR, imm=IMP_BRBE_INJ_EL3, for_morse='BRBE_INJ')

        
class SYS_NOT_TLBI_NOT_Predictions(Translation):
    pattern = '1101010100 0 01  --- 0111 ((----!0011)!0010) --- -----'
    pfields = '           L op0 op1 CRn    CRm              op2  Rt  '

    asmtemplate = 'SYS'

    # Omitting SYS* instructions from cleaving. This is the only non-isolate.
    cleavlet0_only = True

    def decode(self, f):
        if (f.CRm.value & 0b1110) == 0b1000:
            # AT
            sys_at(src1=f.Rt, imm=(f.op1,f.CRm,f.op2), for_morse='AT')
        #elif f.CRn.value == 0b0111 and (f.CRm.value == 0b0001 or f.CRm.value == 0b0101 or f.CRm.value == 0b1011):             
            # IC (nop because we have a coherent icache)
            # DCCVAU (CRm = 0b1011) (nop because we don't do unification)
            # jperry - these are no longer NOPs because some of them need address translation. all VA flavors should
            #          decode into sys_dc_va and the LSU will basically prevent them from doing anything in L1 or L2
            #nop()
        elif f.op1.value == 0b000 and f.op2.value == 0b000:
            # ICALLU*
            # this is REALLY a nop because it doesn't get an address translation
            # (we could maybe alias this onto dc_sw?)
            nop()
        elif f.op1.value == 0b000 and (f.op2.value & 0b001) == 0b000:
            # DC (intentionally after IC/TLBI because they all share the same CRn value)
            # added explicit uops for several flavors of these to differentiate the ones that need address
            # translation and MemTag checking
            # note: i'm passing op on the immediate for all these flavors even though it's not strictly necessary
            #       could remove if it helped decode. guessing it's better this way
            sys_dc_sw(src1=f.Rt, imm=(f.op1,f.CRm,f.op2), for_morse='DCSW')
        elif f.op1.value == 0b000:
            # DC I*VA* must be separate uop because permission checks are different
            sys_dc_iva(src1=f.Rt, imm=(f.op1,f.CRm,f.op2), for_morse='DCIVA')
        elif f.op1.value == 0b011 and f.CRm.value == 0b0100:
            if f.op2.value == 0b001:
                sys_dc_zva(src1=f.Rt, imm=(f.op1,f.CRm,f.op2), spe_store=True, for_morse='DCZVA')
            else:
                sys_dc_gzva(src1=f.Rt, imm=(f.op1,f.CRm,f.op2), spe_store=True, for_morse='DCGZVA')
        else:
            sys_dc_va(src1=f.Rt, imm=(f.op1,f.CRm,f.op2), spe_store=True, for_morse='DCVA')


class SYSL_RC_systeminstrs(_JSON_SYSL_RC_systeminstrs):

    isolate = True

    def decode(self, f):
        # This class is confusing. The pseudocode has no information on system instructions (just a function stub).
        # From reading through the spec, I think this class would only be used if we created implementation defined
        # functions that had a return value. All the built-in system instructions fall under the class where L=0,
        # which means they have no return values.
        nop()



class DMB_BO_barriers(_JSON_DMB_BO_barriers):

    def decode(self, f):
        # note: there are a whole bunch of other options here that
        #       we're ignoring. Example: we only have one shareability
        #       domain so outer/inner/full/non-shareable is meaningless
        if (f.CRm.value & 0b0011) == 0b0001:
            # DMB LD
            nop(for_morse='LD')
        elif (f.CRm.value & 0b0011) == 0b0010:
            # DMB ST
            dmb_st(imm=Signal('0'), for_morse='ST')
        else:
            dmb_all(imm=Signal('0'), for_morse='ALL')

class DSB_BO_barriers(_JSON_DSB_BO_barriers):
    # Keep Ampere's SSBB/PSSBB priority over the general DSB decoder.
    pattern = _JSON_DSB_BO_barriers.pattern.replace('----', '(---- ! 0-00)', 1)
    pfields = None
    fields = dict(_JSON_DSB_BO_barriers._unified_fields)


    isolate = True

    def decode(self, f):
        dsb(post_drain=True, imm=Signal('0'))


class BFMLAL_asimdelem_F(_JSON_BFMLAL_asimdelem_F):

    pmu_events = ['ASE_FP_SPEC', 'ASE_INST_SPEC', 'ASE_SPEC', 'PEM_ASE_SVE_FP_FMA_MUL_SPEC', 'ASE_SVE_FP_FMA_SPEC', 'ASE_UOP_SPEC', 'ASE_VECTOR_SPEC', 'FP_SPEC', 'SIMD_INST_SPEC']

    def decode(self, f):
        #Dont_touch
        if f.Q.value == 0b0:
            if f.M.value == 0b0:
                bfmlalb_idx0_h_lv(dest=f.Rd, src1=f.Rn, src2=f.Rm, src3=f.Rd, idx=(Signal('0010'),f.H,f.L))
            elif f.M.value == 0b1:
                bfmlalb_idx1_h_lv(dest=f.Rd, src1=f.Rn, src2=f.Rm, src3=f.Rd, idx=(Signal('0010'),f.H,f.L))
        elif f.Q.value == 0b1:
            if f.M.value == 0b0:
                bfmlalt_idx0_h_lv(dest=f.Rd, src1=f.Rn, src2=f.Rm, src3=f.Rd, idx=(Signal('0010'),f.H,f.L))
            elif f.M.value == 0b1:
                bfmlalt_idx1_h_lv(dest=f.Rd, src1=f.Rn, src2=f.Rm, src3=f.Rd, idx=(Signal('0010'),f.H,f.L))



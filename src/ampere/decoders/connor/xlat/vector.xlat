                uadd2p_h_sv(dest=T0, src1=T0, src2=T0, idx=Signal('000001'))
                uadd1p_h_sv(dest=f.Rd, src1=T0, src2=T0, idx=Signal('000001'))
        elif f.Q.value == 0b0:
            if   f.size.value == 0b01:
                uaddlp_h_sv(dest=T0, src1=f.Rn, src2=f.Rn)
                uadd1p_s_sv(dest=f.Rd, src1=T0, src2=T0, idx=Signal('000001'))
            elif f.size.value == 0b00:
                uaddlp_b_sv(dest=T0, src1=f.Rn, src2=f.Rn)
                uadd2p_h_sv(dest=T0, src1=T0, src2=T0, idx=Signal('000001'))

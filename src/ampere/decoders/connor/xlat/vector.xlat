class BFDOT_asimdelem_E(_JSON_BFDOT_asimdelem_E):

    pmu_events = ['ASE_FP_SPEC', 'ASE_INST_SPEC', 'ASE_SPEC', 'PEM_ASE_SVE_FP_DOT_MMLA_SPEC', 'ASE_UOP_SPEC', 'ASE_VECTOR_SPEC', 'FP_SPEC', 'SIMD_INST_SPEC']

    def decode(self, f):
        # Number of uops 2: bfdot_idx_h_lv, bfdot_idx_h_sv
        if f.Q.value == 0b0:
            bfdot_idx_h_sv(dest=f.Rd, src1=f.Rn, src2=(f.M, f.Rm), src3=f.Rd, idx=(Signal('0010'),f.H,f.L))
        elif f.Q.value == 0b1:
            bfdot_idx_h_lv(dest=f.Rd, src1=f.Rn, src2=(f.M, f.Rm), src3=f.Rd, idx=(Signal('0010'),f.H,f.L))



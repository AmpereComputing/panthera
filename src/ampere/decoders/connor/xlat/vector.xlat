            umov_idx0_b_nv(dest=f.Rd, src2=f.Rn, idx=(Signal('0010'),f.opcBit20,f.opcBit19))
        elif (f.imm5.value & 0b00111 ) ==  0b00010:
            umov_idx0_h_nv(dest=f.Rd, src2=f.Rn, idx=(Signal('0010'),f.opcBit20,f.opcBit19))
        elif (f.imm5.value & 0b00111 ) ==  0b00011:
            umov_idx1_b_nv(dest=f.Rd, src2=f.Rn, idx=(Signal('0010'),f.opcBit20,f.opcBit19))
        elif (f.imm5.value & 0b00111 ) ==  0b00100:
            umov_idx0_s_nv(dest=f.Rd, src2=f.Rn, idx=(Signal('0010'),f.opcBit20,f.opcBit19))
        elif (f.imm5.value & 0b00111 ) ==  0b00101:
            umov_idx2_b_nv(dest=f.Rd, src2=f.Rn, idx=(Signal('0010'),f.opcBit20,f.opcBit19))
        elif (f.imm5.value & 0b00111 ) ==  0b00110:
            umov_idx1_h_nv(dest=f.Rd, src2=f.Rn, idx=(Signal('0010'),f.opcBit20,f.opcBit19))
        elif (f.imm5.value & 0b00111 ) ==  0b00111:
            umov_idx3_b_nv(dest=f.Rd, src2=f.Rn, idx=(Signal('0010'),f.opcBit20,f.opcBit19))
        elif (f.imm5.value & 0b01111 ) ==  0b01000:
            umov_idx0_d_nv(dest=f.Rd, src2=f.Rn, idx=(Signal('0011'),f.opcBit20,Signal('0')))



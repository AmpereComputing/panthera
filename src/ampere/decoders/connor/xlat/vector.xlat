class CLS_asimdmisc_R(_JSON_CLS_asimdmisc_R):

    pmu_events = ['ASE_INST_SPEC', 'ASE_INT_SPEC', 'ASE_SPEC', 'ASE_UOP_SPEC', 'ASE_VECTOR_SPEC', 'INT_SPEC', 'SIMD_INST_SPEC']

    def decode(self, f):
        # Number of uops 6: cls_b_lv, cls_b_sv, cls_h_lv, cls_h_sv, cls_s_lv, cls_s_sv
        if f.Q.value == 0b0:
            if f.size.value == 0b00:
                cls_b_sv(dest=f.Rd, src1=f.Rn)
            elif f.size.value == 0b01:
                cls_h_sv(dest=f.Rd, src1=f.Rn)
            elif f.size.value == 0b10:
                cls_s_sv(dest=f.Rd, src1=f.Rn)
        elif f.Q.value == 0b1:
            if f.size.value == 0b00:
                cls_b_lv(dest=f.Rd, src1=f.Rn)
            elif f.size.value == 0b01:
                cls_h_lv(dest=f.Rd, src1=f.Rn)
            elif f.size.value == 0b10:
                cls_s_lv(dest=f.Rd, src1=f.Rn)


class CLZ_asimdmisc_R(_JSON_CLZ_asimdmisc_R):

    pmu_events = ['ASE_INST_SPEC', 'ASE_INT_SPEC', 'ASE_SPEC', 'ASE_UOP_SPEC', 'ASE_VECTOR_SPEC', 'INT_SPEC', 'SIMD_INST_SPEC']

    def decode(self, f):
        # Number of uops 6: clz_b_lv, clz_b_sv, clz_h_lv, clz_h_sv, clz_s_lv, clz_s_sv

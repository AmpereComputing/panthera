class UMOV_asimdins_W_w(_JSON_UMOV_asimdins_W_w):
    fields = {'opcBit19':[19,19],'opcBit20':[20,20]}


    pmu_events = ['DP_SPEC']

    def decode(self, f):
        #this has a Q, but the uops are not vector - must be a conversion to ixu scalar
        #Dont_touch
        if   f.Q.value == 0b0:
            if f.Rd.value != 0b11111:
                if   (f.imm5.value & 0b00111 ) ==  0b00111:
                    gumov_idx3_b_nv(dest=f.Rd, src2=f.Rn, idx=(Signal('0010'),f.opcBit20,f.opcBit19))
                elif (f.imm5.value & 0b00111 ) ==  0b00110:
                    gumov_idx1_h_nv(dest=f.Rd, src2=f.Rn, idx=(Signal('0010'),f.opcBit20,f.opcBit19))
                elif (f.imm5.value & 0b00111 ) ==  0b00101:
                    gumov_idx2_b_nv(dest=f.Rd, src2=f.Rn, idx=(Signal('0010'),f.opcBit20,f.opcBit19))
                elif (f.imm5.value & 0b00111 ) ==  0b00100:
                    gumov_idx0_s_nv(dest=f.Rd, src2=f.Rn, idx=(Signal('0010'),f.opcBit20,f.opcBit19))
                elif (f.imm5.value & 0b00111 ) ==  0b00011:
                    gumov_idx1_b_nv(dest=f.Rd, src2=f.Rn, idx=(Signal('0010'),f.opcBit20,f.opcBit19))
                elif (f.imm5.value & 0b00111 ) ==  0b00010:
                    gumov_idx0_h_nv(dest=f.Rd, src2=f.Rn, idx=(Signal('0010'),f.opcBit20,f.opcBit19))
                elif (f.imm5.value & 0b00111 ) ==  0b00001:
                    gumov_idx0_b_nv(dest=f.Rd, src2=f.Rn, idx=(Signal('0010'),f.opcBit20,f.opcBit19))
            else:
              nop()



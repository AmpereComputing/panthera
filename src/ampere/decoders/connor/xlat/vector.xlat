    def decode(self, f):
        # Number of uops 3: sqshrun_d_nv, sqshrun_h_nv, sqshrun_s_nv
        if (f.immh.value & 0b1100 ) ==  0b0100:
            sqshrun_d_nv(dest=f.Rd, src1=f.Rn)
        elif (f.immh.value & 0b1110 ) ==  0b0010:
            sqshrun_s_nv(dest=f.Rd, src1=f.Rn)
        elif (f.immh.value & 0b1111 ) ==  0b0001:
            sqshrun_h_nv(dest=f.Rd, src1=f.Rn)


class SQSHRUN_asimdshf_N(_JSON_SQSHRUN_asimdshf_N):

    pmu_events = ['ASE_INST_SPEC', 'ASE_INT_SPEC', 'ASE_SPEC', 'ASE_UOP_SPEC', 'ASE_VECTOR_SPEC', 'INT_SPEC', 'SIMD_INST_SPEC']

    def decode(self, f):
        #Dont_touch_multiuop
        if   f.Q.value == 0b1:
            if   (f.immh.value & 0b1100 ) ==  0b0100:
                sqshrun_d_lv(dest=T0, src1=f.Rn)
                xtn2_s_lv(dest=f.Rd, src2=T0, src3=f.Rd)
            elif (f.immh.value & 0b1110 ) ==  0b0010:
                sqshrun_s_lv(dest=T0, src1=f.Rn)
                xtn2_h_lv(dest=f.Rd, src2=T0, src3=f.Rd)
            elif (f.immh.value & 0b1111 ) ==  0b0001:
                sqshrun_h_lv(dest=T0, src1=f.Rn)
                xtn2_b_lv(dest=f.Rd, src2=T0, src3=f.Rd)
        elif f.Q.value == 0b0:
            if   (f.immh.value & 0b1100 ) ==  0b0100:
                sqshrun_d_lv(dest=T0, src1=f.Rn)
                xtn_s_lv(dest=f.Rd, src2=T0)
            elif (f.immh.value & 0b1110 ) ==  0b0010:
                sqshrun_s_lv(dest=T0, src1=f.Rn)
                xtn_h_lv(dest=f.Rd, src2=T0)
            elif (f.immh.value & 0b1111 ) ==  0b0001:
                sqshrun_h_lv(dest=T0, src1=f.Rn)
                xtn_b_lv(dest=f.Rd, src2=T0)


class SQSUB_asisdsame_only(_JSON_SQSUB_asisdsame_only):

    pmu_events = ['ASE_INT_SPEC', 'ASE_SCALAR_SPEC', 'ASE_SPEC', 'INT_SPEC']

    def decode(self, f):
        # Number of uops 4: sqsub_b_nv, sqsub_d_nv, sqsub_h_nv, sqsub_s_nv
        if f.size.value == 0b00:
            sqsub_b_nv(dest=f.Rd, src1=f.Rm, src2=f.Rn)
        elif f.size.value == 0b01:
            sqsub_h_nv(dest=f.Rd, src1=f.Rm, src2=f.Rn)
        elif f.size.value == 0b10:
            sqsub_s_nv(dest=f.Rd, src1=f.Rm, src2=f.Rn)
        elif f.size.value == 0b11:
            sqsub_d_nv(dest=f.Rd, src1=f.Rm, src2=f.Rn)



from ampere.xlat import Signal, Translation, Fusion
from proj.uop import *
from proj.xlat_register_constants import * # x30/ZR/xzr/SP_EL*/s0/s1/T0/T1/T2/T3/RGSR_EL1

class ABS_asisdmisc_R(_JSON_ABS_asisdmisc_R):

    pmu_events = ['ASE_INT_SPEC', 'ASE_SCALAR_SPEC', 'ASE_SPEC', 'INT_SPEC']

    def decode(self, f):
        # Number of uops 1: abs_d_nv
        if f.size.value == 0b11:
            abs_d_nv(dest=f.Rd, src1=f.Rn)


class ABS_asimdmisc_R(_JSON_ABS_asimdmisc_R):

    pmu_events = ['ASE_INST_SPEC', 'ASE_INT_SPEC', 'ASE_SPEC', 'ASE_UOP_SPEC', 'ASE_VECTOR_SPEC', 'INT_SPEC', 'SIMD_INST_SPEC']

    def decode(self, f):
        # Number of uops 7: abs_b_lv, abs_b_sv, abs_d_lv, abs_h_lv, abs_h_sv, abs_s_lv, abs_s_sv
        if f.Q.value == 0b0:
            if f.size.value == 0b00:
                abs_b_sv(dest=f.Rd, src1=f.Rn)
            elif f.size.value == 0b01:
                abs_h_sv(dest=f.Rd, src1=f.Rn)
            elif f.size.value == 0b10:
                abs_s_sv(dest=f.Rd, src1=f.Rn)
        elif f.Q.value == 0b1:
            if f.size.value == 0b00:
                abs_b_lv(dest=f.Rd, src1=f.Rn)
            elif f.size.value == 0b01:
                abs_h_lv(dest=f.Rd, src1=f.Rn)
            elif f.size.value == 0b10:
                abs_s_lv(dest=f.Rd, src1=f.Rn)
            elif f.size.value == 0b11:
                abs_d_lv(dest=f.Rd, src1=f.Rn)



            if   f.size.value == 0b10:
                uaddlp_s_lv(dest=T0, src1=f.Rn, src2=f.Rn, idx=Signal('000010'))
                uadd1p_d_lv(dest=f.Rd, src1=T0, src2=T0, idx=Signal('000011'))
            elif f.size.value == 0b01:
                uaddlp_h_lv(dest=T0, src1=f.Rn, src2=f.Rn)
                uadd2p_s_lv(dest=T0, src1=T0, src2=T0, idx=Signal('000001'))
                uadd1p_s_sv(dest=f.Rd, src1=T0, src2=T0, idx=Signal('000001'))

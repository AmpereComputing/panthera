        elif f.Q.value == 0b0:
            if   f.size.value == 0b01:
                saddlp_h_sv(dest=T0, src1=f.Rn, src2=f.Rn)
                sadd1p_s_sv(dest=f.Rd, src1=T0, src2=T0, idx=Signal('000001'))

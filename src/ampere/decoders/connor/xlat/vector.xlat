                elif (f.imm4.value & 0b0011 ) ==  0b0001:
                    ins_idx1_b_lv(dest=f.Rd, src1=f.Rd, src2=f.Rn, idx=(Signal('0010'),f.opcBit14,f.opcBit13))
                elif (f.imm4.value & 0b0011 ) ==  0b0010:
                    ins_idx2_b_lv(dest=f.Rd, src1=f.Rd, src2=f.Rn, idx=(Signal('0010'),f.opcBit14,f.opcBit13))
                elif (f.imm4.value & 0b0011 ) ==  0b0011:
                    ins_idx3_b_lv(dest=f.Rd, src1=f.Rd, src2=f.Rn, idx=(Signal('0010'),f.opcBit14,f.opcBit13))
            elif (f.imm5.value & 0b00011 ) ==  0b00010:
                if (f.imm4.value & 0b0010 ) ==  0b0000:
                    ins_idx0_h_lv(dest=f.Rd, src1=f.Rd, src2=f.Rn, idx=(Signal('0010'),f.opcBit14,f.opcBit13))
                elif (f.imm4.value & 0b0010 ) ==  0b0010:
                    ins_idx1_h_lv(dest=f.Rd, src1=f.Rd, src2=f.Rn, idx=(Signal('0010'),f.opcBit14,f.opcBit13))
            elif (f.imm5.value & 0b00111 ) ==  0b00100:
                ins_idx0_s_lv(dest=f.Rd, src1=f.Rd, src2=f.Rn, idx=(Signal('0010'),f.opcBit14,f.opcBit13))
            elif (f.imm5.value & 0b01111 ) ==  0b01000:
                ins_idx0_d_lv(dest=f.Rd, src1=f.Rd, src2=f.Rn, idx=(Signal('0011'),f.opcBit14,Signal('0')))



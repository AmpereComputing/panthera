            add_d_nv(dest=f.Rd, src1=f.Rn, src2=f.Rm)


class ADD_asimdsame_only(_JSON_ADD_asimdsame_only):

    pmu_events = ['ASE_INST_SPEC', 'ASE_INT_SPEC', 'ASE_SPEC', 'ASE_UOP_SPEC', 'ASE_VECTOR_SPEC', 'INT_SPEC', 'SIMD_INST_SPEC']

    def decode(self, f):
        # Number of uops 7: add_b_lv, add_b_sv, add_d_lv, add_h_lv, add_h_sv, add_s_lv, add_s_sv
        if f.Q.value == 0b0:
            if f.size.value == 0b00:
                add_b_sv(dest=f.Rd, src1=f.Rn, src2=f.Rm)
            elif f.size.value == 0b01:
                add_h_sv(dest=f.Rd, src1=f.Rn, src2=f.Rm)
            elif f.size.value == 0b10:
                add_s_sv(dest=f.Rd, src1=f.Rn, src2=f.Rm)
        elif f.Q.value == 0b1:
            if f.size.value == 0b00:
                add_b_lv(dest=f.Rd, src1=f.Rn, src2=f.Rm)
            elif f.size.value == 0b01:
                add_h_lv(dest=f.Rd, src1=f.Rn, src2=f.Rm)
            elif f.size.value == 0b10:
                add_s_lv(dest=f.Rd, src1=f.Rn, src2=f.Rm)
            elif f.size.value == 0b11:
                add_d_lv(dest=f.Rd, src1=f.Rn, src2=f.Rm)


class ADDHN_asimddiff_N(_JSON_ADDHN_asimddiff_N):

    pmu_events = ['ASE_INST_SPEC', 'ASE_INT_SPEC', 'ASE_SPEC', 'ASE_UOP_SPEC', 'ASE_VECTOR_SPEC', 'INT_SPEC', 'SIMD_INST_SPEC']

    def decode(self, f):
        #Dont_touch_multiuop
        if   f.Q.value == 0b1:
            if   f.size.value == 0b10:
                addhn_d_lv(dest=T0, src1=f.Rn, src2=f.Rm)
                movhn2_s_lv(dest=f.Rd, src2=T0, src3=f.Rd)
            elif f.size.value == 0b01:
                addhn_s_lv(dest=T0, src1=f.Rn, src2=f.Rm)
                movhn2_h_lv(dest=f.Rd, src2=T0, src3=f.Rd)
            elif f.size.value == 0b00:
                addhn_h_lv(dest=T0, src1=f.Rn, src2=f.Rm)
                movhn2_b_lv(dest=f.Rd, src2=T0, src3=f.Rd)
        elif f.Q.value == 0b0:
            if   f.size.value == 0b10:
                addhn_d_lv(dest=T0, src1=f.Rn, src2=f.Rm)
                movhn_s_lv(dest=f.Rd, src2=T0)
            elif f.size.value == 0b01:
                addhn_s_lv(dest=T0, src1=f.Rn, src2=f.Rm)
                movhn_h_lv(dest=f.Rd, src2=T0)
            elif f.size.value == 0b00:
                addhn_h_lv(dest=T0, src1=f.Rn, src2=f.Rm)
                movhn_b_lv(dest=f.Rd, src2=T0)


class ADDP_asisdpair_only(_JSON_ADDP_asisdpair_only):

    pmu_events = ['ASE_INT_SPEC', 'ASE_SCALAR_SPEC', 'ASE_SPEC', 'INT_SPEC']

    def decode(self, f):
        # Number of uops 1: add1p_d_lv
        if f.size.value == 0b11:
            add1p_d_lv(dest=f.Rd, src1=f.Rn, src2=f.Rn, idx=(Signal('000011')))


class ADDP_asimdsame_only(_JSON_ADDP_asimdsame_only):

    pmu_events = ['ASE_INST_SPEC', 'ASE_INT_SPEC', 'ASE_SPEC', 'ASE_UOP_SPEC', 'ASE_VECTOR_SPEC', 'INT_SPEC', 'SIMD_INST_SPEC']

    def decode(self, f):
        # Number of uops 7: addp2r_b_lv, addp2r_b_sv, addp2r_d_lv, addp2r_h_lv, addp2r_h_sv, addp2r_s_lv, addp2r_s_sv
        if f.Q.value == 0b0:
            if f.size.value == 0b00:
                addp2r_b_sv(dest=f.Rd, src1=f.Rn, src2=f.Rm, idx=(Signal('000001')))
            elif f.size.value == 0b01:
                addp2r_h_sv(dest=f.Rd, src1=f.Rn, src2=f.Rm, idx=(Signal('000001')))
            elif f.size.value == 0b10:
                addp2r_s_sv(dest=f.Rd, src1=f.Rn, src2=f.Rm, idx=(Signal('000001')))
        elif f.Q.value == 0b1:
            if f.size.value == 0b00:
                addp2r_b_lv(dest=f.Rd, src1=f.Rn, src2=f.Rm, idx=(Signal('000001')))
            elif f.size.value == 0b01:
                addp2r_h_lv(dest=f.Rd, src1=f.Rn, src2=f.Rm, idx=(Signal('000001')))
            elif f.size.value == 0b10:
                addp2r_s_lv(dest=f.Rd, src1=f.Rn, src2=f.Rm, idx=(Signal('000001')))
            elif f.size.value == 0b11:
                addp2r_d_lv(dest=f.Rd, src1=f.Rn, src2=f.Rm, idx=(Signal('000011')))


class ADDV_asimdall_only(_JSON_ADDV_asimdall_only):

    pmu_events = ['ASE_INST_SPEC', 'ASE_INT_SPEC', 'ASE_SPEC', 'ASE_UOP_SPEC', 'ASE_VECTOR_SPEC', 'INT_SPEC', 'SIMD_INST_SPEC']

    def decode(self, f):
        #Dont_touch_multiuop
        if   f.Q.value == 0b1:
            if   f.size.value == 0b10:
                add2p_s_lv(dest=T0, src1=f.Rn, src2=f.Rn, idx=Signal('000001'))
                add1p_s_sv(dest=f.Rd, src1=T0, src2=T0, idx=Signal('000001'))
            elif f.size.value == 0b01:
                add4p_h_lv(dest=T0, src1=f.Rn, src2=f.Rn, idx=Signal('000001'))
                add2p_h_sv(dest=T0, src1=T0, src2=T0, idx=Signal('000001'))
                add1p_h_sv(dest=f.Rd, src1=T0, src2=T0, idx=Signal('000001'))
            elif f.size.value == 0b00:
                add8p_b_lv(dest=T0, src1=f.Rn, src2=f.Rn, idx=Signal('000001'))
                add4p_b_sv(dest=T0, src1=T0, src2=T0, idx=Signal('000001'))
                add2p_b_sv(dest=T0, src1=T0, src2=T0, idx=Signal('000001'))
                add1p_b_sv(dest=f.Rd, src1=T0, src2=T0, idx=Signal('000001'))
        elif f.Q.value == 0b0:
            if   f.size.value == 0b01:
                add2p_h_sv(dest=T0, src1=f.Rn, src2=f.Rn, idx=Signal('000001'))
                add1p_h_sv(dest=f.Rd, src1=T0, src2=T0, idx=Signal('000001'))
            elif f.size.value == 0b00:
                add4p_b_sv(dest=T0, src1=f.Rn, src2=f.Rn, idx=Signal('000001'))
                add2p_b_sv(dest=T0, src1=T0, src2=T0, idx=Signal('000001'))
                add1p_b_sv(dest=f.Rd, src1=T0, src2=T0, idx=Signal('000001'))



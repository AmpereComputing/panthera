class ADDG_64_addsub_immtags(_JSON_ADDG_64_addsub_immtags):
    fields = {**_JSON_ADDG_64_addsub_immtags.fields, 'Xd': (4, 0), 'Xn': (9, 5), 'uimm4': (13, 10), 'uimm6': (21, 16)}


    def decode(self, f):
        addg(dest=f.Xd, src2=f.Xn, imm=(f.uimm6,f.uimm4), src2_is_stack_pointer=True, dest_is_stack_pointer=True)


class ADDS_32S_addsub_ext(_JSON_ADDS_32S_addsub_ext):

    flag_fuse_to_Bcond = True

    pmu_events = ['A64SCALAR_SPEC', 'DP_SPEC', 'INT_SPEC']

    def decode(self, f):
        if f.option.value == 0b000:
            adds32(dest=f.Rd, flagdest=f0, src1=f.Rn, src2=f.Rm, imm=(f.option,f.imm3), src1_is_stack_pointer=True)
        elif f.option.value == 0b001:
            adds32(dest=f.Rd, flagdest=f0, src1=f.Rn, src2=f.Rm, imm=(f.option,f.imm3), src1_is_stack_pointer=True)
        elif f.option.value == 0b010:
            adds32(dest=f.Rd, flagdest=f0, src1=f.Rn, src2=f.Rm, imm=(f.option,f.imm3), src1_is_stack_pointer=True)
        elif f.option.value == 0b011:
            adds32(dest=f.Rd, flagdest=f0, src1=f.Rn, src2=f.Rm, imm=(f.option,f.imm3), src1_is_stack_pointer=True)
        elif f.option.value == 0b100:
            sxt32(dest=s0, src1=f.Rm, imm=(f.imm3,f.option), cleavlet0=True)
            adds32(dest=f.Rd, flagdest=f0, src1=f.Rn, src2=s0, imm=Signal("011000"), src1_is_stack_pointer=True, cleavlet1=True)
        elif f.option.value == 0b101:
            sxt32(dest=s0, src1=f.Rm, imm=(f.imm3,f.option), cleavlet0=True)
            adds32(dest=f.Rd, flagdest=f0, src1=f.Rn, src2=s0, imm=Signal("011000"), src1_is_stack_pointer=True, cleavlet1=True)
        elif f.option.value == 0b110:
            adds32(dest=f.Rd, flagdest=f0, src1=f.Rn, src2=f.Rm, imm=(f.option,f.imm3), src1_is_stack_pointer=True)
        elif f.option.value == 0b111:
            adds32(dest=f.Rd, flagdest=f0, src1=f.Rn, src2=f.Rm, imm=(f.option,f.imm3), src1_is_stack_pointer=True)



class ADR_only_pcreladdr(_JSON_ADR_only_pcreladdr):

    pmu_events = ['A64SCALAR_SPEC', 'DP_SPEC', 'INT_SPEC']

    def decode(self, f):
        adr(dest=f.Rd, imm=(f.immhi,f.immlo), use_pc=True, imm_signext=True)


class ADRP_only_pcreladdr(_JSON_ADRP_only_pcreladdr):

    pmu_events = ['A64SCALAR_SPEC', 'DP_SPEC', 'INT_SPEC']

    def decode(self, f):
        # To match with what we want to do for adrp+add(immediate) fusion, instead of
        # shifting the immediate by 12 with imm_shift, we will do that here in decode, this
        # simplifies hardward in IdrImm and makes the decode mux for extracted_immediate match
        # for adrp and adrp+addimm
        adr(dest=f.Rd, imm=(f.immhi,f.immlo, Signal('000000000000')), use_pc=True, imm_signext=True, is_adrp=True)



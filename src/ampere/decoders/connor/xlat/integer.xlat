class ADD_32_addsub_ext(_JSON_ADD_32_addsub_ext):

    pmu_events = ['A64SCALAR_SPEC', 'DP_SPEC', 'INT_SPEC']

    def decode(self, f):
        if f.option.value == 0b000:
            add32(dest=f.Rd, src1=f.Rn, src2=f.Rm, imm=(f.option,f.imm3), dest_is_stack_pointer=True, src1_is_stack_pointer=True)
        elif f.option.value == 0b001:
            add32(dest=f.Rd, src1=f.Rn, src2=f.Rm, imm=(f.option,f.imm3), dest_is_stack_pointer=True, src1_is_stack_pointer=True)
        elif f.option.value == 0b010:
            add32(dest=f.Rd, src1=f.Rn, src2=f.Rm, imm=(f.option,f.imm3), dest_is_stack_pointer=True, src1_is_stack_pointer=True)
        elif f.option.value == 0b011:
            add32(dest=f.Rd, src1=f.Rn, src2=f.Rm, imm=(f.option,f.imm3), dest_is_stack_pointer=True, src1_is_stack_pointer=True)
        elif f.option.value == 0b100:
            sxt32(dest=s0, src1=f.Rm, imm=(f.imm3,f.option), cleavlet0=True)
            add32(dest=f.Rd, src1=f.Rn, src2=s0, imm=Signal("011000"), dest_is_stack_pointer=True, src1_is_stack_pointer=True, cleavlet1=True)
        elif f.option.value == 0b101:
            sxt32(dest=s0, src1=f.Rm, imm=(f.imm3,f.option), cleavlet0=True)
            add32(dest=f.Rd, src1=f.Rn, src2=s0, imm=Signal("011000"), dest_is_stack_pointer=True, src1_is_stack_pointer=True, cleavlet1=True)
        elif f.option.value == 0b110:
            add32(dest=f.Rd, src1=f.Rn, src2=f.Rm, imm=(f.option,f.imm3), dest_is_stack_pointer=True, src1_is_stack_pointer=True)
        elif f.option.value == 0b111:
            add32(dest=f.Rd, src1=f.Rn, src2=f.Rm, imm=(f.option,f.imm3), dest_is_stack_pointer=True, src1_is_stack_pointer=True)



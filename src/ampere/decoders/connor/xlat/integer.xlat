class SUB_32_addsub_ext(_JSON_SUB_32_addsub_ext):

    pmu_events = ['A64SCALAR_SPEC', 'DP_SPEC', 'INT_SPEC']

    def decode(self, f):
      #shift of value of zero means we might just be a single uop flow
      if f.imm3.value == 0b000:
        #sign extend single/double word doesn't do anything so just a single uop flow
        if f.option.value >= 0b110:
          sub32(dest=f.Rd, src1=f.Rn, src2=f.Rm, imm=(f.option,f.imm3), dest_is_stack_pointer=True, src1_is_stack_pointer=True)
        elif f.option.value >= 0b100:
          sxt32(dest=s0, src1=f.Rm, imm=(f.imm3,f.option), cleavlet0=True)
          sub32(dest=f.Rd, src1=f.Rn, src2=s0, imm=(Signal("011"),f.imm3), dest_is_stack_pointer=True, src1_is_stack_pointer=True, cleavlet1=True)
        #zero extend can be done at the bypass mux, so just a single uop flow
        else:
          sub32(dest=f.Rd, src1=f.Rn, src2=f.Rm, imm=(f.option,f.imm3), dest_is_stack_pointer=True, src1_is_stack_pointer=True)
      #non zero shift means it's always a 2 uop flow
      else:
        if f.option.value >= 0b100:
          sxt32(dest=s0, src1=f.Rm, imm=(f.imm3,f.option), cleavlet0=True)
          sub32(dest=f.Rd, src1=f.Rn, src2=s0, imm=Signal("011000"), dest_is_stack_pointer=True, src1_is_stack_pointer=True, cleavlet1=True)
        else:
          uxt32(dest=s0, src1=f.Rm, imm=(f.imm3,f.option), cleavlet0=True)
          sub32(dest=f.Rd, src1=f.Rn, src2=s0, imm=Signal("011000"), dest_is_stack_pointer=True, src1_is_stack_pointer=True, cleavlet1=True)


class SUB_64_addsub_ext(_JSON_SUB_64_addsub_ext):

    pmu_events = ['A64SCALAR_SPEC', 'DP_SPEC', 'INT_SPEC']

    def decode(self, f):
      #shift of value of zero means we might just be a single uop flow
      if f.imm3.value == 0b000:
        #sign extend double word doesn't do anything so just a single uop flow
        if f.option.value == 0b111:
            sub64(dest=f.Rd, src1=f.Rn, src2=f.Rm, imm=(f.option, f.imm3), dest_is_stack_pointer=True, src1_is_stack_pointer=True)
        elif f.option.value == 0b110:
            sub64(dest=f.Rd, src1=f.Rn, src2=f.Rm, imm=(f.option, f.imm3), dest_is_stack_pointer=True, src1_is_stack_pointer=True)
        elif f.option.value >= 0b100:
            sxt64(dest=s0, src1=f.Rm, imm=(f.imm3,f.option), cleavlet0=True)
            sub64(dest=f.Rd, src1=f.Rn, src2=s0, imm=(Signal("011"),f.imm3), dest_is_stack_pointer=True, src1_is_stack_pointer=True, cleavlet1=True)
        #zero extend can be done at the bypass mux, so just a single uop flow
        else:
            sub64(dest=f.Rd, src1=f.Rn, src2=f.Rm, imm=(f.option,f.imm3), dest_is_stack_pointer=True, src1_is_stack_pointer=True)
      #non zero shift means it's always a 2 uop flow
      else:
        if f.option.value >= 0b100:
            sxt64(dest=s0, src1=f.Rm, imm=(f.imm3,f.option), cleavlet0=True)
            sub64(dest=f.Rd, src1=f.Rn, src2=s0, imm=Signal("011000"), dest_is_stack_pointer=True, src1_is_stack_pointer=True, cleavlet1=True)
        else:
            uxt64(dest=s0, src1=f.Rm, imm=(f.imm3,f.option), cleavlet0=True)
            sub64(dest=f.Rd, src1=f.Rn, src2=s0, imm=Signal("011000"), dest_is_stack_pointer=True, src1_is_stack_pointer=True, cleavlet1=True)



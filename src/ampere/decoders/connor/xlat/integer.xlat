        smull32(dest=f.Rd, src1=f.Rn, src2=f.Rm)
      else:
        smull32(dest=s0, src1=f.Rn, src2=f.Rm)
        add64(dest=f.Rd, src1=f.Ra, src2=s0, imm=Signal("011000"))


class SMAX_32_minmax_imm(_JSON_SMAX_32_minmax_imm):

    def decode(self, f):
        #smax32(dest=f.Rd, src2=f.Rn, imm=f.imm8)
        #Required a special subtract which handled a signed immediate
        #The immediate variants of csel need to use a signed or unsigned imm8 based on if it's
        #U/S MAX/MIN.  Instead of creating sign and unsigned version of csel, we use bit8 to specify
        #if we should sign or zero extend in ImmDec.
        subs32_simm_nodest(src2=f.Rn, imm=(Signal("00001"),f.imm8), flagdest=f1)
        csel32_le(dest=f.Rd, src2=f.Rn, imm=(Signal("1"),f.imm8), src3=f1)



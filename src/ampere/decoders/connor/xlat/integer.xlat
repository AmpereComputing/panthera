class SUBS_32S_addsub_ext(_JSON_SUBS_32S_addsub_ext):

    flag_fuse_to_Bcond = True
    fusion_delay_hint = True

    pmu_events = ['A64SCALAR_SPEC', 'DP_SPEC', 'INT_SPEC']

    def decode(self, f):
      #shift of value of zero means we might just be a single uop flow
      if f.imm3.value == 0b000:
        #sign extend single/double word doesn't do anything so just a single uop flow
        if f.option.value >= 0b110:
          subs32(dest=f.Rd, src1=f.Rn, src2=f.Rm, imm=(f.option,f.imm3), src1_is_stack_pointer=True, flagdest=f0)
        elif f.option.value >= 0b100:
          sxt32(dest=s0, src1=f.Rm, imm=(f.imm3,f.option), cleavlet0=True)
          subs32(dest=f.Rd, src1=f.Rn, src2=s0, imm=(Signal("011"),f.imm3), src1_is_stack_pointer=True, flagdest=f0, cleavlet1=True)
        #zero extend can be done at the bypass mux, so just a single uop flow
        else:
          subs32(dest=f.Rd, src1=f.Rn, src2=f.Rm, imm=(f.option,f.imm3), src1_is_stack_pointer=True, flagdest=f0)
      #non zero shift means it's always a 2 uop flow
      else:
        if f.option.value >= 0b100:
          sxt32(dest=s0, src1=f.Rm, imm=(f.imm3,f.option), cleavlet0=True)
          subs32(dest=f.Rd, src1=f.Rn, src2=s0, imm=Signal("011000"), src1_is_stack_pointer=True, flagdest=f0, cleavlet1=True)
        else:
          uxt32(dest=s0, src1=f.Rm, imm=(f.imm3,f.option), cleavlet0=True)
          subs32(dest=f.Rd, src1=f.Rn, src2=s0, imm=Signal("011000"), src1_is_stack_pointer=True, flagdest=f0, cleavlet1=True)



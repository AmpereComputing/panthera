            subs64(dest=f.Rd, src1=f.Rn, src2=s0, imm=(Signal("011"),f.imm3), src1_is_stack_pointer=True, flagdest=f0, cleavlet1=True)
        #zero extend can be done at the bypass mux, so just a single uop flow
        else:
            subs64(dest=f.Rd, src1=f.Rn, src2=f.Rm, imm=(f.option,f.imm3), src1_is_stack_pointer=True, flagdest=f0)
      #non zero shift means it's always a 2 uop flow
      else:
        if f.option.value >= 0b100:
            sxt64(dest=s0, src1=f.Rm, imm=(f.imm3,f.option), cleavlet0=True)
            subs64(dest=f.Rd, src1=f.Rn, src2=s0, imm=(Signal("011"),Signal("000")), src1_is_stack_pointer=True, flagdest=f0, cleavlet1=True)
        else:
            uxt64(dest=s0, src1=f.Rm, imm=(f.imm3,f.option), cleavlet0=True)
            subs64(dest=f.Rd, src1=f.Rn, src2=s0, imm=(Signal("011"),Signal("000")), src1_is_stack_pointer=True, flagdest=f0, cleavlet1=True)



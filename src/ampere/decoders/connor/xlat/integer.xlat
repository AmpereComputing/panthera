class ADD_32_addsub_shift(_JSON_ADD_32_addsub_shift):
    fields  = {'opcBit12':[12,12],'opcBit11':[11,11],'opcBit10':[10,10]}


    pmu_events = ['A64SCALAR_SPEC', 'DP_SPEC', 'INT_SPEC']

    def decode(self, f):
        if f.shift.value == 0b00 and f.imm6.value <= 0b000100:
            add32(dest=f.Rd, src1=f.Rn, src2=f.Rm, imm=(Signal("011"),f.opcBit12,f.opcBit11,f.opcBit10))
        elif f.shift.value == 0b00 and f.imm6.value > 0b000100:
            lsl32_imm(dest=s0, src1=f.Rm, imm=f.imm6, cleavlet0=True)
            add32(dest=f.Rd, src1=f.Rn, src2=s0, imm=Signal("011000"), cleavlet1=True)
        elif f.shift.value == 0b01:
            lsr32(dest=s0, src1=f.Rm, imm=f.imm6, cleavlet0=True)
            add32(dest=f.Rd, src1=f.Rn, src2=s0, imm=Signal("011000"), cleavlet1=True)
        elif f.shift.value == 0b10:
            asr32(dest=s0, src1=f.Rm, imm=f.imm6, cleavlet0=True)
            add32(dest=f.Rd, src1=f.Rn, src2=s0, imm=Signal("011000"), cleavlet1=True)
        elif f.shift.value == 0b11:
            # This is an illegal/unused encoding
            pass


class ADD_64_addsub_shift(_JSON_ADD_64_addsub_shift):
    fields  = {'opcBit12':[12,12],'opcBit11':[11,11],'opcBit10':[10,10]}



class CSEL_32_condsel(_JSON_CSEL_32_condsel):

    pmu_events = ['DP_SPEC']

    def decode(self, f):
        if f.cond.value == 0b0000:
            csel32_eq(dest=f.Rd, src1=f.Rn, src2=f.Rm, src3=f0)
        elif f.cond.value == 0b0010:
            csel32_cs(dest=f.Rd, src1=f.Rn, src2=f.Rm, src3=f0)
        elif f.cond.value == 0b0100:
            csel32_mi(dest=f.Rd, src1=f.Rn, src2=f.Rm, src3=f0)
        elif f.cond.value == 0b0110:
            csel32_vs(dest=f.Rd, src1=f.Rn, src2=f.Rm, src3=f0)
        elif f.cond.value == 0b1000:
            csel32_hi(dest=f.Rd, src1=f.Rn, src2=f.Rm, src3=f0)
        elif f.cond.value == 0b1010:
            csel32_ge(dest=f.Rd, src1=f.Rn, src2=f.Rm, src3=f0)
        elif f.cond.value == 0b1100:
            csel32_gt(dest=f.Rd, src1=f.Rn, src2=f.Rm, src3=f0)
        elif f.cond.value >= 0b1110:
            csel32_al(dest=f.Rd, src1=f.Rn, src2=f.Rm, src3=f0)
        elif f.cond.value == 0b0001:
            csel32_ne(dest=f.Rd, src1=f.Rn, src2=f.Rm, src3=f0)
        elif f.cond.value == 0b0011:
            csel32_cc(dest=f.Rd, src1=f.Rn, src2=f.Rm, src3=f0)
        elif f.cond.value == 0b0101:
            csel32_pl(dest=f.Rd, src1=f.Rn, src2=f.Rm, src3=f0)
        elif f.cond.value == 0b0111:
            csel32_vc(dest=f.Rd, src1=f.Rn, src2=f.Rm, src3=f0)
        elif f.cond.value == 0b1001:
            csel32_ls(dest=f.Rd, src1=f.Rn, src2=f.Rm, src3=f0)
        elif f.cond.value == 0b1011:
            csel32_lt(dest=f.Rd, src1=f.Rn, src2=f.Rm, src3=f0)
        elif f.cond.value == 0b1101:
            csel32_le(dest=f.Rd, src1=f.Rn, src2=f.Rm, src3=f0)



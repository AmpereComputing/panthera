class abs_z_p_z_(_JSON_abs_z_p_z_m):

    movprfx_fusion = "predicated"
    pmu_events = ['INT_SPEC', 'SVE_INT_SPEC', 'SIMD_INST_SPEC', 'SVE_UOP_SPEC', 'SVE_INST_SPEC']

    def decode(self, f):
        # Number of uops 4: abs_b_pv, abs_d_pv, abs_h_pv, abs_s_pv
        if f.size.value == 0b00:
            abs_b_pv(dest=f.Zd, pred=f.Pg, src1=f.Zn, src3=f.Zd)
        elif f.size.value == 0b01:
            abs_h_pv(dest=f.Zd, pred=f.Pg, src1=f.Zn, src3=f.Zd)
        elif f.size.value == 0b10:
            abs_s_pv(dest=f.Zd, pred=f.Pg, src1=f.Zn, src3=f.Zd)
        elif f.size.value == 0b11:
            abs_d_pv(dest=f.Zd, pred=f.Pg, src1=f.Zn, src3=f.Zd)



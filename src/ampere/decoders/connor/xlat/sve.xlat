class and_z_zi_(_JSON_and_z_zi_):
    fields = {**_JSON_and_z_zi_.fields, 'imm13_N': (17, 17), 'imm13_s': (10, 5)}


    movprfx_fusion = "unpredicated"
    pmu_events = ['INT_SPEC', 'SVE_INT_SPEC', 'SIMD_INST_SPEC', 'SVE_UOP_SPEC', 'SVE_INST_SPEC']

    def decode(self, f):
        #Dont_touch - custom_pfields
        # For logical immediates an all-ones value of s is reserved
        # since it would generate a useless all-ones result
        if   (f.imm13_N.value) == 0b1:
            if   (f.imm13_s.value & 0b111111) !=  0b111111:
                and_imm_d_uv(dest=f.Zdn, src1=f.Zdn)
        elif (f.imm13_N.value) == 0b0:
            if   (f.imm13_s.value & 0b100000) ==  0b000000:
                if   (f.imm13_s.value & 0b011111) !=  0b011111:
                    and_imm_s_uv(dest=f.Zdn, src1=f.Zdn)
            elif (f.imm13_s.value & 0b110000) ==  0b100000:
                if   (f.imm13_s.value & 0b001111) !=  0b001111:
                    and_imm_h_uv(dest=f.Zdn, src1=f.Zdn)
            elif (f.imm13_s.value & 0b110000) ==  0b110000:
                if   (f.imm13_s.value & 0b001110) !=  0b001110:
                    if   (f.imm13_s.value & 0b001000) ==  0b000000:
                        if   (f.imm13_s.value & 0b000111) !=  0b000111:
                            and_imm_b_uv(dest=f.Zdn, src1=f.Zdn)
                    elif (f.imm13_s.value & 0b001100) ==  0b001000:
                        if   (f.imm13_s.value & 0b000011) !=  0b000011:
                            and_imm_b_uv(dest=f.Zdn, src1=f.Zdn)
                    elif (f.imm13_s.value & 0b001110) ==  0b001100:
                        if   (f.imm13_s.value & 0b000001) !=  0b000001:
                            and_imm_b_uv(dest=f.Zdn, src1=f.Zdn)



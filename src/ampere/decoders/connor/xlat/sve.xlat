class adr_z_az_sd_same_scaled(_JSON_adr_z_az_sd_same_scaled):

    pmu_events = ['INT_SPEC', 'SVE_INT_SPEC', 'SIMD_INST_SPEC', 'SVE_UOP_SPEC', 'SVE_INST_SPEC']

    def decode(self, f):
        # Number of uops 8: adr0_d_uv, adr0_s_uv, adr1_d_uv, adr1_s_uv, adr2_d_uv, adr2_s_uv, adr3_d_uv, adr3_s_uv
        if f.sz.value == 0b0:
            if f.msz.value == 0b00:
                adr0_s_uv(dest=f.Zd, src1=f.Zm, src3=f.Zn)
            elif f.msz.value == 0b01:
                adr1_s_uv(dest=f.Zd, src1=f.Zm, src3=f.Zn)
            elif f.msz.value == 0b10:
                adr2_s_uv(dest=f.Zd, src1=f.Zm, src3=f.Zn)
            elif f.msz.value == 0b11:
                adr3_s_uv(dest=f.Zd, src1=f.Zm, src3=f.Zn)
        elif f.sz.value == 0b1:
            if f.msz.value == 0b00:
                adr0_d_uv(dest=f.Zd, src1=f.Zm, src3=f.Zn)
            elif f.msz.value == 0b01:
                adr1_d_uv(dest=f.Zd, src1=f.Zm, src3=f.Zn)
            elif f.msz.value == 0b10:
                adr2_d_uv(dest=f.Zd, src1=f.Zm, src3=f.Zn)
            elif f.msz.value == 0b11:
                adr3_d_uv(dest=f.Zd, src1=f.Zm, src3=f.Zn)



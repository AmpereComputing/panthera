from uop import *
from ampere.xlat import Signal, Translation


class ADD_32_addsub_imm(Translation):
    """Add (immediate)"""
    pattern = '0  0  0 10001 --    ------------ ----- -----'
    pfields = 'sf op S       shift    imm12      Rn    Rd  '

    asmtemplate = 'ADD  <Wd|WSP>, <Wn|WSP>, #<imm>{, <shift>}'

    def decode(self, f):
        add32(f.Rd, f.Rn, imm=f.imm12, shift=f.shift)


class ADD_64_addsub_imm(Translation):
    """Add (immediate)"""
    pattern = '1  0  0 10001 --    ------------ ----- -----'
    pfields = 'sf op S       shift    imm12      Rn    Rd  '

    asmtemplate = 'ADD  <Xd|SP>, <Xn|SP>, #<imm>{, <shift>}'

    def decode(self, f):
        add64(f.Rd, f.Rn, imm=f.imm12, shift=f.shift)


class ADDS_32S_addsub_imm(Translation):
    """Add (immediate), setting flags"""
    pattern = '0  0  1 10001 --    ------------ ----- -----'
    pfields = 'sf op S       shift    imm12      Rn    Rd  '

    asmtemplate = 'ADDS  <Wd>, <Wn|WSP>, #<imm>{, <shift>}'

    def decode(self, f):
        add32(f.Rd, f.Rn, imm=f.imm12, shift=f.shift, set_flags=True)



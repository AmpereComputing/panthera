class LDP_64_ldstpair_post(Translation):
    """Load Pair of Registers"""
    pattern = '1-  101 0 001 1 ------- ----- ----- -----'
    pfields = 'opc     V     L  imm7    Rt2   Rn    Rt  '

    asmtemplate = 'LDP  <Xt1>, <Xt2>, [<Xn|SP>], #<imm>'

    def decode(self, f):
        ## FIXME: not real
        ldrb(f.Rt, f.Rn, f.Rt2)



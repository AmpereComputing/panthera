    pfields = 'opc     V     L  imm7    Rt2   Rn    Rt  '

    asmtemplate = 'LDP  <Xt1>, <Xt2>, [<Xn|SP>{, #<imm>}]'

    def decode(self, f):
        return NotImplemented


class LDR_32_ldst_pos(Translation):
    """Load Register (immediate)"""
    pattern = '10   111 0 01 01  ------------ ----- -----'
    pfields = 'size     V    opc    imm12      Rn    Rt  '

    asmtemplate = 'LDR  <Wt>, [<Xn|SP>{, #<pimm>}]'

    def decode(self, f):
        ldrw(f.Rt, f.Rn, imm=(f.imm12, Signal('00')))



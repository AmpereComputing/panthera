class ADRP_only_pcreladdr(Translation):
    """Form PC-relative address to 4KB page"""
    pattern = '1  --    10000 ------------------- -----'
    pfields = 'op immlo              immhi         Rd  '

    asmtemplate = 'ADRP  <Xd>, <label>'

    def decode(self, f):
        adrp(imm_signext=(f.immhi, f.immlo), imm_use_pc=True)


class B_only_condbranch(Translation):
    """Branch conditionally"""
    pattern = '0101010 0  ------------------- 0  ----'
    pfields = '        o1        imm19        o0 cond'

    asmtemplate = 'B.<cond>  <label>'

    def decode(self, f):
        b_op = {
            0b0000: bc_eq, 0b0001: bc_ne,
            0b0010: bc_cs, 0b0011: bc_cc,
            0b0100: bc_mi, 0b0101: bc_pl,
            0b0110: bc_vs, 0b0111: bc_vc,
            0b1000: bc_hi, 0b1001: bc_ls,
            0b1010: bc_ge, 0b1011: bc_lt,
            0b1100: bc_gt, 0b1101: bc_le,
            0b1111: bc_al
        }
        if f.cond.value in b_op:
            b_op[f.cond.value](imm=f.imm19)


class B_only_branch_imm(Translation):
    """Branch"""
    pattern = '0  00101 --------------------------'
    pfields = 'op                 imm26           '

    asmtemplate = 'B  <label>'

    def decode(self, f):
        b(imm=f.imm26, imm_use_pc=True)


class BL_only_branch_imm(Translation):
    """Branch with Link"""
    pattern = '1  00101 --------------------------'
    pfields = 'op                 imm26           '

    asmtemplate = 'BL  <label>'

    def decode(self, f):
        b(imm=f.imm26, imm_use_pc=True)  # FIXME: how to indicate branch with link?



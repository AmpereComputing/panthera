class ADD_32_addsub_shift(Translation):
    """Add (shifted register)"""
    pattern = '0  0  0 01011 --    0 ----- ------ ----- -----'
    pfields = 'sf op S       shift    Rm    imm6   Rn    Rd  '

    asmtemplate = 'ADD  <Wd>, <Wn>, <Wm>{, <shift> #<amount>}'

    def decode(self, f):
        add32(f.Rd, f.Rn, f.Rm, imm=f.imm6, shift=f.shift)


class ADD_64_addsub_shift(Translation):

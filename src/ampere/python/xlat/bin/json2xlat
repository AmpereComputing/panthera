#!/usr/bin/env python3
# Copyright (c) 2026 Ampere Computing. All rights reserved.
# SPDX-License-Identifier: BSD-3-Clause

"""Generate an XLAT input file from Arm's machine-readable AArch64 JSON.

This tool emits a single deterministic ``a64.xlat`` by default.  Each class
contains JSON-derived encoding metadata and an explicit ``NotImplemented``
decoder, making it safe to use as the base for model-specific overlays.
"""

import argparse
import json
import sys
import traceback
from pathlib import Path

SCRIPT_ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(SCRIPT_ROOT / "src"))

from ampere.xlat.json_encoding import load_a64_encodings, write_manifest

HEADER = """from ampere.xlat import Signal, Translation
from proj.uop import *
"""


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("path", metavar="PATH", help="Instructions.json or its containing directory")
    parser.add_argument("--output", "-o", metavar="DIR", default=".", help="Output directory (default: .)")
    parser.add_argument(
        "--category",
        default="a64",
        help="Output filename stem (default: a64)",
    )
    parser.add_argument(
        "--manifest",
        metavar="PATH",
        help="Write a stable JSON metadata manifest for differential testing",
    )
    parser.add_argument(
        "--class-prefix",
        default="",
        help="Prefix every generated class name (default: none)",
    )
    parser.add_argument(
        "--metadata-only",
        action="store_true",
        help="Emit non-registering metadata bases marked unimplemented",
    )
    parser.add_argument(
        "-f",
        "--feature",
        dest="features",
        action="append",
        help="Restrict output to encodings requiring one of these FEAT_* features, repeatable",
    )
    parser.add_argument("--debug", action="store_true", help="Enable debugging")
    return parser.parse_args()


def main() -> None:
    args = parse_args()
    source_path = Path(args.path)
    encodings = load_a64_encodings(source_path)
    if args.features:
        requested_features = set(args.features)
        encodings = [encoding for encoding in encodings if requested_features.intersection(encoding.features)]

    output_dir = Path(args.output)
    output_dir.mkdir(parents=True, exist_ok=True)
    output_path = output_dir / f"{args.category}.xlat"
    with output_path.open("w", encoding="utf-8") as output:
        rendered = _header(source_path) + "".join(
            encoding.render(args.class_prefix, args.metadata_only) for encoding in encodings
        )
        output.write(rendered.rstrip() + "\n")

    if args.manifest:
        write_manifest(Path(args.manifest), encodings)


def _header(path: Path) -> str:
    """Return the source notice required for generated Arm JSON collateral."""
    json_path = path / "Instructions.json" if path.is_dir() else path
    with json_path.open(encoding="utf-8") as source:
        metadata = json.load(source).get("_meta", {})
    license_info = metadata.get("license", {})
    version = metadata.get("version", {}).get("ref", "unknown release")
    copyright_notice = license_info.get("copyright", "Copyright Arm Limited")
    return (
        f"# {copyright_notice}\n"
        "# SPDX-License-Identifier: BSD-3-Clause\n"
        f"# Generated by json2xlat from Arm AARCHMRS {version} Instructions.json.\n"
        "# Do not edit: place model-specific logic in the decoder XLAT overlays.\n\n"
        f"{HEADER}"
    )


if __name__ == "__main__":
    try:
        main()
    except Exception as error:
        if "--debug" in sys.argv:
            traceback.print_exc()
        else:
            print(f"Error: {error}", file=sys.stderr)
        sys.exit(1)

for arg in "$@"
do
    if [ "$arg" == "--missing-option" ]; then
        echo "ERROR: no option --missing-option"
        exit 0
    fi
    if [[ "$arg" == *".csv" ]]; then
        echo "some_metric" > "$arg"
    fi
    if [[ "$arg" == *".json" ]]; then
        name="${arg/.json/}"
        if [[ "$(grep -c missing $arg)" -gt 0 ]]; then
            echo "ERROR: no option --missing-option" >> "$name.log"
            exit 0
        fi
        if [[ "$(grep -c '/bin/false' $arg)" -gt 0 ]]; then
            echo "ERROR: some error"
            exit 1
        fi
        echo "some_metric" > "$name.summary.csv"
        echo "Info: /ampere/panthera: End of elaboration. Starting simulation." >> "$name.log"
        echo "Info: /OSCI/SystemC: Simulation stopped by user." >> "$name.log"
        echo "All commands exited successfully." >> "$name.log"
    fi
done

echo "Info: End of elaboration. Starting simulation."
echo "$@"
echo "Info: Simulation stopped by user"